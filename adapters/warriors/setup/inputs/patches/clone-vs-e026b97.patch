@@ -0,0 +1,14 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2::netplay {
+
+// Byte-oriented LZ compression for the join snapshot (mostly zero runs and repeats; no external library).
+std::vector<std::uint8_t> compress(const std::uint8_t *data, std::size_t size);
+// False when the stream is corrupt or does not expand to exactly `expected` bytes.
+bool decompress(const std::uint8_t *packed, std::size_t packed_size, std::size_t expected, std::vector<std::uint8_t> &out);
+
+}
diff --git a/runtime/src/netplay/fingerprint.cpp b/runtime/src/netplay/fingerprint.cpp
new file mode 100644
index 0000000..8505dfa
--- /dev/null
+++ b/runtime/src/netplay/fingerprint.cpp
@@ -0,0 +1,41 @@
+#include "fingerprint.hpp"
+
+namespace ps2::netplay {
+
+namespace {
+
+constexpr std::uint64_t kFnvBasis = 0xCBF29CE484222325ull;
+constexpr std::uint64_t kFnvPrime = 0x100000001B3ull;
+
+std::uint64_t mix(std::uint64_t h, std::uint64_t value, int bytes) {
+    for (int i = 0; i < bytes; ++i) h = (h ^ ((value >> (8 * i)) & 0xFF)) * kFnvPrime;
+    return h;
+}
+
+}
+
+std::uint64_t hash_patches(const std::vector<Patch> &patches) {
+    std::uint64_t h = kFnvBasis;
+    for (const Patch &p : patches) {
+        h = mix(h, p.place, 1);
+        h = mix(h, p.bytes, 1);
+        h = mix(h, p.address, 4);
+        h = mix(h, p.value, 8);
+    }
+    return h;
+}
+
+std::string differing_parts(const Fingerprint &ours, const Fingerprint &theirs) {
+    std::string parts;
+    const auto add = [&parts](bool differs, const char *name) {
+        if (!differs) return;
+        if (!parts.empty()) parts += ", ";
+        parts += name;
+    };
+    add(ours.game != theirs.game, "the generated game code");
+    add(ours.runtime != theirs.runtime, "the runtime");
+    add(ours.patches != theirs.patches, "the memory patches");
+    return parts;
+}
+
+}
diff --git a/runtime/src/netplay/fingerprint.hpp b/runtime/src/netplay/fingerprint.hpp
new file mode 100644
index 0000000..7ea9d7e
--- /dev/null
+++ b/runtime/src/netplay/fingerprint.hpp
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "ps2/system.hpp"
+#include "wire.hpp"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace ps2::netplay {
+
+// What decides whether two machines compute the same game: the generated game code, the runtime sources and the memory patches in force.
+// Contents only (never a path, a file time or the compiler's output file), so the same export built in any directory on any machine agrees.
+struct Fingerprint {
+    std::uint64_t game = 0;      // hash of every generated source file, set at build time (cmake/fingerprint.cmake)
+    std::uint64_t runtime = 0;   // hash of the runtime sources, same way
+    std::uint64_t patches = 0;   // hash of the patch list this process runs with
+
+    bool operator==(const Fingerprint &o) const { return game == o.game && runtime == o.runtime && patches == o.patches; }
+    bool operator!=(const Fingerprint &o) const { return !(*this == o); }
+
+    void write(Writer &w) const { w.u64(game).u64(runtime).u64(patches); }
+    static Fingerprint read(Reader &r) {
+        Fingerprint f;
+        f.game = r.u64();
+        f.runtime = r.u64();
+        f.patches = r.u64();
+        return f;
+    }
+};
+
+// FNV-1a over the fields of every patch, in list order.
+std::uint64_t hash_patches(const std::vector<Patch> &patches);
+
+// The parts of `theirs` that differ from `ours`, for the message a refused player reads: "the generated game code, the memory patches".
+std::string differing_parts(const Fingerprint &ours, const Fingerprint &theirs);
+
+}
