+bool prepare(std::uint32_t width, std::uint32_t height) {
+    g_has_layer = false;
+    if (!g_pipeline || !ps2::overlay::active() || !width || !height) return false;
+    if (width != g_width || height != g_height || !g_texture) {
+        if (!make_texture(width, height)) return false;
+    }
+    if (g_painted_version != ps2::overlay::version()) {
+        const std::uint64_t version = ps2::overlay::version();
+        if (!ps2::overlay::render(g_pixels, width, height)) return false;
+        WGPUTexelCopyTextureInfo dst = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT;
+        dst.texture = g_texture;
+        WGPUTexelCopyBufferLayout layout = WGPU_TEXEL_COPY_BUFFER_LAYOUT_INIT;
+        layout.bytesPerRow = width * 4;
+        layout.rowsPerImage = height;
+        const WGPUExtent3D extent = {width, height, 1};
+        wgpuQueueWriteTexture(g_queue, &dst, g_pixels.data(), g_pixels.size() * 4, &layout, &extent);
+        g_painted_version = version;
+    }
+    g_has_layer = true;
+    return true;
+}
+
+void draw(WGPURenderPassEncoder pass) {
+    if (!g_has_layer) return;
+    wgpuRenderPassEncoderSetPipeline(pass, g_pipeline);
+    wgpuRenderPassEncoderSetBindGroup(pass, 0, g_group, 0, nullptr);
+    wgpuRenderPassEncoderDraw(pass, 3, 1, 0, 0);
+}
+
+}
