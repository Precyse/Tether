@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstdint>
+
+// Test aid, off unless PS2_VIRTUAL_PADS names a script file: attaches, drives and detaches SDL virtual game controllers, so the pad ports are exercised without hardware by the
+// same path real controllers take (SDL events, pads::attach, pads::read). One command per line, the frame being the emulator's frame count:
+//   <frame> attach <1-4> <xbox|ps5|switch>     a controller of that kind connects
+//   <frame> detach <1-4>                       it is unplugged
+//   <frame> set <1-4> <control> <value>        a button (a b x y back guide start ls rs lb rb up down left right: 0 or 1) or a stick or trigger axis (lx ly rx ry lt rt: raw
+//                                              -32768 to 32767, a trigger at rest is -32768)
+namespace host::pads {
+
+// Reads the script. False when PS2_VIRTUAL_PADS is not set or unreadable.
+bool load_virtual_pads();
+
+// A script was read: only the virtual controllers play, so the pads of the PC the test runs on cannot take a port.
+bool virtual_pads_active();
+
+// Runs every command due at `frame`.
+void drive_virtual_pads(std::uint64_t frame);
+
+}
