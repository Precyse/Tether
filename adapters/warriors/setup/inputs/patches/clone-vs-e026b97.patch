+
+    std::uint16_t buttons = 0;
+    std::array<std::uint8_t, kAxes> axes{0x80, 0x80, 0x80, 0x80};
+    std::array<std::uint8_t, kPressures> pressure{};
+
+    bool operator==(const PadSample &o) const { return buttons == o.buttons && axes == o.axes && pressure == o.pressure; }
+};
+
+// Writes the sample into the emulated controller on `pad`.
+void apply_pad_sample(int pad, const PadSample &sample);
