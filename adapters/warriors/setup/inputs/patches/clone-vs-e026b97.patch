diff --git a/host/pacing.cpp b/host/pacing.cpp
new file mode 100644
index 0000000..c231e4a
--- /dev/null
+++ b/host/pacing.cpp
@@ -0,0 +1,81 @@
+#include "pacing.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace host::pacing {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+constexpr int kMaxLateFrames = 2;
+constexpr unsigned kLogFlushFrames = 60;
+constexpr std::chrono::microseconds kSpinMargin{300};   // the last stretch is spun: a timer wakes up this much late at worst
+
+#ifdef _WIN32
+// A high resolution waitable timer wakes within about half a millisecond; without it the 15.6 ms scheduler tick would make a frame uneven.
+HANDLE high_resolution_timer() {
+    static HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    return timer;
+}
+#endif
+
+double milliseconds(Clock::duration d) { return std::chrono::duration<double, std::milli>(d).count(); }
+
+// PS2_FRAME_LOG=<file>: one line per frame, "frame work wait" in milliseconds (work = everything but the pacing wait: emulation and any stall on the other threads).
+void log_frame(Clock::duration work, Clock::duration wait) {
+    static std::FILE *file = [] {
+        const char *path = std::getenv("PS2_FRAME_LOG");
+        return path ? std::fopen(path, "w") : nullptr;
+    }();
+    static unsigned frames = 0;
+    if (!file) return;
+    std::fprintf(file, "%.3f %.3f %.3f\n", milliseconds(work + wait), milliseconds(work), milliseconds(wait));
+    if (++frames % kLogFlushFrames == 0) std::fflush(file);
+}
+
+void sleep_for(Clock::duration d) {
+#ifdef _WIN32
+    if (HANDLE timer = high_resolution_timer()) {
+        LARGE_INTEGER due;
+        due.QuadPart = -std::chrono::duration_cast<std::chrono::nanoseconds>(d).count() / 100;
+        if (SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) {
+            WaitForSingleObject(timer, INFINITE);
+            return;
+        }
+    }
+#endif
+    std::this_thread::sleep_for(d);
+}
+
+}
+
+void wait_for_next_frame(unsigned hz) {
+    static const char *const forced = std::getenv("PS2_PACE_HZ");   // test aid: a fixed frame rate, e.g. 40 to see how the sound behaves when the game runs slow
+    if (forced) hz = static_cast<unsigned>(std::atoi(forced));
+    static Clock::time_point due, previous_return;
+    static bool started = false;
+    const Clock::duration period = std::chrono::duration_cast<Clock::duration>(std::chrono::duration<double>(1.0 / hz));
+    const Clock::time_point now = Clock::now();
+    if (!started || now - due > period * kMaxLateFrames) {
+        started = true;
+        due = now - period;   // this frame's slot ends now: no wait
+        previous_return = now;
+    }
+    due += period;
+    const Clock::time_point wake = due - kSpinMargin;
+    if (Clock::now() < wake) sleep_for(wake - Clock::now());
+    while (Clock::now() < due) std::this_thread::yield();
+    const Clock::time_point done = Clock::now();
+    log_frame(now - previous_return, done - now);
+    previous_return = done;
+}
+
+}
