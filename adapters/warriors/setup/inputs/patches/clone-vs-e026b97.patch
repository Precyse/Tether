diff --git a/runtime/src/detmath.cpp b/runtime/src/detmath.cpp
new file mode 100644
index 0000000..c8875f4
--- /dev/null
+++ b/runtime/src/detmath.cpp
@@ -0,0 +1,181 @@
+#include "ps2/detmath.hpp"
+
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+#if defined(__SSE2__) || defined(_M_X64)
+#include <xmmintrin.h>
+#else
+#include <cfenv>
+#endif
+
+// A fused multiply-add rounds once where a separate multiply and add round twice, so a build that allows it gives other last bits than one that does not, and a
+// compiler told about a newer CPU allows it. Every product here goes through fence(), which the optimiser cannot see through, so no flag can fuse it with the add that
+// follows. (PS2_DETMATH_NO_FENCE exists only for tests\detmath_test.cpp, which builds the file both ways to show the fence is what keeps the results the same.)
+#if defined(PS2_DETMATH_NO_FENCE)
+#define PS2_FENCE(v) ((void)0)
+#elif defined(__x86_64__) || defined(_M_X64)
+#define PS2_FENCE(v) __asm__ volatile("" : "+x"(v))
+#elif defined(__aarch64__)
+#define PS2_FENCE(v) __asm__ volatile("" : "+w"(v))
+#else
+#define PS2_FENCE(v) __asm__ volatile("" : "+r"(v))
+#endif
+
+namespace ps2::detmath {
+
+namespace {
+
+constexpr double kPi = 3.14159265358979323846;
+constexpr double kHalfPi = 1.57079632679489661923;
+constexpr double kInvTwoPi = 0.159154943091895335769;
+// 2 pi in three parts (fdlibm's pi/2 split times four), the first two with few enough bits that k times each is exact for any k a float argument up to a few million gives.
+constexpr double kTwoPi1 = 4 * 1.57079632673412561417e+00, kTwoPi2 = 4 * 6.07710050630396597660e-11, kTwoPi3 = 4 * 2.02226624871116645580e-21;
+constexpr double kInvLn2 = 1.44269504088896338700;
+constexpr double kLn2High = 6.93147180369123816490e-01, kLn2Low = 1.90821492927058770002e-10;    // fdlibm's split: k * high is exact for the k used here
+constexpr double kExpMax = 709.0, kExpMin = -745.0;                                               // beyond these exp is infinity or zero as a float too
+constexpr int kDoubleExponentBias = 1023, kDoubleMantissaBits = 52;
+constexpr std::uint32_t kQuietNanBits = 0x7FC00000u;
+constexpr std::uint32_t kMxcsrDefault = 0x1F80;   // exceptions masked, round to nearest, flush-to-zero and denormals-are-zero off
+
+float nan_float() {
+    float value;
+    std::memcpy(&value, &kQuietNanBits, sizeof value);
+    return value;
+}
+
+double mul(double a, double b) {
+    double product = a * b;
+    PS2_FENCE(product);
+    return product;
+}
+
+double pow2(int n) {
+    const std::uint64_t bits = static_cast<std::uint64_t>(n + kDoubleExponentBias) << kDoubleMantissaBits;
+    double value;
+    std::memcpy(&value, &bits, sizeof value);
+    return value;
+}
+
+double clamp_float_range(double x) {
+    constexpr double kMax = std::numeric_limits<float>::max();
+    return x > kMax ? kMax : (x < -kMax ? -kMax : x);
+}
+
+// sin on [-pi/2, pi/2]: Taylor series to x^19 in Horner form.
+double sin_core(double x) {
+    const double x2 = mul(x, x);
+    double p = -8.220635246624329716956e-18;
+    p = mul(p, x2) + 2.811457254345520763199e-15;
+    p = mul(p, x2) - 7.647163731819816475901e-13;
+    p = mul(p, x2) + 1.605904383682161459939e-10;
+    p = mul(p, x2) - 2.505210838544171877505e-8;
+    p = mul(p, x2) + 2.755731922398589065256e-6;
+    p = mul(p, x2) - 1.984126984126984126984e-4;
+    p = mul(p, x2) + 8.333333333333333333333e-3;
+    p = mul(p, x2) - 1.666666666666666666667e-1;
+    return x + mul(mul(x, x2), p);
+}
+
+double reduce_two_pi(double x) {
+    const double k = std::floor(mul(x, kInvTwoPi) + 0.5);
+    return ((x - mul(k, kTwoPi1)) - mul(k, kTwoPi2)) - mul(k, kTwoPi3);
+}
+
+double sin_double(double x) {
+    double r = reduce_two_pi(x);
+    if (r > kHalfPi) r = kPi - r;
+    else if (r < -kHalfPi) r = -kPi - r;
+    return sin_core(r);
+}
+
+// atan for x >= 0: the argument is brought under 1 by the reciprocal, under tan(pi / 16) by two halvings (atan a = 2 atan(a / (1 + sqrt(1 + a a)))), then a series.
+double atan_nonnegative(double x) {
+    const bool reciprocal = x > 1.0;
+    double a = reciprocal ? 1.0 / x : x;
+    a = a / (1.0 + std::sqrt(1.0 + mul(a, a)));
+    a = a / (1.0 + std::sqrt(1.0 + mul(a, a)));
+    const double a2 = mul(a, a);
+    double p = -4.347826086956521739130e-2;
+    p = mul(p, a2) + 4.761904761904761904762e-2;
+    p = mul(p, a2) - 5.263157894736842105263e-2;
+    p = mul(p, a2) + 5.882352941176470588235e-2;
+    p = mul(p, a2) - 6.666666666666666666667e-2;
+    p = mul(p, a2) + 7.692307692307692307692e-2;
+    p = mul(p, a2) - 9.090909090909090909091e-2;
+    p = mul(p, a2) + 1.111111111111111111111e-1;
+    p = mul(p, a2) - 1.428571428571428571429e-1;
+    p = mul(p, a2) + 2.000000000000000000000e-1;
+    p = mul(p, a2) - 3.333333333333333333333e-1;
+    const double quarter = a + mul(mul(a, a2), p);
+    const double result = 4.0 * quarter;
+    return reciprocal ? kHalfPi - result : result;
+}
+
+double atan_double(double x) { return x < 0.0 ? -atan_nonnegative(-x) : atan_nonnegative(x); }
+
+double atan2_double(double y, double x) {
+    const double ax = std::fabs(x), ay = std::fabs(y);
+    if (ax == 0.0 && ay == 0.0) return std::signbit(x) ? std::copysign(kPi, y) : std::copysign(0.0, y);
+    const double base = ax >= ay ? atan_nonnegative(ay / ax) : kHalfPi - atan_nonnegative(ax / ay);
+    return std::copysign(std::signbit(x) ? kPi - base : base, y);
+}
+
+double exp_double(double z) {
+    if (z > kExpMax) return std::numeric_limits<double>::infinity();
+    if (z < kExpMin) return 0.0;
+    const double k = std::floor(mul(z, kInvLn2) + 0.5);
+    const double r = (z - mul(k, kLn2High)) - mul(k, kLn2Low);
+    double p = 8.896791392450573286749e-22;
+    p = mul(p, r) + 1.957294106339126123085e-20;
+    p = mul(p, r) + 4.110317623312164858478e-19;
+    p = mul(p, r) + 8.220635246624329716956e-18;
+    p = mul(p, r) + 1.561920696858622646222e-16;
+    p = mul(p, r) + 2.811457254345520763199e-15;
+    p = mul(p, r) + 4.779477332387385297438e-14;
+    p = mul(p, r) + 7.647163731819816475901e-13;
+    p = mul(p, r) + 1.147074559772972471385e-11;
+    p = mul(p, r) + 1.605904383682161459939e-10;
+    p = mul(p, r) + 2.087675698786809897921e-9;
+    p = mul(p, r) + 2.505210838544171877505e-8;
+    p = mul(p, r) + 2.755731922398589065256e-7;
+    p = mul(p, r) + 2.755731922398589065256e-6;
+    p = mul(p, r) + 2.480158730158730158730e-5;
+    p = mul(p, r) + 1.984126984126984126984e-4;
+    p = mul(p, r) + 1.388888888888888888889e-3;
+    p = mul(p, r) + 8.333333333333333333333e-3;
+    p = mul(p, r) + 4.166666666666666666667e-2;
+    p = mul(p, r) + 1.666666666666666666667e-1;
+    p = mul(p, r) + 5.000000000000000000000e-1;
+    p = mul(p, r) + 1.0;
+    p = mul(p, r) + 1.0;
+    const int n = static_cast<int>(k);
+    const int half = n / 2;
+    return mul(mul(p, pow2(half)), pow2(n - half));
+}
+
+}
+
+float sin(float x) { return std::isfinite(x) ? static_cast<float>(sin_double(static_cast<double>(x))) : nan_float(); }
+
+float atan(float x) { return std::isnan(x) ? nan_float() : static_cast<float>(atan_double(clamp_float_range(static_cast<double>(x)))); }
+
+float atan2(float y, float x) {
+    if (std::isnan(x) || std::isnan(y)) return nan_float();
+    return static_cast<float>(atan2_double(clamp_float_range(static_cast<double>(y)), clamp_float_range(static_cast<double>(x))));
+}
+
+float exp(float x) { return std::isnan(x) ? nan_float() : static_cast<float>(exp_double(static_cast<double>(x))); }
+
+double cos(double x) { return sin_double(x + kHalfPi); }
+
+void pin_fp_environment() {
+#if defined(__SSE2__) || defined(_M_X64)
+    _mm_setcsr(kMxcsrDefault);
+#else
+    std::fesetround(FE_TONEAREST);
+#endif
+}
+
+}
diff --git a/runtime/src/digest.cpp b/runtime/src/digest.cpp
new file mode 100644
index 0000000..48c1a44
--- /dev/null
+++ b/runtime/src/digest.cpp
@@ -0,0 +1,95 @@
+#include "digest.hpp"
+
+#include "iop/iop.hpp"
+#include "iop/sio2.hpp"
+#include "ps2/memory.hpp"
+#include "ps2/system.hpp"
+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace ps2::digest {
+
+namespace {
+
+constexpr std::uint32_t kBlockBytes = 32u << 10;
+constexpr std::uint64_t kPrime = 0x100000001B3ull;
+constexpr std::uint64_t kSeed = 0xCBF29CE484222325ull;
+
+std::FILE *g_summary = nullptr, *g_blocks = nullptr, *g_probes = nullptr, *g_machine = nullptr;
+std::uint32_t g_every = 0;
+
+std::uint64_t hash(const std::uint8_t *data, std::size_t bytes, std::uint64_t h = kSeed) {
+    for (std::size_t i = 0; i + 8 <= bytes; i += 8) {
+        std::uint64_t w;
+        std::memcpy(&w, data + i, 8);
+        h = (h ^ w) * kPrime;
+        h ^= h >> 29;
+    }
+    for (std::size_t i = bytes & ~std::size_t{7}; i < bytes; ++i) h = (h ^ data[i]) * kPrime;
+    return h;
+}
+
+void block_hashes(const std::uint8_t *data, std::size_t bytes) {
+    for (std::size_t at = 0; at < bytes; at += kBlockBytes) std::fprintf(g_blocks, " %08x", static_cast<std::uint32_t>(hash(data + at, kBlockBytes)));
+}
+
+}
+
+// The card is 8.6 MB and changes only when the game saves: its hash is made again only when the card's generation moved.
+static std::uint64_t card_hash() {
+    static std::uint64_t seen = 0, cached = 0;
+    std::uint64_t generation = 0;
+    const std::vector<std::uint8_t> &image = iop::sio2::card_image(generation);
+    if (image.empty()) return 0;
+    if (generation != seen) {
+        cached = hash(image.data(), image.size());
+        seen = generation;
+    }
+    return cached;
+}
+
+MemoryHashes memory_hashes() {
+    return {hash(g_ram, kRamSize), hash(g_spr, kScratchpadSize), hash(iop::ram_ptr(0), iop::kRamSize), card_hash(), hash(g_extra, extra_used())};
+}
+
+bool open(const std::string &path, std::uint32_t every) {
+    g_every = every;
+    g_summary = std::fopen(path.c_str(), "w");
+    g_blocks = std::fopen((path + ".blocks").c_str(), "w");
+    g_probes = std::fopen((path + ".probes").c_str(), "w");
+    g_machine = std::fopen((path + ".machine").c_str(), "w");
+    return g_summary && g_blocks && g_probes && g_machine && every;
+}
+
+bool due(std::uint64_t frame) { return g_every && g_summary && frame % g_every == 0; }
+
+void on_machine(std::uint64_t frame, const std::uint8_t *state, std::size_t bytes) {
+    std::fprintf(g_machine, "%llu %016llx %zu\n", static_cast<unsigned long long>(frame), static_cast<unsigned long long>(hash(state, bytes)), bytes);
+    std::fflush(g_machine);
+}
+
+void on_frame(std::uint64_t frame, std::uint64_t cycles) {
+    if (!due(frame)) return;
+    const auto ull = [](std::uint64_t v) { return static_cast<unsigned long long>(v); };
+    const MemoryHashes h = memory_hashes();
+    std::fprintf(g_summary, "%llu %llu ee=%016llx spr=%016llx iop=%016llx extra=%016llx\n", ull(frame), ull(cycles), ull(h.ee), ull(h.spr), ull(h.iop), ull(h.extra));
+    std::fprintf(g_blocks, "%llu ee", ull(frame));
+    block_hashes(g_ram, kRamSize);
+    std::fprintf(g_blocks, " iop");
+    block_hashes(iop::ram_ptr(0), iop::kRamSize);
+    std::fprintf(g_blocks, " extra");
+    block_hashes(g_extra, extra_used());
+    std::fprintf(g_blocks, "\n");
+    for (const auto &[at, bytes] : g_options.probes) {
+        std::fprintf(g_probes, "%llu %08x", ull(frame), at);
+        for (std::uint32_t i = 0; i < bytes; i += 4) std::fprintf(g_probes, " %08x", ld32(at + i));
+        std::fprintf(g_probes, "\n");
+    }
