--- /dev/null
+++ b/runtime/src/gs/mip.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "gs.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace ps2::gs {
+
+inline constexpr std::uint32_t kMaxMipLevel = 6;
+inline constexpr std::uint32_t kMipTbpBits = 14, kMipTbwBits = 6;
+
+// TEX1 and MIPTBP1/2 of a context in the form the samplers use. MMIN: 0 nearest, 1 linear (level 0 only), 2 nearest texel in the nearest level, 3 nearest texel in
+// both neighbouring levels blended, 4 linear in the nearest level, 5 linear in both neighbouring levels blended (trilinear).
+struct MipConfig {
+    std::uint32_t mxl, mmin, lcm, l;
+    float k;                                     // TEX1.K: signed 12 bits in 1/16 LOD steps
+    std::uint32_t tbp[kMaxMipLevel + 1], tbw[kMaxMipLevel + 1];   // levels 1 to 6 (index 0 unused: level 0 comes from TEX0)
+};
+
+inline MipConfig mip_config(const Context &c) {
+    MipConfig m{};
+    m.mxl = std::min<std::uint32_t>(static_cast<std::uint32_t>(c.tex1 >> 2) & 7u, kMaxMipLevel);
+    m.mmin = static_cast<std::uint32_t>(c.tex1 >> 6) & 7u;
+    m.lcm = static_cast<std::uint32_t>(c.tex1) & 1u;
+    m.l = static_cast<std::uint32_t>(c.tex1 >> 19) & 3u;
+    m.k = static_cast<float>(static_cast<std::int32_t>(((c.tex1 >> 32) & 0xFFFu) << 20) >> 20) / 16.0f;
+    const std::uint64_t regs[2] = {c.miptbp1, c.miptbp2};
+    constexpr std::uint32_t kLevelBits = 20;   // one level: TBP (14 bits) then TBW (6 bits)
+    for (std::uint32_t level = 1; level <= kMaxMipLevel; ++level) {
+        const std::uint64_t field = regs[(level - 1) / 3] >> (((level - 1) % 3) * kLevelBits);
+        m.tbp[level] = static_cast<std::uint32_t>(field) & ((1u << kMipTbpBits) - 1u);
+        m.tbw[level] = static_cast<std::uint32_t>(field >> kMipTbpBits) & ((1u << kMipTbwBits) - 1u);
+    }
+    return m;
+}
+
+// The LOD of a fragment: log2(1/|Q|) * 2^L + K, or just K when LCM fixes it (LCM is forced for FST textures: they have no Q).
+inline float mip_lod(const MipConfig &m, float q, bool fst) {
+    if (m.lcm || fst || q == 0.0f) return m.k;
+    return -std::log2(std::fabs(q)) * static_cast<float>(1u << m.l) + m.k;
+}
+
+}
