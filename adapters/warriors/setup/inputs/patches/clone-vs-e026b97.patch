@@ -0,0 +1,30 @@
+#include "game_flow.hpp"
+
+#include "ps2/memory.hpp"
+#include "ps2/system.hpp"
+#include "warriors.hpp"
+
+#include <cstring>
+
+namespace ps2::netplay {
+
+namespace {
+
+bool in_front_end_or_unloaded(std::uint32_t game) {
+    char name[warriors::kLevelNameBytes + 1] = {};
+    for (std::uint32_t i = 0; i < warriors::kLevelNameBytes; ++i) name[i] = static_cast<char>(ld8(game + warriors::kLevelNameOffset + i));
+    return name[0] == '\0' || std::strcmp(name, warriors::kFrontEndLevel) == 0;
+}
+
+}
+
+TitleReturn return_to_title() {
+    const std::uint32_t game = ld32(warriors::kGameStatePointer);
+    if (!game || in_front_end_or_unloaded(game)) return TitleReturn::not_needed;
+    if (ld32(game + warriors::kLevelFlowRequestOffset) != 0) return TitleReturn::waiting;
+    call_guest(g_cpu, warriors::kSessionSetChapter, game, warriors::kQuitSection);
+    call_guest(g_cpu, warriors::kLevelEnterNamed, warriors::kMenuLevelNameString);
+    return TitleReturn::done;
+}
+
+}
