+#pragma once
+
+namespace ps2::netplay {
+
+enum class TitleReturn {
+    not_needed,   // the game is in the front end already (or has not loaded a level yet): nothing to leave
+    waiting,      // a level change is under way; ask again at the next frame
+    done,         // the game was told to leave the level the way the pause menu's Quit does
+};
+
+// Takes the game back to its title through its own quit path (session_set_chapter, level_enter_named("menu")). Called from the vblank handler
+// like a --call, once the session that tied this machine to others is over.
+TitleReturn return_to_title();
+
+}
diff --git a/runtime/src/netplay/history.cpp b/runtime/src/netplay/history.cpp
new file mode 100644
index 0000000..5fb20bc
--- /dev/null
+++ b/runtime/src/netplay/history.cpp
@@ -0,0 +1,77 @@
+#include "history.hpp"
+
+namespace ps2::netplay {
+
+namespace {
+
+constexpr std::uint8_t kDigestFlag = 0x80;
+
+}
+
+void History::start(std::uint64_t first) {
+    recording_ = true;
+    first_ = first;
+    records_.clear();
+}
+
+void History::stop() {
+    recording_ = false;
+    records_.clear();
+}
+
+void History::add(const FrameRecord &record) { records_.push_back(record); }
+
+const FrameRecord *History::at(std::uint64_t frame) const { return frame >= first_ && frame < end() ? &records_[static_cast<std::size_t>(frame - first_)] : nullptr; }
+
+void History::discard_before(std::uint64_t frame) {
+    while (first_ < frame && !records_.empty()) {
+        records_.pop_front();
+        ++first_;
+    }
+}
+
+void write_history(Writer &w, const HistoryMessage &message) {
+    w.u64(message.join_frame).u16(message.delay).u8(message.resync);
+    for (std::uint64_t from : message.press_from) w.u64(from);
+    w.u64(message.base).u8(static_cast<std::uint8_t>(message.records.size()));
+    std::size_t digests = 0;
+    for (const FrameRecord &record : message.records) {
+        const bool digest = record.has_digest && digests < kDigestsPerMessage;
+        w.u8(static_cast<std::uint8_t>(record.plugged | (digest ? kDigestFlag : 0)));
+        for (const PadSample &pad : record.pads) put_sample(w, pad);
+        if (digest) {
+            put_hashes(w, record.digest);
+            ++digests;
+        }
+    }
+}
+
+bool read_history(Reader &r, HistoryMessage &message) {
+    message.join_frame = r.u64();
+    message.delay = r.u16();
+    message.resync = r.u8();
+    for (std::uint64_t &from : message.press_from) from = r.u64();
+    message.base = r.u64();
+    const std::uint8_t count = r.u8();
+    if (!r.ok() || count > kHistoryPerMessage) return false;
+    message.records.assign(count, {});
+    for (FrameRecord &record : message.records) {
+        const std::uint8_t flags = r.u8();
+        record.plugged = flags & ~kDigestFlag;
+        for (PadSample &pad : record.pads) pad = get_sample(r);
+        record.has_digest = (flags & kDigestFlag) != 0;
+        if (record.has_digest) record.digest = get_hashes(r);
+    }
+    return r.ok();
+}
+
+void write_history_ack(Writer &w, const HistoryAck &ack) { w.u64(ack.next).u64(ack.replayed).u32(ack.fps); }
+
+bool read_history_ack(Reader &r, HistoryAck &ack) {
+    ack.next = r.u64();
+    ack.replayed = r.u64();
+    ack.fps = r.u32();
+    return r.ok();
+}
+
+}
diff --git a/runtime/src/netplay/history.hpp b/runtime/src/netplay/history.hpp
new file mode 100644
index 0000000..9b75c61
--- /dev/null
+++ b/runtime/src/netplay/history.hpp
@@ -0,0 +1,73 @@
+#pragma once
+
+#include "wire.hpp"
+
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <vector>
+
+// The record that lets a machine join, or come back after a desync, without anyone else stopping: the host snapshots its game at one frame and keeps what it
+// applied from the next frame on; the machine loads the snapshot and replays those frames (no waiting, no pacing) until it is level with the game, then plays
+// on in lockstep. Replaying the applied pads (not the raw samples) repeats the host's own START presses and unplugs without the machine having to decide them.
+namespace ps2::netplay {
+
+// What a machine applied for one frame.
+struct FrameRecord {
+    std::array<PadSample, kPadCount> pads;
+    std::uint8_t plugged = 0;     // bit p: pad p was plugged in
+    bool has_digest = false;      // the memory digest taken at the start of this frame (one every digest_every frames)
+    Hashes digest;
+};
+
+constexpr std::size_t kHistoryPerMessage = 16;
+constexpr std::size_t kDigestsPerMessage = 2;
+constexpr std::uint64_t kHistoryMaxFrames = 7200;     // two minutes; a machine that cannot catch up in that time is given up
+
+class History {
+public:
+    // The next record added is the one of frame `first`.
+    void start(std::uint64_t first);
+    void stop();
+    bool recording() const { return recording_; }
+    void add(const FrameRecord &record);
+    std::uint64_t first() const { return first_; }
+    std::uint64_t end() const { return first_ + records_.size(); }   // one past the newest frame held
+    const FrameRecord *at(std::uint64_t frame) const;
+    // The machine that replays: forgets the frames before `frame`.
+    void discard_before(std::uint64_t frame);
+    bool full() const { return records_.size() >= kHistoryMaxFrames; }
+
+private:
+    bool recording_ = false;
+    std::uint64_t first_ = 0;
+    std::deque<FrameRecord> records_;
+};
+
+// One kMsgHistory: `records` are the frames from `base` on.
+struct HistoryMessage {
+    std::uint64_t join_frame = 0;                          // the frame the machine plays live from; 0 until the host has decided it
+    std::uint16_t delay = 0;                               // the session's input delay
+    std::uint8_t resync = 0;                               // 1: the machine's pad stays plugged until it plays live (its game went out of step; it is not a new player)
+    std::array<std::uint64_t, kPadCount> press_from{};     // the frame of the game's own START press for each port
+    std::uint64_t base = 0;
+    std::vector<FrameRecord> records;
+};
+
+// `w` was made with kMsgHistory.
+void write_history(Writer &w, const HistoryMessage &message);
+// `r` has read the type.
+bool read_history(Reader &r, HistoryMessage &message);
+
+// kMsgHistoryAck: how much of the history a machine holds and how fast it replays.
+struct HistoryAck {
+    std::uint64_t next = 0;        // the first frame it does not hold yet
+    std::uint64_t replayed = 0;    // the last frame it has run
+    std::uint32_t fps = 0;         // frames per second it replays at
+};
+// `w` was made with kMsgHistoryAck.
+void write_history_ack(Writer &w, const HistoryAck &ack);
+// `r` has read the type.
+bool read_history_ack(Reader &r, HistoryAck &ack);
+
+}
diff --git a/runtime/src/netplay/latejoin.cpp b/runtime/src/netplay/latejoin.cpp
new file mode 100644
index 0000000..0c2884e
--- /dev/null
+++ b/runtime/src/netplay/latejoin.cpp
@@ -0,0 +1,165 @@
+#include "latejoin.hpp"
+
+#include "log.hpp"
+
+#include <algorithm>
+
+namespace ps2::netplay {
+
+namespace {
+
+constexpr std::uint64_t kReadyTimeoutMs = 30000;       // the machine has the snapshot and has not said it loaded it
+constexpr std::uint64_t kSilenceMs = 15000;            // the machine stopped answering while it catches up
+constexpr std::uint64_t kProgressLogMs = 5000;         // between the progress lines of a join
+constexpr std::uint64_t kStreamRepeatMs = 100;         // the history window goes out again when no acknowledgement moved it on
+constexpr std::size_t kWindowMessages = 16;            // history messages in flight: 256 frames
+constexpr std::uint64_t kCatchupGapFrames = 45;        // the machine is near enough to the game for the host to name the frame it plays live from
+constexpr std::uint64_t kJoinLeadFrames = 90;          // that frame is at least this far ahead of the game (the machine replays the gap meanwhile)
+constexpr std::uint64_t kMaxJoinLeadFrames = 600;
+constexpr std::uint32_t kRealtimeFps = 60;
+constexpr std::uint32_t kFasterThanRealtimeFps = 20;   // replay speed above real time needed before the lead is sized from it
+
+// Milliseconds from `then` to `now`; zero when `then` is later (a message read after `now` was taken).
+std::uint64_t since(std::uint64_t now, std::uint64_t then) { return then >= now ? 0 : now - then; }
+
+}
+
+LateJoin::LateJoin(Session &session, std::unique_ptr<Transport> kept, Transport *link, int port, bool resync, const Terms &terms,
+                   std::shared_future<std::vector<std::uint8_t>> packed, std::uint32_t bytes_per_second)
+    : session_(session), kept_(std::move(kept)), link_(link), port_(port), resync_(resync), terms_(terms), rate_(bytes_per_second), packed_(std::move(packed)),
+      started_(now_ms()), phase_at_(started_), heard_at_(started_) {
+    ack_.next = terms.frame + 1;
+    session_.start_recording(terms.frame + 1);
+}
+
+LateJoin::~LateJoin() { session_.stop_recording(); }
+
+LateJoin::State LateJoin::fail(const char *why) {
+    log("pad %d: %s; the game goes on without it", port_ + 1, why);
+    return State::failed;
+}
+
+// One message a machine sent before it is in the session (afterwards the session reads the link and keeps what the machine reports).
+void LateJoin::handle(const std::uint8_t *data, std::size_t size) {
+    Reader r(data, size);
+    if (r.type() == kMsgReady) {
+        const std::uint64_t frame = r.u64();
+        const Hashes theirs = get_hashes(r);
+        const bool ok = r.u8() != 0;
+        if (!r.ok() || ready_) return;
+        ready_ = ok && theirs == terms_.hashes && frame == terms_.frame;
+        if (!ready_) {
+            log("pad %d loaded the snapshot but its memory differs from ours (ee %016llx against %016llx)", port_ + 1, ull(theirs.ee), ull(terms_.hashes.ee));
+            heard_at_ = 0;
+        } else {
+            log("pad %d confirmed the snapshot: memory hashes match at frame %llu", port_ + 1, ull(frame));
+        }
+    } else if (r.type() == kMsgHistoryAck) {
+        HistoryAck ack;
+        if (!read_history_ack(r, ack)) return;
+        if (!ready_) {
+            ready_ = true;   // a machine that answers with history acknowledgements has loaded the snapshot (its ready message was lost)
+            log("pad %d is already catching up (its ready message was lost)", port_ + 1);
+        }
+        if (ack.next >= ack_.next) {
+            if (ack.next > ack_.next) heard_at_ = now_ms();
+            ack_ = ack;
+        }
+    } else if (r.type() == kMsgBye) {
+        heard_at_ = 0;
+    }
+}
+
+void LateJoin::read_link() {
+    std::uint8_t buffer[kMaxMessage];
+    for (int n = link_->recv(buffer, sizeof buffer, 0); n > 0; n = link_->recv(buffer, sizeof buffer, 0)) handle(buffer, static_cast<std::size_t>(n));
+}
+
+// The lead is sized from how fast the machine replays: it has to cover the gap while the game runs on at real time.
+void LateJoin::decide_join_frame() {
+    const std::uint64_t host_next = session_.next_frame();
+    if (!ack_.replayed || ack_.replayed + kCatchupGapFrames < host_next) return;
+    const std::uint64_t gap = host_next - std::min(host_next, ack_.replayed);
+    std::uint64_t lead = kJoinLeadFrames;
+    if (ack_.fps > kRealtimeFps + kFasterThanRealtimeFps) lead = std::max(lead, gap * kRealtimeFps * 3 / 2 / (ack_.fps - kRealtimeFps) + kJoinLeadFrames / 2);
+    join_frame_ = host_next + std::min(lead, kMaxJoinLeadFrames);
+    session_.admit(link_, port_, join_frame_);
+    log("pad %d is %llu frames behind and replays %u frames per second: it plays live from frame %llu", port_ + 1, ull(gap), ack_.fps, ull(join_frame_));
+}
+
+// The history from the machine's acknowledged frame on, a window at a time; once the live frame is named every message carries it.
+void LateJoin::stream() {
+    const std::uint64_t now = now_ms();
+    if (ack_.next == last_acked_ && since(now, streamed_at_) < kStreamRepeatMs) return;
+    last_acked_ = ack_.next;
+    streamed_at_ = now;
+    const History &history = session_.history();
+    std::uint64_t base = ack_.next;
+    for (std::size_t i = 0; i < kWindowMessages; ++i) {
+        if (base >= history.end()) {
+            if (i != 0 || !join_frame_ || history.end() == history.first()) break;
+            base = history.end() - 1;
+        }
+        HistoryMessage message;
+        if (!session_.history_message(port_, base, join_frame_, message)) break;
+        Writer w(kMsgHistory);
+        write_history(w, message);
+        link_->send(w.bytes().data(), w.bytes().size());
+        base += message.records.size();
+    }
+}
+
+LateJoin::State LateJoin::tick() {
+    const std::uint64_t now = now_ms();
+    switch (phase_) {
+    case Phase::packing:
+        if (packed_.wait_for(std::chrono::seconds(0)) != std::future_status::ready) return State::working;
+        upload_ = std::make_unique<SnapshotUploader>(*link_, terms_, packed_.get(), rate_);
+        log("pad %d: snapshot of frame %llu packed in %llu ms; sending it while the game runs on", port_ + 1, ull(terms_.frame), ull(now - started_));
+        phase_ = Phase::uploading;
+        return State::working;
+    case Phase::uploading: {
+        const SnapshotUploader::State state = upload_->step(0);
+        if (state == SnapshotUploader::State::failed) return fail("the snapshot could not be delivered");
+        if (state == SnapshotUploader::State::running) return State::working;
+        phase_ = Phase::loading;
+        phase_at_ = heard_at_ = now;
+        for (const std::vector<std::uint8_t> &message : upload_->take_other()) handle(message.data(), message.size());
+        upload_.reset();
+        return State::working;
+    }
+    case Phase::loading:
+        read_link();
+        if (!heard_at_) return fail("the snapshot it loaded does not match ours, or it left");
+        if (ready_) {
+            phase_ = Phase::streaming;
+            heard_at_ = now;
+        } else if (since(now, phase_at_) > kReadyTimeoutMs) {
+            return fail("it never confirmed the snapshot");
+        }
+        return State::working;
+    case Phase::streaming:
+        if (admitted()) ack_ = session_.join_progress(port_);
+        else read_link();
+        if (admitted() && ack_.next != last_acked_) heard_at_ = now;
+        if (since(now, progress_logged_) >= kProgressLogMs) {
+            progress_logged_ = now;
+            log("pad %d catches up: it holds the history to frame %llu and has run frame %llu (%u frames per second); the game is at frame %llu", port_ + 1, ull(ack_.next), ull(ack_.replayed), ack_.fps, ull(session_.next_frame()));
+        }
+        if (!heard_at_ || since(now, heard_at_) > kSilenceMs) return fail("it stopped answering while catching up");
+        if (session_.history().full()) return fail("it could not catch up within the history kept");
+        if (!admitted()) {
+            decide_join_frame();
+            if (admitted() && !admit_reported_) {
+                admit_reported_ = true;
+                stream();
+                return State::admitted;
+            }
+        }
+        stream();
+        return admitted() && ack_.next >= join_frame_ ? State::finished : State::working;
+    }
+    return State::working;
+}
+
+}
diff --git a/runtime/src/netplay/latejoin.hpp b/runtime/src/netplay/latejoin.hpp
new file mode 100644
index 0000000..3459bc8
--- /dev/null
+++ b/runtime/src/netplay/latejoin.hpp
@@ -0,0 +1,60 @@
+#pragma once
+
+#include "history.hpp"
+#include "session.hpp"
+#include "snapshot.hpp"
+
+#include <future>
+#include <memory>
+#include <vector>
+
+namespace ps2::netplay {
+
+// Host: brings one machine into the running game without stopping it, whether it is a new player or a machine whose game went out of step. The snapshot taken at one
+// frame is packed on a thread and sent a little at a time between frames; then, while the machine loads it, the frames the game has run since are sent (the session
+// records them, history.hpp) until the machine is nearly level, when the host names the frame it plays live from and admits it to the session. The other players
+// notice nothing but a pause of a few frames at the start (the machine state is copied at the top of the run loop).
+class LateJoin {
+public:
+    enum class State { working, admitted, finished, failed };
+
+    // `kept` is the link when the machine is new and the host does not own it yet (it moves to the session at admit); a resynced machine, or one that connected
+    // before the game started, already has its link, in `link`. `packed` is the packed machine state at terms.frame, shared by every machine joining at once.
+    LateJoin(Session &session, std::unique_ptr<Transport> kept, Transport *link, int port, bool resync, const Terms &terms, std::shared_future<std::vector<std::uint8_t>> packed,
+             std::uint32_t bytes_per_second);
+    ~LateJoin();
+
+    // Called often (every frame and while the host waits for a peer). `admitted` once, the moment the machine joined the session; `finished` when it holds everything it needs.
+    State tick();
+    // After `admitted`: the link of a new machine, for the host to keep.
+    std::unique_ptr<Transport> take_link() { return std::move(kept_); }
+    int port() const { return port_; }
+    bool resync() const { return resync_; }
+    bool admitted() const { return join_frame_ != 0; }
+
+private:
+    enum class Phase { packing, uploading, loading, streaming };
+
+    State fail(const char *why);
+    void handle(const std::uint8_t *data, std::size_t size);
+    void read_link();
+    void stream();
+    void decide_join_frame();
+
+    Session &session_;
+    std::unique_ptr<Transport> kept_;
+    Transport *link_;
+    int port_;
+    bool resync_;
+    Terms terms_;
+    std::uint32_t rate_;
+    std::shared_future<std::vector<std::uint8_t>> packed_;
+    std::unique_ptr<SnapshotUploader> upload_;
+    Phase phase_ = Phase::packing;
+    HistoryAck ack_;
+    bool ready_ = false, reported_ready_ = false, admit_reported_ = false;
+    std::uint64_t join_frame_ = 0;
+    std::uint64_t started_, phase_at_, heard_at_, streamed_at_ = 0, last_acked_ = 0, progress_logged_ = 0;
+};
+
+}
diff --git a/runtime/src/netplay/log.hpp b/runtime/src/netplay/log.hpp
new file mode 100644
index 0000000..288f9ff
--- /dev/null
+++ b/runtime/src/netplay/log.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <chrono>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+
+namespace ps2::netplay {
+
+// Milliseconds on a monotonic clock. Used only for networking (timeouts, RTT), never for anything the game sees.
+inline std::uint64_t now_ms() {
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+// One line on stderr, "[net] " prefixed. Everything a player needs to know goes through here.
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((format(printf, 1, 2)))
+#endif
+inline void log(const char *format, ...) {
+    std::fputs("[net] ", stderr);
+    va_list args;
+    va_start(args, format);
+    std::vfprintf(stderr, format, args);
+    va_end(args);
+    std::fputc('\n', stderr);
+    std::fflush(stderr);
+}
+
+inline unsigned long long ull(std::uint64_t v) { return static_cast<unsigned long long>(v); }
+
+}
diff --git a/runtime/src/netplay/netplay.cpp b/runtime/src/netplay/netplay.cpp
new file mode 100644
index 0000000..52cc195
--- /dev/null
+++ b/runtime/src/netplay/netplay.cpp
@@ -0,0 +1,834 @@
+#include "netplay.hpp"
+
+#include "../digest.hpp"
+#include "board.hpp"
+#include "../pad_input.hpp"
+#include "compress.hpp"
+#include "fingerprint.hpp"
+#include "game_flow.hpp"
+#include "latejoin.hpp"
+#include "log.hpp"
+#include "../overlay/overlay.hpp"
+#include "ps2/memory.hpp"
+#include "ps2/system.hpp"
+#include "session.hpp"
+#include "session_file.hpp"
+#include "snapshot.hpp"
+#include "status_file.hpp"
+#include "udp_transport.hpp"
+#include "warriors.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <memory>
+#include <numeric>
+#include <string>
+#include <thread>
+
+namespace ps2::netplay {
+
+namespace {
+
+constexpr std::uint64_t kReadyTimeoutMs = 30000;
+constexpr int kReadyRepeats = 3;
+constexpr int kHostPollMs = 0;
+constexpr int kReadyPollMs = 50;
+constexpr std::uint16_t kMinDelay = 1;
+constexpr std::uint16_t kMaxDelay = 30;          // half a second; the same bound the session's adaptive delay keeps to
+constexpr int kHostPort = 0;
+constexpr int kSlowTestStepMs = 40;              // how often a machine under --net-slow-test sends while it is slow
+constexpr int kFirstBeyondSio2 = 2;              // pads 0 and 1 are in the machine state, pads 2 and 3 are not
+constexpr std::uint64_t kStartWaitMs = 120000;   // a joiner waits this long for the other players to finish loading
+constexpr std::uint64_t kReadyRepeatMs = 500;
+constexpr int kStartRepeats = 3;
+constexpr double kBytesPerMb = 1048576.0;
+constexpr std::uint64_t kRosterWaitMs = 120000;  // a cold start waits this long for every player before the game starts on its own
+constexpr int kRosterPollMs = 20;
+constexpr const char *kCleanStops[] = {"frame limit reached", "window closed", "Exit"};   // why a run may stop without having crashed
+
+// `syncing`: a joiner whose game went out of step is fetching a fresh copy; `loading`: it has it and the run loop is about to load it.
+enum class State { off, listening, lockstep, syncing, loading, ended, finished };
+
+// Why a session ended, for the one line the launcher reads. The codes are the launcher's RefusalKind names (EngineLog.cs maps the older [net] lines to the same).
+constexpr const char kCodeDesync[] = "GameDesync", kCodePeerGone[] = "PeerGone", kCodeHostLeft[] = "HostLeft", kCodeBuild[] = "BuildDiffers", kCodeFull[] = "LobbyFull",
+                     kCodeUnreachable[] = "HostUnreachable", kCodeLoadFailed[] = "LoadFailed";
+
+Config g_config;
+State g_state = State::off;
+bool g_enabled = false, g_snapshot_wanted = false;
+bool g_title_pending = false;                       // the session ended and the game has not been taken back to its title yet
+bool g_waiting_for_roster = false;                  // cold start: the host has not started the game yet
+std::unique_ptr<HostSocket> g_host;                  // host: the socket every joiner talks to
+std::vector<int> g_joiner_peers;                    // host: g_host peer index of the joiner on port i + 1
+std::vector<std::uint8_t> g_joiner_wanted;           // host: the slot each of them asked for (kAnySlot: none)
+std::vector<std::unique_ptr<Transport>> g_links;    // host: link to the joiner on port i + 1; joiner: the one link to the host
+std::unique_ptr<Session> g_session;
+Terms g_terms;
+Fingerprint g_fingerprint;
+struct PendingJoin {
+    int peer = -1;                                      // host: g_host peer index of a player asking to join the running game (-1 for a machine being resynced)
+    int port = -1;                                      // the port it takes (-1: no join pending)
+    bool resync = false;
+    std::uint8_t wanted = kAnySlot;                     // the slot it asked for
+} g_late;
+struct ServedJoin {
+    std::unique_ptr<LateJoin> job;
+    bool over = false, failed = false;
+};
+std::vector<ServedJoin> g_joins;                        // host: the machines being brought into the running game, all at once, while it runs on
+std::vector<int> g_resync_queue;                        // host: ports whose machines went out of step and wait their turn for a snapshot
+std::vector<std::uint8_t> g_loaded_state;               // joiner: the fresh copy of the game, waiting for the run loop to load it
+bool g_replay_screen = false;                           // joiner: the joining screen is up while the machine replays
+
+// Lockstep needs the game's clock to advance by exactly 1/30 s per update whatever the host's cost model does.
+void pin_game_timer() {
+    constexpr std::uint8_t kEveryVblank = 1;
+    constexpr std::uint8_t kFlagBytes = 4;
+    const bool present = std::any_of(g_options.patches.begin(), g_options.patches.end(), [](const Patch &p) { return p.address == warriors::kFixedStepFlag; });
+    if (!present) g_options.patches.push_back({kEveryVblank, kFlagBytes, warriors::kFixedStepFlag, 1});
+    log("GameTimer fixed step pinned (both machines write the flag at every vblank)");
+}
+
+void serve_join();
+std::uint8_t reserved_ports();
+// The game's own way of saying a player left or came back (registered when the game's code is loaded, hence a function-local static).
+Announcer &announcer() {
+    static Announcer registered;
+    return registered;
+}
+
+// A player left or came back: the game's own message when it has one here, otherwise a notice over the picture saying what happened and what happens next.
+void announce_presence(int port, std::uint8_t event) {
+    const std::string name = player_name(port);
+    if (announcer() && announcer()(port, event, name)) return;
+    const std::string next = "THE GAME CONTINUES WITHOUT " + name + ". " + name + " CAN REJOIN FROM THE LAUNCHER";
+    switch (event) {
+    case kLeftCrashed: overlay::notice(name + "'S GAME CRASHED", next); break;
+    case kLeftLost: overlay::notice(name + " LOST CONNECTION", next); break;
+    case kJoinedBack: overlay::notice(name + " IS BACK", "THE GAME CONTINUES WITH " + name); break;
+    default: overlay::notice(name + " LEFT THE GAME", "THE GAME CONTINUES WITHOUT " + name); break;
+    }
+}
+
+// The host's friendly fire and split screen settings go into the game's switch words on every machine before the session's first snapshot or hash, so they are part of
+// the state the machines agree on.
+void apply_host_switches(const Terms &terms) {
+    if (terms.friendly_fire != kLeaveAlone && ld32(warriors::kFriendlyFireSwitch) != terms.friendly_fire) {
+        st32(warriors::kFriendlyFireSwitch, terms.friendly_fire);
+        log("friendly fire %s (the host's setting)", terms.friendly_fire ? "on" : "off");
+    }
+    if (terms.split_screen != kLeaveAlone && ld32(warriors::kSplitScreenSwitch) != terms.split_screen) {
+        st32(warriors::kSplitScreenSwitch, terms.split_screen);
+        log("split screen %s (the host's setting)", terms.split_screen ? "always" : "auto");
+    }
+}
+
+// A local session has no link and no host: its session file's switches go into the game once, at the first frame, and the pad chord or F9 changes them after that.
+void apply_local_switches() {
+    static bool applied = false;
+    const SessionInfo *info = session();
+    if (applied || !info || info->role != SessionRole::local) return;
+    applied = true;
+    Terms terms;
+    terms.friendly_fire = static_cast<std::uint8_t>(info->friendly_fire);
+    terms.split_screen = static_cast<std::uint8_t>(info->split_screen);
+    apply_host_switches(terms);
+}
+
+Hooks make_hooks(int local_port) {
+    Hooks h;
+    h.announce = announce_presence;
+    h.local_sample = [local_port](std::uint64_t frame) { return local_pad_sample(local_port, frame); };
+    h.apply = [](int port, const PadSample &s) { apply_pad_sample(port, s); };
+    h.plug = [](int port, bool plugged) { plug_pad(port, plugged); };
+    h.hashes = [] { return digest::memory_hashes(); };
+    // The second player joins by the game's own START; pads 3 and 4 join when their player presses START themselves (the overrides in games\warriors).
+    h.player_missing = [](int port) {
+        const std::uint32_t game = ld32(warriors::kGameStatePointer);
+        return port == 1 && game && ld32(game + warriors::kPlayerCountOffset) < warriors::kTwoPlayers;
+    };
+    h.halted = [] { return halted(); };
+    h.service = [] { serve_join(); };
+    return h;
+}
+
+// `joiners_follow`: the host starts alone and the players already connected are brought in one by one as late joiners (LateJoin), so nobody waits for anybody.
+void start_session(int local_port, bool joiners_follow = false) {
+    board::configure(local_port);
+    status::set_stage(status::Stage::booting);
+    SessionSettings settings;
+    settings.delay = g_terms.delay;
+    settings.digest_every = g_terms.digest_every;
+    settings.local_port = local_port;
+    settings.players = g_terms.players;
+    settings.press_start_to_join = g_terms.auto_join != 0;
+    settings.adaptive_delay = g_config.adaptive_delay;
+    std::vector<Transport *> links;
+    if (!joiners_follow)
+        for (const std::unique_ptr<Transport> &link : g_links) links.push_back(link.get());
+    g_session = std::make_unique<Session>(std::move(links), settings, make_hooks(local_port));
+    if (g_terms.late) {
+        g_session->begin_catchup(g_terms.frame + 1, g_terms.plugged);
+        g_replay_screen = true;
+    } else {
+        g_session->begin(g_terms.frame + 1);
+        if (joiners_follow) g_session->hold_ports_open();
+    }
+    g_state = State::lockstep;
+}
+
+std::unique_ptr<Transport> degraded(std::unique_ptr<Transport> link, std::uint32_t seed) {
+    if (!g_config.sim.active()) return link;
+    return make_sim_transport(std::move(link), g_config.sim, seed);
+}
+
+int joiner_slot(int peer) {
+    const auto at = std::find(g_joiner_peers.begin(), g_joiner_peers.end(), peer);
+    return at == g_joiner_peers.end() ? -1 : static_cast<int>(at - g_joiner_peers.begin()) + 1;
+}
+
+void refuse(int peer, const char *reason) {
+    const std::unique_ptr<Transport> link = g_host->open_link(peer);
+    Writer w(kMsgReject);
+    w.str(reason);
+    link->send(w.bytes().data(), w.bytes().size());
+}
+
+// Host: a player with a different build computes a different game, so it is refused before it costs a snapshot. The message names what differs.
+bool same_build(int peer, const Fingerprint &theirs) {
+    if (theirs == g_fingerprint) return true;
+    const std::string parts = differing_parts(g_fingerprint, theirs);
+    log("a player runs a different build and is refused, it differs in: %s (game %016llx runtime %016llx patches %016llx; ours %016llx %016llx %016llx)", parts.c_str(),
+        ull(theirs.game), ull(theirs.runtime), ull(theirs.patches), ull(g_fingerprint.game), ull(g_fingerprint.runtime), ull(g_fingerprint.patches));
+    refuse(peer, ("different build, it differs from the host's in: " + parts + "; everyone must build the game from the same export and use the same patches").c_str());
+    overlay::notice("A PLAYER'S GAME IS A DIFFERENT VERSION", "THEY MUST UPDATE THEIR GAME, THEN JOIN AGAIN");
+    return false;
+}
+
+void answer_hello(int peer, Reader &r) {
+    const Fingerprint theirs = Fingerprint::read(r);
+    const std::uint8_t wanted = r.u8();
+    if (!r.ok() || joiner_slot(peer) > 0) return;
+    if (!same_build(peer, theirs)) return;
+    if (static_cast<int>(g_joiner_peers.size()) + 1 >= g_config.players) {
+        refuse(peer, "the game is full");
+        overlay::notice("A PLAYER TRIED TO JOIN BUT THE GAME IS FULL", "THE GAME GOES ON");
+        return;
+    }
+    g_joiner_peers.push_back(peer);
+    g_joiner_wanted.push_back(wanted);
+    g_links.push_back(degraded(g_host->open_link(peer), 0x85EBCA6Bu + static_cast<std::uint32_t>(g_joiner_peers.size())));
+    log("player %zu of %d connected from %s", g_joiner_peers.size() + 1, g_config.players, g_links.back()->peer_name().c_str());
+    if (static_cast<int>(g_joiner_peers.size()) + 1 < g_config.players) return;
+    g_snapshot_wanted = true;
+    if (g_waiting_for_roster) log("all players have connected: every machine starts the game together from boot");
+    else log("every player is here: taking a snapshot of the game at the next frame");
+}
+
+void poll_for_joiner(int wait_ms) {
+    std::uint8_t buffer[kMaxMessage];
+    int peer = -1;
+    for (int n = g_host->accept(buffer, sizeof buffer, wait_ms, peer); n > 0; n = g_host->accept(buffer, sizeof buffer, kHostPollMs, peer)) {
+        Reader r(buffer, static_cast<std::size_t>(n));
+        if (r.type() == kMsgHello) answer_hello(peer, r);
+    }
+}
+
+// Host, in lockstep: a player asks to join the running game. One at a time; the joiner repeats its HELLO until it is served.
+void answer_late_hello(int peer, Reader &r) {
+    const Fingerprint theirs = Fingerprint::read(r);
+    const std::uint8_t wanted = r.u8();
+    if (!r.ok() || g_late.port >= 0) return;
+    if (!same_build(peer, theirs)) return;
+    const int port = g_session->free_port(wanted == kAnySlot ? -1 : wanted, reserved_ports());
+    if (port < 0) {
+        refuse(peer, "the game is full");
+        overlay::notice("A PLAYER TRIED TO JOIN BUT THE GAME IS FULL", "THE GAME GOES ON");
+        return;
+    }
+    g_late = {peer, port, false, wanted};
+    g_snapshot_wanted = true;
+    log("a player asks to join the running game on pad %d: taking a snapshot of the game at the next frame", port + 1);
+}
+
+void poll_for_late_joiner() {
+    if (!g_config.host || g_late.port >= 0) return;
+    std::uint8_t buffer[kMaxMessage];
+    int peer = -1;
+    for (int n = g_host->accept(buffer, sizeof buffer, kHostPollMs, peer); n > 0; n = g_host->accept(buffer, sizeof buffer, kHostPollMs, peer)) {
+        Reader r(buffer, static_cast<std::size_t>(n));
+        if (r.type() == kMsgHello) answer_late_hello(peer, r);
+    }
+}
+
+void forget_joiners() {
+    g_links.clear();
+    g_joiner_peers.clear();
+    g_joiner_wanted.clear();
+}
+
+// Host, the roster is full: the joiners take the controller ports the launcher's roster gave them (slot n is pad n + 1 on every machine, so the names, colours and
+// panels land on the right players), not the order they happened to connect in. A joiner that asked for nothing, or for a slot another one has, takes what is left.
+void order_joiners() {
+    std::vector<std::size_t> order(g_joiner_peers.size());
+    std::iota(order.begin(), order.end(), std::size_t{0});
+    std::stable_sort(order.begin(), order.end(), [](std::size_t a, std::size_t b) { return g_joiner_wanted[a] < g_joiner_wanted[b]; });
+    std::vector<int> peers;
+    std::vector<std::uint8_t> wanted;
+    std::vector<std::unique_ptr<Transport>> links;
+    for (const std::size_t i : order) {
+        peers.push_back(g_joiner_peers[i]);
+        wanted.push_back(g_joiner_wanted[i]);
+        links.push_back(std::move(g_links[i]));
+    }
+    g_joiner_peers = std::move(peers);
+    g_joiner_wanted = std::move(wanted);
+    g_links = std::move(links);
+    for (std::size_t i = 0; i < g_joiner_wanted.size(); ++i)
+        log("pad %zu is the player that asked for slot %d (%s)", i + 2, g_joiner_wanted[i] == kAnySlot ? -1 : g_joiner_wanted[i] + 1, player_name(static_cast<int>(i) + 1).c_str());
+}
+
+bool wait_for_ready(Transport &link, int slot, const Hashes &sent) {
+    std::uint8_t buffer[kMaxMessage];
+    const std::uint64_t started = now_ms();
+    while (now_ms() - started < kReadyTimeoutMs) {
+        if (halted()) return false;
+        const int n = link.recv(buffer, sizeof buffer, kReadyPollMs);
+        if (n <= 0) continue;
+        Reader r(buffer, static_cast<std::size_t>(n));
+        if (r.type() == kMsgInput) {
+            log("player %d is already running (its ready message was lost)", slot + 1);
+            return true;
+        }
+        if (r.type() != kMsgReady) continue;
+        const std::uint64_t frame = r.u64();
+        const Hashes theirs = get_hashes(r);
+        const bool ok = r.u8() != 0;
+        if (!r.ok()) continue;
+        if (!ok || !(theirs == sent) || frame != g_terms.frame) {
+            log("player %d loaded the snapshot but its memory differs from ours (ee %016llx against %016llx); not starting", slot + 1, ull(theirs.ee), ull(sent.ee));
+            return false;
+        }
+        log("player %d confirmed the snapshot: memory hashes match at frame %llu", slot + 1, ull(frame));
+        return true;
+    }
+    log("player %d never confirmed the snapshot within %llu s", slot + 1, ull(kReadyTimeoutMs / 1000));
+    return false;
+}
+
+// Host: the snapshot (or, for a cold start, the empty one) to the joiner on `terms.slot`, then its confirmation. Both are shown on this machine's screen by the
+// player's name; the game here is frozen meanwhile.
+bool send_and_wait(Transport &link, const Terms &terms, const std::vector<std::uint8_t> &packed) {
+    const std::string name = player_name(terms.slot);
+    overlay::loading_sending(name, 0);
+    status::set_stage(status::Stage::sending, {}, name);
+    const auto sending = [&name](std::uint64_t done, std::uint64_t total) {
+        overlay::loading_sending(name, total ? static_cast<int>(done * 100 / total) : 100);
+        status::set_counts(done, total, status::Unit::bytes);
+    };
+    if (!upload_snapshot(link, terms, packed, [] { return halted(); }, sending)) return false;
+    overlay::loading_waiting(name);
+    return wait_for_ready(link, terms.slot, g_terms.hashes);
+}
+
+bool wait_for_start(Transport &link) {
+    std::uint8_t buffer[kMaxMessage];
+    const std::uint64_t started = now_ms();
+    log("waiting for the other players to finish loading");
+    overlay::loading_waiting("PLAYERS");
+    while (now_ms() - started < kStartWaitMs) {
+        if (halted()) return false;
+        const int n = link.recv(buffer, sizeof buffer, kReadyRepeatMs);
+        if (n > 0) {
+            Reader r(buffer, static_cast<std::size_t>(n));
+            if (r.type() == kMsgStart || r.type() == kMsgInput) {
+                overlay::loading_end();
+                return true;
+            }
+            continue;
+        }
+        Writer w(kMsgReady);
+        w.u64(frame_count());
+        put_hashes(w, g_terms.hashes);
+        w.u8(1);
+        link.send(w.bytes().data(), w.bytes().size());
+    }
+    log("the host never started the game within %llu s", ull(kStartWaitMs / 1000));
+    return false;
+}
+
+
+// The machine goes back to local play: every pad neutral, the pads the session plugged in unplugged (the window and the scripted pads take over again).
+void return_pads_to_local() {
+    for (int pad = 0; pad < kPadCount; ++pad) apply_pad_sample(pad, PadSample{});
+    for (int pad = 1; pad < kPadCount; ++pad) plug_pad(pad, false);
+}
+
+// The session is over for this machine; the game is not. One plain line says why (code = a launcher RefusalKind name), the links close, the pads go local
+// and the game is taken back to its title at the next frames (on_vblank).
+void end_session(const char *code, const std::string &reason, overlay::Ending why) {
+    log("session ended (%s): %s; this game goes on alone", code, reason.c_str());
+    g_joins.clear();
+    g_resync_queue.clear();
+    g_loaded_state.clear();
+    g_replay_screen = false;
+    g_session.reset();
+    g_links.clear();
+    g_joiner_peers.clear();
+    g_joiner_wanted.clear();
+    g_host.reset();
+    g_snapshot_wanted = false;
+    g_late = {};
+    g_state = State::ended;
+    g_title_pending = true;
+    return_pads_to_local();
+    overlay::loading_end();
+    overlay::stall_end();
+    overlay::session_ended(why, roster_name(kHostPort));
+}
+
+void end_lockstep(std::uint64_t frame) {
+    const Outcome outcome = g_session->outcome();
+    const bool guest = !g_config.host;
+    const std::string message = g_session->end_message();
+    g_session->finish(frame, "the session ended");
+    switch (outcome) {
+    case Outcome::desync: end_session(kCodeDesync, "the games went out of step", overlay::Ending::desync); break;
+    case Outcome::peer_left: end_session(kCodeHostLeft, "the host left the game", guest ? overlay::Ending::host_ended : overlay::Ending::player_lost); break;
+    case Outcome::timeout:
+        end_session(guest ? kCodeHostLeft : kCodePeerGone, guest ? "the host stopped answering" : "a player stopped answering", guest ? overlay::Ending::host_lost : overlay::Ending::player_lost);
+        break;
+    default: end_session(kCodePeerGone, message, overlay::Ending::player_lost); break;
+    }
+}
+
+// A joiner that never got into a session: the host's words decide the code.
+void end_join(const std::string &rejection, const char *otherwise) {
+    if (rejection.compare(0, 9, "different") == 0) end_session(kCodeBuild, "the host refused this build (" + rejection + ")", overlay::Ending::build);
+    else if (rejection.find("full") != std::string::npos) end_session(kCodeFull, "the host's game is full", overlay::Ending::full);
+    else end_session(otherwise, rejection.empty() ? std::string("the host could not be reached") : rejection, overlay::Ending::unreachable);
+}
+
+void take_title_return() {
+    switch (return_to_title()) {
+    case TitleReturn::waiting: return;
+    case TitleReturn::done: log("the game leaves its level for the title, as the pause menu's Quit does"); break;
+    case TitleReturn::not_needed: break;
+    }
+    g_title_pending = false;
+}
+
+// Cold start, host: one row per player, who has connected and who is still to come.
+void show_roster() {
+    std::vector<bool> taken(static_cast<std::size_t>(g_config.players), false);
+    taken[kHostPort] = true;
+    for (const std::uint8_t wanted : g_joiner_wanted)
+        if (wanted < taken.size()) taken[wanted] = true;
+    for (const std::uint8_t wanted : g_joiner_wanted)
+        if (wanted >= taken.size()) {
+            const auto open = std::find(taken.begin(), taken.end(), false);
+            if (open != taken.end()) *open = true;
+        }
+    std::vector<overlay::Row> rows;
+    for (int slot = 0; slot < g_config.players; ++slot) {
+        overlay::Row row;
+        row.name = player_name(slot);
+        const bool here = taken[static_cast<std::size_t>(slot)];
+        row.state = slot == kHostPort ? "HOST" : here ? "CONNECTED" : "WAITING TO JOIN";
+        row.percent = here ? 100 : 0;
+        rows.push_back(row);
+    }
+    overlay::set_rows(rows);
+}
+
+// Cold start, host: the machine is booted and has not run a frame; wait for every joiner, then start all machines together.
+void wait_for_roster() {
+    g_waiting_for_roster = true;
+    log("cold start: waiting for %d player(s) before the game starts", g_config.players - 1);
+    const std::uint64_t started = now_ms();
+    while (g_state == State::listening && !halted() && now_ms() - started < kRosterWaitMs) {
+        overlay::loading_joining(player_name(static_cast<int>(g_joiner_peers.size()) + 1));
+        show_roster();
+        poll_for_joiner(kRosterPollMs);
+        if (!g_snapshot_wanted) continue;
+        g_snapshot_wanted = false;
+        serve_snapshot(frame_count(), {});
+    }
+    g_waiting_for_roster = false;
+    overlay::loading_end();
+    overlay::set_rows({});
+    if (g_state == State::listening && !halted()) overlay::notice("NOT EVERYONE CONNECTED IN " + std::to_string(kRosterWaitMs / 1000) + " S", "THE GAME STARTS WITHOUT THEM. THEY CAN JOIN LATER");
+    if (g_state == State::listening && !halted()) log("not every player connected within %llu s: the game starts on its own and the others join it as it runs", ull(kRosterWaitMs / 1000));
+}
+
+}
+
+bool configure(const Config &config) {
+    g_config = config;
+    g_config.delay = std::clamp(config.delay, kMinDelay, kMaxDelay);
+    g_config.players = std::clamp(config.players, 2, kPadCount);
+    if (config.host) {
+        g_host = open_udp_host(config.address, config.port);
+        if (!g_host) return false;
+    } else {
+        std::unique_ptr<Transport> link = open_udp_joiner(config.address, config.port);
+        if (!link) return false;
+        g_links.push_back(degraded(std::move(link), 0x85EBCA6Bu));
+    }
+    if (config.sim.active())
+        log("simulated link: %.1f%% loss, %d ms delay + up to %d ms jitter on everything this machine sends", config.sim.loss_percent, config.sim.delay_ms, config.sim.jitter_ms);
+    g_enabled = true;
+    pin_game_timer();
+    g_fingerprint = config.build;
+    g_fingerprint.patches = hash_patches(g_options.patches);
+    if (config.host) {
+        g_state = State::listening;
+        g_terms.delay = g_config.delay;
+        g_terms.digest_every = config.digest_every;
+        g_terms.players = static_cast<std::uint8_t>(g_config.players);
+        g_terms.auto_join = config.cold_start ? 0 : 1;
+        if (const SessionInfo *info = session()) {
+            g_terms.friendly_fire = static_cast<std::uint8_t>(info->friendly_fire);
+            g_terms.split_screen = static_cast<std::uint8_t>(info->split_screen);
+        }
+        log("hosting %d players on %s:%u, build %016llx/%016llx/%016llx; %s", g_config.players, config.address.c_str(), config.port,
+            ull(g_fingerprint.game), ull(g_fingerprint.runtime), ull(g_fingerprint.patches),
+            config.cold_start ? "every machine starts from boot once all have joined" : "the game runs on until all have joined");
+    } else {
+        log("joining %s:%u, build %016llx/%016llx/%016llx", config.address.c_str(), config.port, ull(g_fingerprint.game), ull(g_fingerprint.runtime), ull(g_fingerprint.patches));
+    }
+    return true;
+}
+
+bool enabled() { return g_enabled && g_state != State::ended; }
+bool locked() { return g_state == State::lockstep; }
+int local_port() { return locked() && !g_config.host ? g_terms.slot : 0; }
+
+void start_cold() {
+    apply_host_switches(g_terms);
+    if (g_config.host && g_config.cold_start && g_state == State::listening) wait_for_roster();
+}
+
+bool join(std::vector<std::uint8_t> &machine_state) {
+    std::vector<std::uint8_t> packed;
+    std::string rejection;
+    const std::string host = player_name(kHostPort);
+    overlay::loading_receiving(host, 0);
+    status::set_stage(status::Stage::connecting);
+    bool receiving_shown = false;
+    const auto receiving = [&host, &receiving_shown](std::uint64_t done, std::uint64_t total) {
+        if (!receiving_shown) status::set_stage(status::Stage::receiving);
+        receiving_shown = true;
+        overlay::loading_receiving(host, total ? static_cast<int>(done * 100 / total) : 100);
+        status::set_counts(done, total, status::Unit::bytes);
+    };
+    const SessionInfo *info = session();
+    const std::uint8_t wanted = info && info->role == SessionRole::guest ? static_cast<std::uint8_t>(info->local_slot) : kAnySlot;
+    if (!download_snapshot(*g_links.front(), g_fingerprint, g_terms, packed, rejection, [] { return halted(); }, receiving, wanted)) {
+        overlay::loading_end();
+        if (!halted()) end_join(rejection, kCodeUnreachable);
+        return false;
+    }
+    if (g_terms.slot < 1 || g_terms.slot >= kPadCount || g_terms.players < 2 || g_terms.slot >= g_terms.players) {
+        log("the host assigned this machine an impossible place (pad %u of %u)", g_terms.slot + 1u, g_terms.players);
+        status::set_error(kCodeLoadFailed, "the host's game could not be joined: ask the host to start a new session");
+        end_session(kCodeUnreachable, "the host's session terms were not usable", overlay::Ending::unreachable);
+        return false;
+    }
+    if (g_terms.cold) {
+        machine_state.clear();
+        log("the host starts every machine from boot: no snapshot to load");
+        return true;
+    }
+    if (!decompress(packed.data(), packed.size(), g_terms.raw_bytes, machine_state)) {
+        log("the snapshot from the host is corrupt (it does not unpack to %u bytes)", g_terms.raw_bytes);
+        status::set_error(kCodeLoadFailed, "the host's game arrived damaged: try joining again");
+        end_session(kCodeUnreachable, "the snapshot from the host was damaged", overlay::Ending::unreachable);
+        return false;
+    }
+    log("snapshot unpacked: %.1f MB of machine state", machine_state.size() / kBytesPerMb);
+    return true;
+}
+
+bool joined() {
+    apply_host_switches(g_terms);
+    const Hashes ours = digest::memory_hashes();
+    const bool ok = ours == g_terms.hashes && frame_count() == g_terms.frame;
+    Writer w(kMsgReady);
+    w.u64(frame_count());
+    put_hashes(w, ours);
+    w.u8(ok ? 1 : 0);
+    for (int i = 0; i < kReadyRepeats; ++i) g_links.front()->send(w.bytes().data(), w.bytes().size());
+    if (!ok) {
+        log("snapshot loaded at frame %llu but memory does not match the host's (ee %016llx against %016llx, card %016llx against %016llx); cannot join", ull(frame_count()),
+            ull(ours.ee), ull(g_terms.hashes.ee), ull(ours.card), ull(g_terms.hashes.card));
+        end_session(kCodeDesync, "the game received from the host does not match the host's", overlay::Ending::desync);
+        return false;
+    }
+    log("%s at frame %llu: memory hashes match the host's (ee %016llx, card %016llx)", g_terms.cold ? "machine booted" : "snapshot loaded", ull(frame_count()), ull(ours.ee), ull(ours.card));
+    // The controllers are not part of the machine state: they are plugged as the host's were at this frame, before anything runs.
+    for (int pad = 1; pad < kPadCount; ++pad) plug_pad(pad, (g_terms.plugged >> pad) & 1);
+    for (int i = 0; i < 2; ++i) apply_pad_sample(kFirstBeyondSio2 + i, g_terms.pads[i]);
+    if (g_terms.late) {
+        overlay::loading_receiving(player_name(kHostPort), 100);
+        start_session(g_terms.slot);
+        return true;
+    }
+    if (!wait_for_start(*g_links.front())) {
+        end_session(kCodeUnreachable, "the host never started the game", overlay::Ending::unreachable);
+        return false;
+    }
+    start_session(g_terms.slot);
+    return true;
+}
+
+namespace {
+
+// Host: the joins being served take their turn (the session calls this between frames and while it waits for a peer). `over` is read at the next frame boundary.
+void serve_join() {
+    if (!g_session) return;
+    for (ServedJoin &join : g_joins) {
+        if (join.over) continue;
+        switch (join.job->tick()) {
+        case LateJoin::State::admitted:
+            if (std::unique_ptr<Transport> link = join.job->take_link()) g_links.push_back(std::move(link));
+            break;
+        case LateJoin::State::finished: join.over = true; break;
+        case LateJoin::State::failed: join.over = join.failed = true; break;
+        case LateJoin::State::working: break;
+        }
+    }
+}
+
+// The ports a join is working on, so that no second player is given the same one.
+std::uint8_t reserved_ports() {
+    std::uint8_t mask = 0;
+    for (const ServedJoin &join : g_joins) mask = static_cast<std::uint8_t>(mask | (1u << join.job->port()));
+    return mask;
+}
+
+// Host, at a frame boundary: ends the joins that are over, and asks for the snapshot for the next machine waiting for a fresh copy of the game.
+void settle_joins() {
+    for (auto it = g_joins.begin(); it != g_joins.end();) {
+        if (!it->over) {
+            ++it;
+            continue;
+        }
+        if (it->failed && it->job->resync()) g_session->give_up_resync(it->job->port());
+        log("pad %d: %s", it->job->port() + 1, it->failed ? "the join did not complete" : "the join is complete");
+        it = g_joins.erase(it);
+    }
+    for (int port : g_session->take_resyncs()) g_resync_queue.push_back(port);
+    if (g_late.port >= 0 || g_resync_queue.empty()) return;
+    g_late = {-1, g_resync_queue.front(), true};
+    g_resync_queue.erase(g_resync_queue.begin());
+    g_snapshot_wanted = true;
+    log("pad %d is out of step: taking a snapshot of the game at the next frame to bring it back", g_late.port + 1);
+}
+
+// Joiner whose game went out of step: fetches the host's copy while the host plays on, then hands it to the run loop to load.
+void fetch_fresh_copy() {
+    log("this machine's game went out of step: fetching a fresh copy from the host");
+    g_session.reset();
+    g_state = State::syncing;
+    std::vector<std::uint8_t> packed;
+    std::string rejection;
+    const std::string host = player_name(kHostPort);
+    overlay::loading_receiving(host, 0);
+    if (!download_snapshot(*g_links.front(), g_fingerprint, g_terms, packed, rejection, [] { return halted(); }, [&host](std::uint64_t done, std::uint64_t total) { overlay::loading_receiving(host, total ? static_cast<int>(done * 100 / total) : 100); })) {
+        overlay::loading_end();
+        if (!halted()) end_session(kCodeHostLeft, "the host did not send a fresh copy of the game", overlay::Ending::host_lost);
+        return;
+    }
+    if (!decompress(packed.data(), packed.size(), g_terms.raw_bytes, g_loaded_state)) {
+        end_session(kCodeUnreachable, "the fresh copy of the game from the host was damaged", overlay::Ending::unreachable);
+        return;
+    }
+    g_state = State::loading;
+}
+
+}
+
+bool on_vblank(std::uint64_t frame) {
+    board::tick();
+    if (g_state == State::off) {
+        apply_local_switches();
+        return false;
+    }
+    if (g_state == State::listening) {
+        apply_host_switches(g_terms);
+        poll_for_joiner(kHostPollMs);
+        return false;
+    }
+    if (g_state == State::ended) {
+        if (g_title_pending) take_title_return();
+        return false;
+    }
+    if (g_state == State::syncing || g_state == State::loading) return true;
+    if (g_state != State::lockstep) return false;
+    if (std::find(g_config.desync_test_frames.begin(), g_config.desync_test_frames.end(), frame) != g_config.desync_test_frames.end()) {
+        log("desync test: flipping a RAM byte on this machine at frame %llu", ull(frame));
+        st8(warriors::kUnusedRamByte, static_cast<std::uint8_t>(ld8(warriors::kUnusedRamByte) ^ 0xFF));
+    }
+    if (g_config.freeze_test_frame && frame == g_config.freeze_test_frame) {
+        log("freeze test: this machine stops answering for %u ms at frame %llu", g_config.freeze_test_ms, ull(frame));
+        std::this_thread::sleep_for(std::chrono::milliseconds(g_config.freeze_test_ms));
+    }
+    if (g_config.slow_test_frame && frame == g_config.slow_test_frame) {
+        log("slow test: this machine takes %u ms over frame %llu and keeps sending", g_config.slow_test_ms, ull(frame));
+        for (std::uint64_t until = now_ms() + g_config.slow_test_ms; now_ms() < until && !halted();) {
+            g_session->keep_alive();
+            std::this_thread::sleep_for(std::chrono::milliseconds(kSlowTestStepMs));
+        }
+    }
+    g_session->on_vblank(frame);
+    if (g_session->outcome() != Outcome::running) {
+        end_lockstep(frame);
+        return false;
+    }
+    if (g_session->resync_requested()) {
+        fetch_fresh_copy();
+        return true;
+    }
+    if (g_replay_screen && !g_session->catching_up()) {
+        g_replay_screen = false;
+        overlay::loading_end();
+    }
+    if (!g_config.host) return true;
+    serve_join();
+    settle_joins();
+    poll_for_late_joiner();
+    return true;
+}
+
+bool catching_up() { return g_state == State::lockstep && g_session && g_session->catching_up(); }
+
+bool state_ready() { return g_state == State::loading; }
+
+std::vector<std::uint8_t> take_state() {
+    g_state = State::lockstep;
+    return std::move(g_loaded_state);
+}
+
+bool snapshot_wanted() { return (g_state == State::listening || g_state == State::lockstep) && g_snapshot_wanted; }
+
+// The machine state packed on a thread, for every joiner of this snapshot.
+std::shared_future<std::vector<std::uint8_t>> pack_in_background(std::vector<std::uint8_t> machine_state) {
+    return std::async(std::launch::async, [state = std::move(machine_state)] { return compress(state.data(), state.size()); }).share();
+}
+
+// What every machine joining the running game at `frame` is told: the terms of the snapshot.
+Terms late_terms(std::uint64_t frame, std::size_t raw_bytes) {
+    g_terms.frame = frame;
+    g_terms.raw_bytes = static_cast<std::uint32_t>(raw_bytes);
+    g_terms.hashes = digest::memory_hashes();
+    g_terms.late = 1;
+    g_terms.cold = 0;
+    g_terms.delay = g_session->delay();
+    // The controllers are not in the machine state: the joiner gets them as they are on this machine right now (a pad plugged by --padN, by the launcher, or by the session),
+    // not as the session believes, or its pad ports answer differently from this machine's for the frames before it joins and the two games part (the "snapshot start desync").
+    g_terms.plugged = 0;
+    for (int pad = 1; pad < kPadCount; ++pad) {
+        PadSample sample;
+        if (read_pad_sample(pad, sample)) g_terms.plugged = static_cast<std::uint8_t>(g_terms.plugged | (1u << pad));
+    }
+    for (int i = 0; i < 2; ++i) read_pad_sample(kFirstBeyondSio2 + i, g_terms.pads[i]);
+    return g_terms;
+}
+
+// Host, in lockstep: the machine at `frame` goes to the player waiting for a free port, or to the machine being resynced. Nothing is sent from here: the join is
+// served between the frames that follow (LateJoin), so the game does not wait on it.
+void serve_late_snapshot(std::uint64_t frame, std::vector<std::uint8_t> machine_state) {
+    g_snapshot_wanted = false;
+    if (g_late.port < 0) return;
+    Terms terms = late_terms(frame, machine_state.size());
+    terms.slot = static_cast<std::uint8_t>(g_late.port);
+    std::unique_ptr<Transport> kept;
+    Transport *link = g_late.resync ? g_session->link_of(g_late.port) : nullptr;
+    if (!link) {
+        kept = degraded(g_host->open_link(g_late.peer), 0x85EBCA6Bu + static_cast<std::uint32_t>(g_late.port));
+        link = kept.get();
+    }
+    log("snapshot of frame %llu for pad %d, %.1f MB: it is packed and sent in the background and the game runs on", ull(frame), g_late.port + 1, machine_state.size() / kBytesPerMb);
+    g_joins.push_back({std::make_unique<LateJoin>(*g_session, std::move(kept), link, g_late.port, g_late.resync, terms, pack_in_background(std::move(machine_state)),
+                                                   g_config.snapshot_bytes_per_second)});
+    g_late = {};
+}
+
+// Host, the roster is full and the game has run alone so far: the game goes on at once and every connected player gets the snapshot at the same time, each as a late
+// joiner (so each shows its own real receive progress and none waits for another).
+void serve_first_joiners(std::uint64_t frame, std::vector<std::uint8_t> machine_state) {
+    order_joiners();
+    g_terms.frame = frame;   // the session's first frame is the one after the snapshot
+    start_session(kHostPort, true);
+    const Terms base = late_terms(frame, machine_state.size());
+    log("snapshot of frame %llu, %.1f MB: it is packed once and sent to %zu player(s) at the same time in the background; the game runs on", ull(frame), machine_state.size() / kBytesPerMb,
+        g_links.size());
+    const std::shared_future<std::vector<std::uint8_t>> packed = pack_in_background(std::move(machine_state));
+    for (std::size_t i = 0; i < g_links.size(); ++i) {
+        Terms terms = base;
+        terms.slot = static_cast<std::uint8_t>(i + 1);
+        g_joins.push_back({std::make_unique<LateJoin>(*g_session, nullptr, g_links[i].get(), static_cast<int>(i) + 1, false, terms, packed, g_config.snapshot_bytes_per_second)});
+    }
+}
+
+void serve_snapshot(std::uint64_t frame, std::vector<std::uint8_t> machine_state) {
+    if (g_state == State::lockstep) {
+        serve_late_snapshot(frame, std::move(machine_state));
+        return;
+    }
+    g_snapshot_wanted = false;
+    if (!machine_state.empty()) {
+        serve_first_joiners(frame, std::move(machine_state));
+        return;
+    }
+    order_joiners();
+    const std::uint64_t started = now_ms();
+    g_terms.frame = frame;
+    g_terms.raw_bytes = static_cast<std::uint32_t>(machine_state.size());
+    g_terms.hashes = digest::memory_hashes();
+    g_terms.cold = machine_state.empty() ? 1 : 0;
+    const std::vector<std::uint8_t> packed = g_terms.cold ? std::vector<std::uint8_t>{} : compress(machine_state.data(), machine_state.size());
+    if (g_terms.cold) log("start from boot at frame %llu: the game waits on this machine until %zu player(s) confirm their machines match", ull(frame), g_links.size());
+    else
+        log("snapshot of frame %llu: %.1f MB packed to %.1f MB in %llu ms; sending it to %zu player(s), the game waits on this machine until they have it", ull(frame),
+            machine_state.size() / kBytesPerMb, packed.size() / kBytesPerMb, ull(now_ms() - started), g_links.size());
+    for (std::size_t i = 0; i < g_links.size(); ++i) {
+        Terms terms = g_terms;
+        terms.slot = static_cast<std::uint8_t>(i + 1);
+        if (!send_and_wait(*g_links[i], terms, packed)) {
+            log("player %zu did not finish joining; waiting for players again", i + 2);
+            forget_joiners();
+            overlay::loading_end();
+            return;
+        }
+    }
+    overlay::loading_end();
+    for (const std::unique_ptr<Transport> &link : g_links) {
+        Writer w(kMsgStart);
+        w.u64(frame);
+        for (int i = 0; i < kStartRepeats; ++i) link->send(w.bytes().data(), w.bytes().size());
+    }
+    start_session(kHostPort);
+}
+
+void set_announcer(Announcer registered) { announcer() = std::move(registered); }
+
+void load_begin(const std::string &level, const std::string &mission) { board::load_begin(level, mission); }
+void load_end() { board::load_end(); }
+
+void report_lobby(int joined) {
+    if (status::current() != status::Stage::lobby) status::set_stage(status::Stage::lobby);
+    const SessionInfo *info = session();
+    status::set_counts(static_cast<std::uint64_t>(joined), static_cast<std::uint64_t>(info ? info->max_players : kPadCount), status::Unit::players);
+}
+
+void shutdown(std::uint64_t frame, const std::string &why) {
+    const bool crashed = std::none_of(std::begin(kCleanStops), std::end(kCleanStops), [&](const char *clean) { return why == clean; });
+    if (!crashed) status::close();
+    if (g_state == State::lockstep && g_session) g_session->finish(frame, why.c_str(), crashed);
+    else if (g_state == State::listening) log("closing at frame %llu (%s) without a full roster", ull(frame), why.c_str());
+    g_state = State::finished;
+}
+
+}
diff --git a/runtime/src/netplay/netplay.hpp b/runtime/src/netplay/netplay.hpp
new file mode 100644
index 0000000..765529f
--- /dev/null
+++ b/runtime/src/netplay/netplay.hpp
@@ -0,0 +1,86 @@
+#pragma once
+
+#include "fingerprint.hpp"
+#include "sim_transport.hpp"
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+// Online lockstep for 2 to 4 players: the public face of the netplay layer (see session.hpp for the protocol).
+// Host: runs the game on its own until the roster is full (one joiner for two players), then snapshots the machine,
+// sends it to every joiner and all run in lockstep.
+// Joiner: boots, downloads the host's snapshot, loads it, waits for the host's start and runs in lockstep as the pad the host assigned.
+namespace ps2::netplay {
+
+struct Config {
+    bool host = false;
+    std::string address;                  // joiner: the host's address; host: the address to bind (loopback keeps firewalls quiet)
+    std::uint16_t port = 0;
+    std::uint16_t delay = 3;
+    std::uint16_t digest_every = 30;
+    int players = 2;                      // host only: players in the session, host included (2 to ps2::kPadCount)
+    SimLink sim;
+    std::vector<std::uint64_t> desync_test_frames;   // test aid: flip a byte of this machine's RAM at each of these frames
+    bool adaptive_delay = true;           // host: the input delay follows the measured round trips (--net-delay is then where it starts)
+    std::uint32_t snapshot_bytes_per_second = 1500 * 1024;   // host: how fast a snapshot goes out to a player joining the running game
+    std::uint64_t freeze_test_frame = 0;  // test aid: this machine stops answering for freeze_test_ms at this frame
+    std::uint32_t freeze_test_ms = 0;
+    std::uint64_t slow_test_frame = 0;    // test aid: this machine takes slow_test_ms to produce its input at this frame but keeps sending its messages (alive, slow)
+    std::uint32_t slow_test_ms = 0;
+    bool cold_start = false;              // host only: no snapshot, every machine starts from boot once the roster is full (late joiners still get one)
+    Fingerprint build;                    // game and runtime hashes of this build (the patch hash is added here); a peer whose three differ is refused
+};
+
+// Opens the link. False (reason printed) when the socket cannot be set up.
+bool configure(const Config &config);
+
+// Netplay was asked for on the command line.
+bool enabled();
+// The lockstep session is running (so pads come from the session, not from local input).
+bool locked();
+// The pad port this machine plays on in the session (the host 0, a joiner the one the host assigned); 0 outside a session.
+int local_port();
+
+// A session never takes the game down with it. When it cannot start or ends (a different build, a desync, a player or the host gone) the machine goes back
+// to local play, one "[net] session ended (<code>): <reason>" line says why, and the game is taken back to its title through its own quit path.
+
+// Host with Config::cold_start, right after the machine booted and before it runs a frame: waits for every joiner, then starts all machines together.
+void start_cold();
+// Joiner, before the emulator runs: connects and downloads the host's machine state (empty when the host starts every machine from boot). False when
+// the join did not happen; the game then runs on its own.
+bool join(std::vector<std::uint8_t> &machine_state);
+// Joiner, right after that state was loaded (or the machine booted): checks it, tells the host and starts lockstep. False on mismatch; the game then runs on its own.
+bool joined();
+
+// Called at every vblank before pad input. Returns true when netplay applied the pads for this frame.
+bool on_vblank(std::uint64_t frame);
+
+// Host: a joiner is waiting, so the run loop should serialize the machine at the next loop top and call serve_snapshot.
+bool snapshot_wanted();
+void serve_snapshot(std::uint64_t frame, std::vector<std::uint8_t> machine_state);
+
+// Joiner: this machine is replaying the host's game to catch up (the window then runs it as fast as it can instead of in real time).
+bool catching_up();
+// Joiner whose game went out of step: a fresh copy of the host's machine has arrived and the run loop should load it (take_state) and then call joined().
+bool state_ready();
+std::vector<std::uint8_t> take_state();
+
+// The game may show a player's arrival or departure its own way (HUD message and cue). `event` is a LeftReason (kJoinedBack when the player is back); `name` is the
+// roster name. Returns true when the game showed it, otherwise the runtime puts a notice over the picture. Called from the vblank handler, at the same frame on every
+// machine, so a game that shows it in its own state stays in step.
+using Announcer = std::function<bool(int port, std::uint8_t event, const std::string &name)>;
+void set_announcer(Announcer announcer);
+
+// The game's own level-load screen began / ended. The disc sectors read in between, against the size this level's load had before, are this player's progress,
+// shown to every player of the session. Display only.
+void load_begin(const std::string &level, const std::string &mission);
+void load_end();
+// The in-game co-op lobby is up with `joined` of the session's players in it (the launcher's status line).
+void report_lobby(int joined);
+
+// End of run: says goodbye to the peer and prints the summary.
+void shutdown(std::uint64_t frame, const std::string &why);
+
+}
diff --git a/runtime/src/netplay/session.cpp b/runtime/src/netplay/session.cpp
new file mode 100644
index 0000000..ce72ad4
--- /dev/null
+++ b/runtime/src/netplay/session.cpp
@@ -0,0 +1,841 @@
+#include "session.hpp"
+
+#include "board.hpp"
+#include "log.hpp"
+#include "../overlay/overlay.hpp"
+#include "session_file.hpp"
+
+#include "ps2/disc.hpp"
+
+#include <algorithm>
+#include <chrono>
+
+namespace ps2::netplay {
+
+namespace {
+
+constexpr std::uint64_t kMaxSamples = 16;        // samples per port per message
+constexpr std::uint64_t kMinRedundant = 3;       // newest samples repeated even when acknowledged
+constexpr std::size_t kDigestsSent = 6;
+constexpr std::size_t kDigestsKept = 24;
+constexpr std::uint64_t kStallWarnMs = 200;
+constexpr std::uint64_t kStallRepeatMs = 5000;
+constexpr std::uint64_t kLongStallMs = 1000;      // a stall this long gets its own "peer is back" line
+constexpr std::uint64_t kEpisodeGapMs = 2000;     // stalls closer together than this belong to one slow spell
+constexpr std::uint64_t kSilentLimitMs = 6000;     // a peer that sends nothing at all for this long is dropped (a joiner) or ends the session (the host)
+constexpr std::uint64_t kSlowLimitMs = 20000;      // a peer that is alive (packets keep arriving) but still has not delivered its input after this long is dropped too
+constexpr std::uint64_t kHostRulingMs = 6000;      // a joiner waiting for a relayed pad gives the host this long beyond kSlowLimitMs to rule on it
+constexpr std::uint64_t kResendMs = 40;
+constexpr std::uint64_t kLingerMs = 1500;
+constexpr std::uint64_t kByeGraceMs = 1000;
+constexpr int kPollMs = 5;
+constexpr int kLingerPollMs = 20;
+constexpr int kByeRepeats = 3;
+constexpr std::uint64_t kJoinStartSpacing = 60;  // frames between the START presses of successive joiners
+constexpr std::uint64_t kJoinStartFrames = 6;
+constexpr std::uint64_t kJoinWatchFrames = 900;
+constexpr std::uint16_t kStartButton = 1u << 3;
+constexpr unsigned kSyncLogEvery = 10;
+constexpr std::uint64_t kRttSanityMs = 10000;
+constexpr std::uint64_t kStatusEveryMs = 500;      // between the load figures a machine sends
+constexpr std::uint64_t kBoardEveryMs = 200;       // between the player rows put on the screen
+constexpr std::uint32_t kBytesPerMb = 1024 * 1024;
+constexpr double kFrameMs = 1000.0 / 60.0;
+constexpr std::uint16_t kMinAdaptiveDelay = 2;
+constexpr std::uint16_t kMaxDelay = 30;               // 0.5 s; a message repeats 16 samples per pad, enough for a window of this size at any loss worth playing through
+constexpr std::uint16_t kDelayMarginFrames = 1;       // one frame for the peer to read what arrived
+constexpr double kDeviationWeight = 1.0;              // the round trip counted for the delay is the smoothed value plus this many mean deviations
+constexpr std::uint64_t kAdaptEveryMs = 1000;
+constexpr std::uint64_t kLowerHoldMs = 5000;          // a lower delay must have sufficed this long before it is taken
+constexpr std::uint32_t kAdaptMinSamples = 8;
+constexpr std::uint64_t kDelayLeadFrames = 60;        // a delay change starts this many frames after it is announced, time for every machine to hear
+constexpr double kRttGain = 0.125, kDeviationGain = 0.25, kFrameTimeGain = 0.05;
+constexpr std::uint64_t kResyncWaitMs = 10000;       // a joiner whose digests differ waits this long for the host to send it a fresh copy of the game
+
+std::uint32_t stamp_now() {
+    const std::uint32_t t = static_cast<std::uint32_t>(now_ms());
+    return t ? t : 1;
+}
+
+const char *differs(std::uint64_t a, std::uint64_t b) { return a == b ? "same" : "DIFFERENT"; }
+
+}
+
+Session::Session(std::vector<Transport *> links, const SessionSettings &settings, Hooks hooks) : cfg_(settings), hooks_(std::move(hooks)), delay_(settings.delay) {
+    for (std::size_t i = 0; i < links.size(); ++i) {
+        Peer peer;
+        peer.link = links[i];
+        peer.heard_at = now_ms();
+        peer.port = is_host() ? static_cast<int>(i) + 1 : 0;
+        peers_.push_back(std::move(peer));
+    }
+}
+
+void Session::begin(std::uint64_t first_frame) {
+    begin_ = first_frame;
+    first_input_ = local_first_ = first_frame + cfg_.delay;
+    newest_local_ = first_input_ - 1;
+    contig_.fill(first_input_ - 1);
+    for (Peer &peer : peers_) {
+        peer.ack.fill(first_input_ - 1);
+        peer.heard_at = now_ms();
+    }
+    for (int port = 1; port < cfg_.players; ++port) join_press_from_[static_cast<std::size_t>(port)] = begin_ + kJoinStartDelay + static_cast<std::uint64_t>(port - 1) * kJoinStartSpacing;
+    log("lockstep starts at frame %llu: you are pad %d of %d, input delay %u frames, digest every %u frames", ull(begin_), cfg_.local_port + 1, cfg_.players, cfg_.delay, cfg_.digest_every);
+}
+
+void Session::admit(Transport *link, int port, std::uint64_t join_frame) {
+    Peer peer;
+    peer.link = link;
+    peer.port = port;
+    peer.ack.fill(join_frame - 1);
+    peer.heard_at = now_ms();
+    peers_.push_back(std::move(peer));
+    const std::size_t p = static_cast<std::size_t>(port);
+    const std::uint64_t counts_from = join_frame + delay_;
+    const bool resync = absent_[p].reason == kLeftResync;
+    absent_[p].until = counts_from;
+    contig_[p] = counts_from - 1;
+    join_press_from_[p] = counts_from + kJoinStartDelay;
+    join_press_logged_[p] = join_done_logged_[p] = false;
+    if (resync) resynced_at_[p] = join_frame;
+    log("pad %d %s the running game at frame %llu: its input counts from frame %llu on every machine", port + 1, resync ? "is back in" : "joins", ull(join_frame), ull(counts_from));
+}
+
+void Session::hold_ports_open() {
+    for (int port = 1; port < cfg_.players; ++port) absent_[static_cast<std::size_t>(port)] = {begin_, kNever, kLeftSaid, begin_};
+}
+
+void Session::start_recording(std::uint64_t first_frame) {
+    if (recordings_++ == 0) history_.start(first_frame);
+}
+
+void Session::stop_recording() {
+    if (recordings_ > 0 && --recordings_ == 0) history_.stop();
+}
+
+int Session::free_port(int wanted, std::uint8_t taken) const {
+    const auto free = [&](int port) {
+        const Absence &a = absent_[static_cast<std::size_t>(port)];
+        return a.from != kNever && a.until == kNever && a.reason != kLeftResync && !((taken >> port) & 1);
+    };
+    if (wanted >= 1 && wanted < cfg_.players && free(wanted)) return wanted;
+    for (int port = 1; port < cfg_.players; ++port)
+        if (free(port)) return port;
+    return -1;
+}
+
+std::uint8_t Session::plugged_mask() const {
+    std::uint8_t mask = 0;
+    for (int port = 1; port < cfg_.players; ++port) mask = static_cast<std::uint8_t>(mask | (plugged_[static_cast<std::size_t>(port)] ? 1u << port : 0u));
+    return mask;
+}
+
+bool Session::absent(int port, std::uint64_t frame) const {
+    const Absence &a = absent_[static_cast<std::size_t>(port)];
+    return a.from != kNever && frame >= a.from && (a.until == kNever || frame < a.until);
+}
+
+bool Session::unplugged(int port, std::uint64_t frame) const { return absent(port, frame) && frame >= absent_[static_cast<std::size_t>(port)].unplug_from; }
+
+bool Session::have(int port, std::uint64_t frame) const {
+    if (frame < first_input_ || absent(port, frame)) return true;
+    return ring_[static_cast<std::size_t>(port)][frame % kRing].frame == frame;
+}
+
+// Every frame of the port up to contig_ has arrived or needs no input.
+void Session::advance_contig(int port) {
+    const std::size_t p = static_cast<std::size_t>(port);
+    if (absent_[p].until != kNever && contig_[p] + 1 >= absent_[p].from && contig_[p] < absent_[p].until - 1) contig_[p] = absent_[p].until - 1;
+    while (!absent(port, contig_[p] + 1) && ring_[p][(contig_[p] + 1) % kRing].frame == contig_[p] + 1) ++contig_[p];
+}
+
+bool Session::have_all(std::uint64_t frame) const {
+    for (int port = 0; port < cfg_.players; ++port)
+        if (port != cfg_.local_port && !have(port, frame)) return false;
+    return true;
+}
+
+const PadSample &Session::input(int port, std::uint64_t frame) const {
+    static const PadSample neutral;
+    return frame < first_input_ || absent(port, frame) ? neutral : ring_[static_cast<std::size_t>(port)][frame % kRing].sample;
+}
+
+void Session::store(int port, std::uint64_t frame, const PadSample &sample) {
+    ring_[static_cast<std::size_t>(port)][frame % kRing] = {frame, sample};
+}
+
+std::uint64_t Session::known_through(int port) const { return port == cfg_.local_port ? newest_local_ : contig_[static_cast<std::size_t>(port)]; }
+
+// The host passes every port on except the recipient's own; a joiner only has its own to give.
+bool Session::sends_port(const Peer &peer, int port) const { return is_host() ? port != peer.port : port == cfg_.local_port; }
+
+// The host takes from each joiner that joiner's port; a joiner takes every other port from the host.
+bool Session::accepts_port(const Peer &peer, int port) const {
+    if (port < 0 || port >= cfg_.players) return false;
+    return is_host() ? port == peer.port : port != cfg_.local_port;
+}
+
+void Session::send_input(Peer &peer) {
+    const std::uint64_t now = now_ms();
+    Writer w(kMsgInput);
+    w.u32(stamp_now());
+    w.u32(peer.last_stamp);
+    w.u16(static_cast<std::uint16_t>(peer.last_stamp ? std::min<std::uint64_t>(now - peer.last_stamp_at, 0xFFFF) : 0));
+    std::uint8_t acks = 0;
+    for (int port = 0; port < cfg_.players; ++port) acks += port != cfg_.local_port;
+    w.u8(acks);
+    for (int port = 0; port < cfg_.players; ++port)
+        if (port != cfg_.local_port) w.u8(static_cast<std::uint8_t>(port)).u64(contig_[static_cast<std::size_t>(port)]);
+    std::uint8_t blocks = 0;
+    for (int port = 0; port < cfg_.players; ++port) blocks += sends_port(peer, port);
+    w.u8(blocks);
+    for (int port = 0; port < cfg_.players; ++port) {
+        if (!sends_port(peer, port)) continue;
+        const std::uint64_t newest = known_through(port);
+        std::uint64_t from = std::max(peer.ack[static_cast<std::size_t>(port)] + 1, newest + 1 > kMaxSamples ? newest + 1 - kMaxSamples : 0);
+        if (newest + 1 > kMinRedundant) from = std::min(from, newest + 1 - kMinRedundant);
+        const std::uint64_t first = port == cfg_.local_port ? local_first_ : first_input_;
+        from = std::max(from, first);
+        const std::uint64_t count = newest >= first ? newest - from + 1 : 0;
+        w.u8(static_cast<std::uint8_t>(port)).u64(newest).u8(static_cast<std::uint8_t>(count));
+        for (std::uint64_t f = from; f < from + count; ++f) put_sample(w, ring_[static_cast<std::size_t>(port)][f % kRing].sample);
+        if (count > 1) stats_.resent_samples += count - 1;
+    }
+    const std::size_t digests = std::min(kDigestsSent, local_digests_.size());
+    w.u8(static_cast<std::uint8_t>(digests));
+    for (std::size_t i = local_digests_.size() - digests; i < local_digests_.size(); ++i) {
+        w.u64(local_digests_[i].frame);
+        put_hashes(w, local_digests_[i].hashes);
+    }
+    std::uint8_t absences = 0;
+    for (int port = 0; port < cfg_.players; ++port) absences += is_host() && has_ever_been_absent(port);
+    w.u8(absences);
+    for (int port = 0; port < cfg_.players; ++port) {
+        if (!is_host() || !has_ever_been_absent(port)) continue;
+        const Absence &a = absent_[static_cast<std::size_t>(port)];
+        w.u8(static_cast<std::uint8_t>(port)).u64(a.from).u64(a.until).u8(a.reason).u64(a.unplug_from);
+    }
+    w.u16(announced_.seq).u64(announced_.from).u16(announced_.value);
+    peer.link->send(w.bytes().data(), w.bytes().size());
+    ++stats_.sent;
+}
+
+void Session::send_all() {
+    for (Peer &peer : peers_)
+        if (active(peer)) send_input(peer);
+}
+
+void Session::send_bye(std::uint8_t reason, std::uint64_t frame) {
+    Writer w(kMsgBye);
+    w.u8(reason).u64(frame).u64(newest_local_);
+    for (Peer &peer : peers_)
+        if (active(peer))
+            for (int i = 0; i < kByeRepeats; ++i) peer.link->send(w.bytes().data(), w.bytes().size());
+}
+
+void Session::send_status() {
+    status_sent_ = now_ms();
+    Writer w(kMsgStatus);
+    board::put(w, is_host());
+    for (Peer &peer : peers_)
+        if (active(peer)) peer.link->send(w.bytes().data(), w.bytes().size());
+}
+
+// The player rows for the screen: how far each player's level load has got, who has left, and (in a stall) who is not answering.
+void Session::report_board(std::uint64_t frame, bool stalled) {
+    const std::uint64_t now = now_ms();
+    if (board::take_local_change() || now - status_sent_ >= kStatusEveryMs) send_status();
+    if (now - board_shown_ < kBoardEveryMs) return;
+    board_shown_ = now;
+    bool any_loading = false;
+    for (int port = 0; port < cfg_.players; ++port) any_loading = any_loading || (board::known(port) && board::entry(port).loading && !absent(port, frame));
+    std::vector<overlay::Row> rows;
+    for (int port = 0; port < cfg_.players; ++port) {
+        overlay::Row row;
+        row.name = player_name(port);
+        const board::Entry e = board::entry(port);
+        if (absent(port, frame)) {
+            row.state = "LEFT";
+            row.alert = true;
+        } else if (stalled && port != cfg_.local_port && !have(port, frame)) {
+            row.state = "NOT RESPONDING";
+            row.alert = true;
+        } else if (e.known && e.loading) {
+            row.percent = board::percent(e);
+            row.state = row.percent >= 0 ? "LOADING " + std::to_string(row.percent) + "%" : "LOADING " + std::to_string(e.read * disc::kSector / kBytesPerMb) + " MB";
+        } else if (any_loading) {
+            row.state = "LOADED";
+            row.percent = 100;
+        }
+        rows.push_back(row);
+    }
+    overlay::set_rows(rows);
+    overlay::level_loading(any_loading);
+}
+
+void Session::drain(Peer &peer, int timeout_ms) {
+    std::uint8_t buffer[kMaxMessage];
+    int n = peer.link->recv(buffer, sizeof buffer, timeout_ms);
+    while (n != 0) {
+        if (n < 0) {
+            fail(Outcome::link_broken, "the connection to the peer broke: " + peer.link->peer_name());
+            return;
+        }
+        ++stats_.received;
+        peer.heard_at = now_ms();
+        handle(peer, buffer, static_cast<std::size_t>(n));
+        if (peer.gone || resync_requested_) return;
+        n = peer.link->recv(buffer, sizeof buffer, 0);
+    }
+}
+
+void Session::pump(int timeout_ms) {
+    if (hooks_.service && outcome_ == Outcome::running) hooks_.service();
+    int listening = 0;
+    for (Peer &peer : peers_) {
+        if (!active(peer)) continue;
+        ++listening;
+        drain(peer, 0);
+        if (outcome_ != Outcome::running) return;
+    }
+    if (timeout_ms > 0 && !relay_due_ && listening) {
+        const int slice = std::max(1, timeout_ms / listening);
+        for (Peer &peer : peers_) {
+            if (!active(peer)) continue;
+            drain(peer, slice);
+            if (outcome_ != Outcome::running) return;
+        }
+    }
+    if (relay_due_) {
+        relay_due_ = false;
+        send_all();
+    }
+}
+
+void Session::handle(Peer &peer, const std::uint8_t *data, std::size_t size) {
+    Reader r(data, size);
+    if (r.type() == kMsgInput) {
+        on_input(peer, r);
+    } else if (r.type() == kMsgStatus) {
+        board::take(r, peer.port, !is_host());
+    } else if (r.type() == kMsgHistory) {
+        on_history(peer, r);
+    } else if (r.type() == kMsgHistoryAck) {
+        HistoryAck ack;
+        if (is_host() && read_history_ack(r, ack)) peer.history_ack = ack;
+    } else if (r.type() == kMsgSnapBegin && !is_host() && !catching_up_) {
+        const std::uint64_t snapshot_frame = r.u64();
+        if (r.ok() && snapshot_frame + kResyncFrameSlack >= current_frame_ && !resync_requested_) {
+            log("the host is sending this machine a fresh copy of the game: it was out of step");
+            resync_requested_ = true;
+        }
+    } else if (r.type() == kMsgBye) {
+        const std::uint8_t reason = r.u8();
+        const std::uint64_t frame = r.u64(), newest = r.u64();
+        if (!r.ok() || peer.bye) return;
+        peer.bye = true;
+        peer.bye_at = now_ms();
+        peer.bye_frame = frame;
+        peer.bye_newest = newest;
+        peer.bye_reason = reason;
+        if (reason == kByeDesync) {
+            log("pad %d reports a DESYNC at its frame %llu and stopped", peer.port + 1, ull(frame));
+            fail(Outcome::desync, "the peer found the games out of step");
+        } else if (reason == kByeNormal) {
+            log("pad %d left the game at its frame %llu", peer.port + 1, ull(frame));
+        } else {
+            log("pad %d stopped with an error at its frame %llu", peer.port + 1, ull(frame));
+        }
+    }
+}
+
+void Session::on_input(Peer &peer, Reader &r) {
+    const std::uint32_t stamp = r.u32(), echo = r.u32();
+    const std::uint16_t hold = r.u16();
+    const std::uint8_t ack_count = r.u8();
+    if (!r.ok() || ack_count > kPadCount) return;
+    std::array<std::uint64_t, kPadCount> acks{};
+    std::array<bool, kPadCount> acked{};
+    for (std::uint8_t i = 0; i < ack_count; ++i) {
+        const std::uint8_t port = r.u8();
+        const std::uint64_t contig = r.u64();
+        if (port < kPadCount) {
+            acks[port] = contig;
+            acked[port] = true;
+        }
+    }
+    const std::uint64_t now = now_ms();
+    peer.last_stamp = stamp;
+    peer.last_stamp_at = now;
+    if (echo) {
+        const std::uint64_t rtt = static_cast<std::uint32_t>(stamp_now() - echo - hold);
+        if (rtt < kRttSanityMs) {
+            note_round_trip(peer, rtt);
+            ++stats_.rtt_count;
+            stats_.rtt_sum += rtt;
+            stats_.rtt_min = std::min(stats_.rtt_min, rtt);
+            stats_.rtt_max = std::max(stats_.rtt_max, rtt);
+        }
+    }
+    const std::uint8_t blocks = r.u8();
+    if (!r.ok() || blocks > kPadCount) return;
+    for (std::uint8_t b = 0; b < blocks; ++b) {
+        const std::uint8_t port = r.u8();
+        const std::uint64_t newest = r.u64();
+        const std::uint8_t count = r.u8();
+        if (!r.ok() || count > kMaxSamples) return;
+        const bool wanted = accepts_port(peer, port);
+        bool added = false;
+        for (std::uint8_t i = 0; i < count; ++i) {
+            const PadSample s = get_sample(r);
+            const std::uint64_t frame = newest - (count - 1u) + i;
+            if (!r.ok()) return;
+            if (!wanted || frame < first_input_ || frame <= contig_[port] || have(port, frame)) continue;
+            store(port, frame, s);
+            added = true;
+        }
+        if (!wanted) continue;
+        advance_contig(port);
+        if (added && is_host()) relay_due_ = true;
+    }
+    for (int port = 0; port < kPadCount; ++port)
+        if (acked[static_cast<std::size_t>(port)]) peer.ack[static_cast<std::size_t>(port)] = std::max(peer.ack[static_cast<std::size_t>(port)], acks[static_cast<std::size_t>(port)]);
+    const std::uint8_t digests = r.u8();
+    for (std::uint8_t i = 0; i < digests; ++i) {
+        const std::uint64_t frame = r.u64();
+        const Hashes h = get_hashes(r);
+        if (!r.ok()) return;
+        const bool known = std::any_of(peer.remote_digests.begin(), peer.remote_digests.end(), [&](const DigestRecord &d) { return d.frame == frame; });
+        if (known || frame <= peer.checked_through) continue;
+        peer.remote_digests.push_back({frame, h});
+        if (peer.remote_digests.size() > kDigestsKept) peer.remote_digests.pop_front();
+        check_digest(peer, frame);
+    }
+    const std::uint8_t absences = r.u8();
+    for (std::uint8_t i = 0; i < absences; ++i) {
+        const std::uint8_t port = r.u8();
+        const std::uint64_t from = r.u64(), until = r.u64();
+        const std::uint8_t reason = r.u8();
+        const std::uint64_t unplug_from = r.u64();
+        if (!r.ok() || port >= cfg_.players || is_host()) continue;
+        Absence &known = absent_[port];
+        if (known.from == from && known.until == until && known.reason == reason && known.unplug_from == unplug_from) continue;
+        known = {from, until, reason, unplug_from};
+        advance_contig(port);
+        if (until == kNever) log("pad %d is out from frame %llu", port + 1, ull(from));
+        else log("pad %d is out until frame %llu, where it joins", port + 1, ull(until));
+        if (until != kNever) {
+            join_press_from_[port] = until + kJoinStartDelay;
+            join_press_logged_[port] = join_done_logged_[port] = false;
+        }
+    }
+    const std::uint16_t seq = r.u16();
+    const std::uint64_t from = r.u64();
+    const std::uint16_t value = r.u16();
+    if (r.ok() && !is_host() && static_cast<std::int16_t>(seq - announced_.seq) > 0) {
+        announced_ = pending_delay_ = {seq, from, value};
+        log("the host changes the input delay to %u frames from frame %llu", value, ull(from));
+    }
+}
+
+void Session::take_digest(std::uint64_t frame) {
+    const std::uint64_t started = now_ms();
+    digest_now_ = hooks_.hashes();
+    digest_taken_ = true;
+    local_digests_.push_back({frame, digest_now_});
+    stats_.digest_ms += now_ms() - started;
+    ++stats_.digests_taken;
+    if (local_digests_.size() > kDigestsKept) local_digests_.pop_front();
+    for (Peer &peer : peers_) {
+        if (!active(peer)) continue;
+        check_digest(peer, frame);
+        if (outcome_ != Outcome::running) return;
+    }
+}
+
+void Session::check_digest(Peer &peer, std::uint64_t frame) {
+    const auto find = [&](const std::deque<DigestRecord> &list) {
+        return std::find_if(list.begin(), list.end(), [&](const DigestRecord &d) { return d.frame == frame; });
+    };
+    const auto local = find(local_digests_), remote = find(peer.remote_digests);
+    if (local == local_digests_.end() || remote == peer.remote_digests.end() || frame <= peer.checked_through) return;
+    peer.checked_through = frame;
+    ++stats_.digests_checked;
+    if (local->hashes == remote->hashes) {
+        if (stats_.digests_checked == 1 || stats_.digests_checked % kSyncLogEvery == 0)
+            log("in sync at frame %llu (ee=%016llx, %llu digests compared, none differ)", ull(frame), ull(local->hashes.ee), ull(stats_.digests_checked));
+        return;
+    }
+    log("DESYNC at frame %llu against pad %d: the two machines no longer hold the same game", ull(frame), peer.port + 1);
+    log("  EE RAM   local %016llx remote %016llx (%s)", ull(local->hashes.ee), ull(remote->hashes.ee), differs(local->hashes.ee, remote->hashes.ee));
+    log("  scratch  local %016llx remote %016llx (%s)", ull(local->hashes.spr), ull(remote->hashes.spr), differs(local->hashes.spr, remote->hashes.spr));
+    log("  IOP RAM  local %016llx remote %016llx (%s)", ull(local->hashes.iop), ull(remote->hashes.iop), differs(local->hashes.iop, remote->hashes.iop));
+    log("  card     local %016llx remote %016llx (%s)", ull(local->hashes.card), ull(remote->hashes.card), differs(local->hashes.card, remote->hashes.card));
+    log("  extra    local %016llx remote %016llx (%s)", ull(local->hashes.extra), ull(remote->hashes.extra), differs(local->hashes.extra, remote->hashes.extra));
+    on_mismatch(peer, frame);
+}
+
+// The host brings a machine whose game differs back from its own snapshot, without stopping anyone else; a machine that differs again soon after ends the session.
+// A joiner can only wait for the host to do that.
+void Session::on_mismatch(Peer &peer, std::uint64_t frame) {
+    if (!is_host()) {
+        if (!suspect_at_) suspect_at_ = now_ms();
+        log("waiting for the host to send this machine a fresh copy of the game");
+        return;
+    }
+    if (begin_resync(peer.port)) return;
+    send_bye(kByeDesync, frame);
+    fail(Outcome::desync, "memory digests differ at frame " + std::to_string(frame));
+}
+
+void Session::fail(Outcome outcome, const std::string &message) {
+    if (outcome_ != Outcome::running) return;
+    outcome_ = outcome;
+    end_message_ = message;
+    log("stopping: %s", message.c_str());
+}
+
+std::string Session::late_ports(std::uint64_t frame) const {
+    std::string text;
+    for (int port = 0; port < cfg_.players; ++port)
+        if (port != cfg_.local_port && !have(port, frame)) text += (text.empty() ? "pad " : ", pad ") + std::to_string(port + 1);
+    return text;
+}
+
+std::string Session::late_names(std::uint64_t frame) const {
+    std::string text;
+    for (int port = 0; port < cfg_.players; ++port)
+        if (port != cfg_.local_port && !have(port, frame)) text += (text.empty() ? "" : " AND ") + player_name(port);
+    return text;
+}
+
+// A joiner's port goes absent from `from_frame` on, the same frame on every machine: the host decides and tells the others.
+void Session::leave(Peer &peer, std::uint64_t from_frame, std::uint8_t reason) {
+    Absence &a = absent_[static_cast<std::size_t>(peer.port)];
+    a = {from_frame, kNever, reason, from_frame};
+    peer.gone = true;
+    advance_contig(peer.port);
+    log("pad %d is out from frame %llu on every machine; the game goes on without it", peer.port + 1, ull(from_frame));
+}
+
+// Host: a joiner that said goodbye is out from the first frame it sent no input for (its last frame plus the input delay, plus one), once all
+// the input it did send has arrived, or from the first frame still missing when it has not arrived after the grace period.
+void Session::finalize_leaves() {
+    if (!is_host()) return;
+    const std::uint64_t now = now_ms();
+    for (Peer &peer : peers_) {
+        if (!active(peer) || !peer.bye || peer.bye_reason == kByeDesync) continue;
+        const std::uint64_t first_without_input = peer.bye_newest + 1;
+        const std::size_t p = static_cast<std::size_t>(peer.port);
+        const std::uint8_t reason = peer.bye_reason == kByeNormal ? kLeftSaid : kLeftCrashed;
+        if (peer.bye_reason == kByeNormal && contig_[p] + 1 >= first_without_input) leave(peer, first_without_input, reason);
+        else if (now - peer.bye_at > kByeGraceMs) leave(peer, contig_[p] + 1, reason);
+    }
+}
+
+// What the game is told about each port: unplugged while absent. Called with the frame about to be applied.
+void Session::update_plugs(std::uint64_t frame) {
+    for (int port = 1; port < cfg_.players; ++port) {
+        const std::size_t p = static_cast<std::size_t>(port);
+        const bool plugged = !unplugged(port, frame);
+        if (frame != begin_ && plugged == plugged_[p]) continue;
+        plugged_[p] = plugged;
+        hooks_.plug(port, plugged);
+        log("frame %llu: pad %d %s on every machine", ull(frame), port + 1, plugged ? "plugged in" : "unplugged");
+        if (frame != begin_ && port != cfg_.local_port && hooks_.announce) hooks_.announce(port, plugged ? static_cast<std::uint8_t>(kJoinedBack) : absent_[p].reason);
+    }
+}
+
+// A peer that said goodbye and whose input is still missing after the grace period; only a joiner waiting on the host can be held up this way.
+Session::Peer *Session::departed_peer_holding_up(std::uint64_t frame) {
+    const std::uint64_t now = now_ms();
+    for (Peer &peer : peers_) {
+        if (is_host() || !peer.bye || now - peer.bye_at <= kByeGraceMs) continue;
+        if (!have(peer.port, frame)) return &peer;
+    }
+    return nullptr;
+}
+
+// How long nothing at all has arrived from the peer.
+std::uint64_t Session::silent_for(const Peer &peer) const {
+    const std::uint64_t now = now_ms();
+    return peer.heard_at >= now ? 0 : now - peer.heard_at;
+}
+
+// Host: a joiner whose input for `frame` is still missing is taken to have gone when nothing has come from it for kSilentLimitMs, or when it has answered all along and still
+// not delivered after waited >= kSlowLimitMs (a loaded PC gets that long); it is out from the first frame it has no input for.
+bool Session::drop_late_joiners(std::uint64_t frame, std::uint64_t waited) {
+    bool dropped = false;
+    for (Peer &peer : peers_) {
+        if (!active(peer) || have(peer.port, frame)) continue;
+        const bool silent = silent_for(peer) >= kSilentLimitMs;
+        if (!silent && waited < kSlowLimitMs) continue;
+        log(silent ? "nothing from pad %d for %llu s: taking it to be gone" : "pad %d answers but has not delivered its input for %llu s: taking it to be gone", peer.port + 1,
+            ull((silent ? kSilentLimitMs : kSlowLimitMs) / 1000));
+        leave(peer, contig_[static_cast<std::size_t>(peer.port)] + 1, kLeftLost);
+        dropped = true;
+    }
+    return dropped;
+}
+
+void Session::wait_for_peers(std::uint64_t frame) {
+    if (have_all(frame)) return;
+    std::uint64_t started = now_ms();
+    std::uint64_t last_send = started, last_report = started;
+    bool warned = false;
+    struct StallScreen {
+        ~StallScreen() { overlay::stall_end(); }
+    } stall_screen;
+    while (!have_all(frame)) {
+        if (outcome_ != Outcome::running || hooks_.halted() || resync_requested_) return;
+        pump(kPollMs);
+        if (outcome_ != Outcome::running || resync_requested_) return;
+        finalize_leaves();
+        if (have_all(frame)) break;
+        const std::uint64_t now = now_ms(), waited = now - started;
+        if (Peer *gone = departed_peer_holding_up(frame); gone && !have_all(frame)) {
+            fail(Outcome::peer_left, "pad " + std::to_string(gone->port + 1) + " left at its frame " + std::to_string(gone->bye_frame) + " and has no input for frame " + std::to_string(frame));
+            return;
+        }
+        if (now - last_send >= kResendMs) {
+            send_all();
+            last_send = now;
+        }
+        report_board(frame, true);
+        if (waited >= overlay::kStallShownMs) overlay::stall(late_names(frame), static_cast<std::uint32_t>(waited), static_cast<std::uint32_t>(kSlowLimitMs / 1000));
+        if (!warned && waited >= kStallWarnMs) {
+            warned = true;
+            if (!episode_.stalls)
+                log("peer stalled: frame %llu is waiting for the input of %s (we have sent up to frame %llu)", ull(frame), late_ports(frame).c_str(), ull(newest_local_));
+            if (!episode_.stalls) episode_.first_frame = frame;
+            last_report = now;
+        } else if (warned && now - last_report >= kStallRepeatMs) {
+            log("peer still stalled after %llu s at frame %llu (waiting for %s)", ull(waited / 1000), ull(frame), late_ports(frame).c_str());
+            last_report = now;
+        }
+        if (is_host() && drop_late_joiners(frame, waited)) {
+            ++stats_.stalls;
+            stats_.stall_ms += waited;
+            stats_.longest_stall_ms = std::max(stats_.longest_stall_ms, waited);
+            started = now_ms();
+            last_report = started;
+            warned = false;
+            continue;
+        }
+        // A joiner has one peer, the host: it ends the session when the host goes silent, and gives the host kHostRulingMs beyond kSlowLimitMs to rule on a pad it relays.
+        if (!is_host() && (silent_for(peers_.front()) >= kSilentLimitMs || waited >= kSlowLimitMs + kHostRulingMs)) {
+            ++stats_.stalls;
+            stats_.stall_ms += waited;
+            stats_.longest_stall_ms = std::max(stats_.longest_stall_ms, waited);
+            send_bye(kByeError, frame);
+            fail(Outcome::timeout, "no input from " + late_ports(frame) + " for " + std::to_string(waited / 1000) + " s at frame " + std::to_string(frame) + ", assuming it is gone");
+            return;
+        }
+    }
+    const std::uint64_t waited = now_ms() - started;
+    stats_.stall_ms += waited;
+    stats_.longest_stall_ms = std::max(stats_.longest_stall_ms, waited);
+    if (!warned) return;
+    ++stats_.stalls;
+    ++episode_.stalls;
+    episode_.ms += waited;
+    episode_.longest = std::max(episode_.longest, waited);
+    episode_.ended_at = now_ms();
+    if (waited >= kLongStallMs) log("peer is back after %llu ms, frame %llu continues", ull(waited), ull(frame));
+}
+
+void Session::flush_episode() {
+    if (!episode_.stalls) return;
+    log("slow spell from frame %llu: %llu stalls, %llu ms waiting for the peer in total, longest %llu ms", ull(episode_.first_frame), ull(episode_.stalls), ull(episode_.ms),
+        ull(episode_.longest));
+    episode_ = {};
+}
+
+void Session::apply_frame(std::uint64_t frame) {
+    update_plugs(frame);
+    std::array<PadSample, kPadCount> pads;
+    for (int port = 0; port < cfg_.players; ++port) pads[static_cast<std::size_t>(port)] = input(port, frame);
+    for (int port = 1; port < cfg_.players && cfg_.press_start_to_join; ++port) {
+        const std::size_t p = static_cast<std::size_t>(port);
+        const std::uint64_t press_from = join_press_from_[p];
+        if (absent(port, frame)) continue;
+        if (frame >= press_from && frame < press_from + kJoinStartFrames && hooks_.player_missing(port)) {
+            pads[p].buttons |= kStartButton;
+            if (!join_press_logged_[p]) {
+                join_press_logged_[p] = true;
+                log("frame %llu: pressing START on pad %d on every machine so player %d joins", ull(frame), port + 1, port + 1);
+            }
+        }
+        if (join_press_logged_[p] && !join_done_logged_[p] && frame >= press_from + kJoinStartFrames) {
+            if (!hooks_.player_missing(port)) {
+                join_done_logged_[p] = true;
+                log("frame %llu: player %d is in the game", ull(frame), port + 1);
+            } else if (frame > press_from + kJoinWatchFrames) {
+                join_done_logged_[p] = true;
+                log("frame %llu: player %d has not joined; the game may not allow it here", ull(frame), port + 1);
+            }
+        }
+    }
+    for (int port = 0; port < cfg_.players; ++port) hooks_.apply(port, pads[static_cast<std::size_t>(port)]);
+    if (history_.recording() && !history_.full()) {
+        FrameRecord record;
+        record.pads = pads;
+        for (int port = 1; port < cfg_.players; ++port) record.plugged = static_cast<std::uint8_t>(record.plugged | (plugged_[static_cast<std::size_t>(port)] ? 1u << port : 0u));
+        record.has_digest = digest_taken_;
+        record.digest = digest_now_;
+        history_.add(record);
+    }
+    digest_taken_ = false;
+}
+
+// The samples of this machine's pad up to the frame the delay puts them at. A longer delay leaves frames nobody sampled: they get the pad as it reads now.
+void Session::sample_local(std::uint64_t frame) {
+    const std::uint64_t target = frame + delay_;
+    for (std::uint64_t t = newest_local_ + 1; t <= target; ++t) store(cfg_.local_port, t, hooks_.local_sample(t));
+    newest_local_ = std::max(newest_local_, target);
+}
+
+void Session::on_vblank(std::uint64_t frame) {
+    if (outcome_ != Outcome::running) return;
+    current_frame_ = frame;
+    if (catching_up_ && !replay(frame)) return;
+    note_frame_time();
+    if (episode_.stalls && now_ms() - episode_.ended_at > kEpisodeGapMs) flush_episode();
+    apply_delay_change(frame);
+    pump(0);
+    if (outcome_ != Outcome::running || resync_requested_) return;
+    if (suspect_at_ && now_ms() - suspect_at_ > kResyncWaitMs) {
+        send_bye(kByeDesync, frame);
+        fail(Outcome::desync, "memory digests differ and the host did not send a fresh copy of the game");
+        return;
+    }
+    finalize_leaves();
+    adapt_delay(frame);
+    if (cfg_.digest_every && frame % cfg_.digest_every == 0) take_digest(frame);
+    if (outcome_ != Outcome::running) return;
+    sample_local(frame);
+    send_all();
+    wait_for_peers(frame);
+    if (outcome_ != Outcome::running || resync_requested_) return;
+    apply_frame(frame);
+    report_board(frame, false);
+    ++stats_.frames;
+    work_end_ = now_ms();
+}
+
+// How long this machine takes to produce a frame when it is not waiting for anyone: the game's own work plus the window's pacing. A delay counted in frames covers
+// a path of that many of these.
+void Session::note_frame_time() {
+    const std::uint64_t now = now_ms();
+    if (!work_end_) return;
+    const double sample = static_cast<double>(now - work_end_);
+    work_ms_ = work_ms_ > 0 ? work_ms_ + kFrameTimeGain * (sample - work_ms_) : sample;
+}
+
+void Session::note_round_trip(Peer &peer, std::uint64_t rtt) {
+    const double sample = static_cast<double>(rtt);
+    if (!peer.rtt_samples) {
+        peer.srtt_ms = sample;
+        peer.rttvar_ms = sample / 2;
+    } else {
+        peer.rttvar_ms += kDeviationGain * (std::abs(sample - peer.srtt_ms) - peer.rttvar_ms);
+        peer.srtt_ms += kRttGain * (sample - peer.srtt_ms);
+    }
+    ++peer.rtt_samples;
+}
+
+// Host: the delay that carries the slowest path. A path between two joiners goes through the host, so it is the two slowest links added; with one joiner it is half the
+// round trip. A larger delay is announced at once, a smaller one only after it would have done for kLowerHoldMs, one frame at a time.
+void Session::adapt_delay(std::uint64_t frame) {
+    if (!is_host() || !cfg_.adaptive_delay) return;
+    const std::uint64_t now = now_ms();
+    if (now - adapt_at_ < kAdaptEveryMs) return;
+    adapt_at_ = now;
+    double worst = 0, second = 0;
+    int measured = 0;
+    for (const Peer &peer : peers_) {
+        if (!active(peer) || absent(peer.port, frame) || peer.rtt_samples < kAdaptMinSamples) continue;
+        const double effective = peer.srtt_ms + kDeviationWeight * peer.rttvar_ms;
+        ++measured;
+        if (effective > worst) {
+            second = worst;
+            worst = effective;
+        } else if (effective > second) {
+            second = effective;
+        }
+    }
+    if (!measured) return;
+    const double path_ms = measured >= 2 ? (worst + second) / 2 : worst / 2;
+    const double frame_ms = std::max(work_ms_, kFrameMs);
+    const std::uint16_t wanted = static_cast<std::uint16_t>(std::clamp<double>(std::ceil(path_ms / frame_ms) + kDelayMarginFrames, kMinAdaptiveDelay, kMaxDelay));
+    const std::uint16_t current = announced_.seq ? announced_.value : delay_;
+    if (wanted > current) {
+        lower_since_ = 0;
+        announce_delay(frame, current, wanted);
+    } else if (wanted < current) {
+        if (!lower_since_) lower_since_ = now;
+        if (now - lower_since_ >= kLowerHoldMs) {
+            lower_since_ = 0;
+            announce_delay(frame, current, static_cast<std::uint16_t>(current - 1));
+        }
+    } else {
+        lower_since_ = 0;
+    }
+}
+
+void Session::announce_delay(std::uint64_t frame, std::uint16_t before, std::uint16_t value) {
+    announced_ = pending_delay_ = {static_cast<std::uint16_t>(announced_.seq + 1), frame + kDelayLeadFrames, value};
+    log("input delay %u -> %u frames from frame %llu (round trips:%s; a frame takes %.0f ms)", before, value, ull(announced_.from), round_trips().c_str(), std::max(work_ms_, kFrameMs));
+}
+
+void Session::apply_delay_change(std::uint64_t frame) {
+    if (!pending_delay_.seq || frame < pending_delay_.from) return;
+    if (pending_delay_.value != delay_) log("frame %llu: input delay %u -> %u frames", ull(frame), delay_, pending_delay_.value);
+    delay_ = pending_delay_.value;
+    pending_delay_.seq = 0;
+    ++stats_.delay_changes;
+}
+
+std::string Session::round_trips() const {
+    std::string text;
+    for (const Peer &peer : peers_)
+        if (active(peer) && peer.rtt_samples) text += " pad " + std::to_string(peer.port + 1) + " " + std::to_string(static_cast<int>(peer.srtt_ms + 0.5)) + "+-" + std::to_string(static_cast<int>(peer.rttvar_ms + 0.5)) + " ms";
+    return text;
+}
+
+void Session::finish(std::uint64_t frame, const char *why, bool crashed) {
+    if (outcome_ == Outcome::link_broken) return;
+    if (outcome_ == Outcome::running) {
+        const std::uint8_t reason = crashed ? kByeError : kByeNormal;
+        send_bye(reason, frame);
+        const std::uint64_t started = now_ms();
+        std::uint64_t last_send = started;
+        const auto all_done = [&] {
+            return std::all_of(peers_.begin(), peers_.end(), [&](const Peer &p) { return !active(p) || (p.bye && p.ack[static_cast<std::size_t>(cfg_.local_port)] >= newest_local_); });
+        };
+        while (now_ms() - started < kLingerMs && !all_done()) {
+            pump(kLingerPollMs);
+            if (now_ms() - last_send >= kResendMs * 2) {
+                send_all();
+                send_bye(reason, frame);
+                last_send = now_ms();
+            }
+        }
+    }
+    flush_episode();
+    log("leaving at frame %llu (%s)", ull(frame), why);
+    report();
+}
+
+void Session::report() const {
+    const double rtt_avg = stats_.rtt_count ? static_cast<double>(stats_.rtt_sum) / static_cast<double>(stats_.rtt_count) : 0.0;
+    log("summary: %llu digests cost %.1f ms each on this machine", ull(stats_.digests_taken), stats_.digests_taken ? static_cast<double>(stats_.digest_ms) / static_cast<double>(stats_.digests_taken) : 0.0);
+    log("summary: %llu frames in lockstep, %llu digests compared, waited for the peer %llu times over 200 ms, %llu ms in total over all frames (longest %llu ms)", ull(stats_.frames),
+        ull(stats_.digests_checked), ull(stats_.stalls), ull(stats_.stall_ms), ull(stats_.longest_stall_ms));
+    log("summary: input delay %u frames at the end, changed %u times", delay_, stats_.delay_changes);
+    log("summary: message round trip (includes the peer's frame time) min/avg/max %llu/%.1f/%llu ms over %llu samples, %llu messages sent, %llu received, %llu samples repeated",
+        ull(stats_.rtt_count ? stats_.rtt_min : 0), rtt_avg, ull(stats_.rtt_max), ull(stats_.rtt_count), ull(stats_.sent), ull(stats_.received), ull(stats_.resent_samples));
+}
+
+}
diff --git a/runtime/src/netplay/session.hpp b/runtime/src/netplay/session.hpp
new file mode 100644
index 0000000..0466a0d
--- /dev/null
+++ b/runtime/src/netplay/session.hpp
@@ -0,0 +1,242 @@
+#pragma once
+
+#include "history.hpp"
+#include "ps2/pad.hpp"
+#include "transport.hpp"
+#include "wire.hpp"
+
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace ps2::netplay {
+
+// What the lockstep session needs from the machine it drives. netplay.cpp wires these to the runtime.
+struct Hooks {
+    std::function<PadSample(std::uint64_t frame)> local_sample;  // this machine's controller, as it should read at `frame`
+    std::function<void(int port, const PadSample &)> apply;
+    std::function<void(int port, bool plugged)> plug;
+    std::function<Hashes()> hashes;
+    std::function<bool(int port)> player_missing;                  // the game has no human yet for the controller on `port`
+    std::function<bool()> halted;                                  // the emulator is shutting down
+    std::function<void()> service;                                 // background work of the machine (a snapshot going out to a joiner); called outside any walk over the peers
+    std::function<void(int port, std::uint8_t event)> announce;     // a player's pad was unplugged (event: a LeftReason) or plugged in again (kJoinedBack), at the same frame on every machine
+};
+
+struct SessionSettings {
+    std::uint16_t delay = 3;           // frames between sampling a pad and the frame it takes effect
+    std::uint16_t digest_every = 30;   // frames between memory digest exchanges
+    int local_port = 0;                // 0 for the host, 1 to players - 1 for a joiner
+    int players = 2;                   // controller ports in play, 2 to kPadCount
+    bool press_start_to_join = true;   // the session presses START on a joiner's pad so the game's second player drops in (off when the game starts in lockstep from boot)
+    bool adaptive_delay = true;        // host: the input delay follows the measured round trips
+};
+
+// How the session ended. Nothing here stops the game: the machine goes back to local play (netplay.cpp) and the outcome only decides what the log says.
+enum class Outcome { running, peer_left, desync, timeout, link_broken };
+
+// Input lockstep for up to kPadCount controller ports in a star: the host (port 0) has one link per joiner, a joiner has
+// one link to the host, which relays the other joiners' samples. Frame f runs only when every port's sample for f is
+// known; the local sample taken at frame f is the one that applies at f + delay, so the network has `delay` frames to
+// deliver it. Every message repeats the samples the peer has not acknowledged, so loss costs nothing but a resend.
+class Session {
+public:
+    // Host: links[i] leads to the joiner on port i + 1. Joiner: links holds the one link to the host.
+    Session(std::vector<Transport *> links, const SessionSettings &settings, Hooks hooks);
+
+    // First frame run in lockstep. Frames before first_frame + delay take neutral input on every port.
+    void begin(std::uint64_t first_frame);
+    // Host: the machine on `link` replays the frames recorded since its snapshot and plays on `port` live from join_frame; its input counts from join_frame + delay on every machine.
+    void admit(Transport *link, int port, std::uint64_t join_frame);
+    // Host: record what is applied from `first_frame` on, for a machine that is loading a snapshot taken just before it. Counted: every start needs its stop.
+    void start_recording(std::uint64_t first_frame);
+    void stop_recording();
+    const History &history() const { return history_; }
+    // Host: the next kMsgHistory for the machine on `port`, holding the recorded frames from `base` on. False when there is nothing at `base` yet.
+    bool history_message(int port, std::uint64_t base, std::uint64_t join_frame, HistoryMessage &message) const;
+    // Host: what the machine on `port` last said about its replay (after admit).
+    HistoryAck join_progress(int port) const;
+    // Host: the frame after the last one run, and the input delay in force.
+    std::uint64_t next_frame() const { return current_frame_ + 1; }
+    std::uint16_t delay() const { return delay_; }
+    // Host: the machine on `port` is out of step; it plays no more from the first frame it has no input for, while its game is brought back from a snapshot. False when the
+    // machine went out of step again soon after it was brought back (the session then ends).
+    bool begin_resync(int port);
+    // Host: ports whose resync has begun and not been taken by the machine yet.
+    std::vector<int> take_resyncs();
+    // The link of the joiner on `port`, or null.
+    Transport *link_of(int port) const;
+    // Host: the resync of `port` failed; it stays out for good, unplugged from the first frame no machine can have passed.
+    void give_up_resync(int port);
+    // Joiner: the game here went out of step and the host is taking this machine out until it has sent a snapshot.
+    bool resync_requested() const { return resync_requested_; }
+    // Joiner that loaded a snapshot taken at first_frame - 1: replays what the host applied since (sent as kMsgHistory) until it is level with the game, then plays live.
+    void begin_catchup(std::uint64_t first_frame, std::uint8_t plugged);
+    bool catching_up() const { return catching_up_; }
+    // Test aid: sends this machine's messages and takes what has arrived, as a machine does while it waits (a slow machine that is still alive).
+    void keep_alive() { send_all(); pump(0); }
+    // Host: the port nobody plays on now (and not in the bit mask `taken`, ports a join is working on): `wanted` when it is free, else the lowest one, or -1.
+    int free_port(int wanted = -1, std::uint8_t taken = 0) const;
+    // Host that starts alone: every other port is open from the first frame on, to be filled by joins (admit) like the port of a player who left.
+    void hold_ports_open();
+    // Bit p set: pad p is plugged in as of the last frame applied (the session unplugs the ports of players who are out).
+    std::uint8_t plugged_mask() const;
+    // Called at every vblank from first_frame on, before the frame's input is applied. Blocks while a peer is late.
+    void on_vblank(std::uint64_t frame);
+    // Tells the peers this machine is leaving (`crashed`: the game stopped on an error, which they tell their players) and keeps answering resends for a moment
+    // so their last frames complete.
+    void finish(std::uint64_t frame, const char *why, bool crashed = false);
+
+    Outcome outcome() const { return outcome_; }
+    // The sentence that says why the session ended (empty while it runs).
+    const std::string &end_message() const { return end_message_; }
+    int players() const { return cfg_.players; }
+    void report() const;
+
+private:
+    static constexpr std::uint64_t kNever = ~0ull;
+    static constexpr std::uint64_t kJoinStartDelay = 100;        // frames after lockstep starts: libpad needs time to see the new pad
+    static constexpr std::uint64_t kResyncRepeatFrames = 1800;   // a machine that goes out of step again this soon after being brought back is not brought back again
+    static constexpr std::uint64_t kResyncFrameSlack = 90;       // a snapshot older than this many frames behind the game is a stray resend of an earlier join, not a resync
+    enum ByeReason : std::uint8_t { kByeNormal = 0, kByeDesync = 1, kByeError = 2 };
+
+    struct Slot {
+        std::uint64_t frame = ~0ull;
+        PadSample sample;
+    };
+    struct DigestRecord {
+        std::uint64_t frame;
+        Hashes hashes;
+    };
+    struct Peer {
+        Transport *link = nullptr;
+        double srtt_ms = 0, rttvar_ms = 0;                 // smoothed round trip and its mean deviation (host: the input delay follows them)
+        std::uint32_t rtt_samples = 0;
+        std::uint64_t heard_at = 0;                        // steady-clock ms of the newest message from this peer
+        int port = 0;                                      // the controller port this peer plays on (0 for the host)
+        std::array<std::uint64_t, kPadCount> ack{};        // the peer holds every frame of port p up to here
+        std::uint32_t last_stamp = 0;                      // peer's clock stamp from its newest message, for RTT echo
+        std::uint64_t last_stamp_at = 0;
+        bool bye = false;
+        bool gone = false;                                 // host: this peer left and its port is absent; nothing is sent to or read from it
+        std::uint64_t bye_at = 0, bye_frame = 0, bye_newest = 0;   // when the goodbye came, the peer's frame then, its newest sampled frame
+        HistoryAck history_ack;                            // host: what a joiner replaying the history last said
+        std::uint8_t bye_reason = 0;
+        std::deque<DigestRecord> remote_digests;
+        std::uint64_t checked_through = 0;                 // newest frame whose digests were compared with this peer
+    };
+    // Frames [from, until) of a port carry no input: its player left (from) and may come back (until). kNever when it never happened or has no end.
+    struct Absence {
+        std::uint64_t from = kNever, until = kNever;
+        std::uint8_t reason = kLeftSaid;                   // a LeftReason
+        std::uint64_t unplug_from = kNever;                // from this frame on the pad is unplugged (a resync keeps it plugged: the character stands idle)
+    };
+    // The input delay changes on every machine at the same frame: the host announces (seq, from, value) in every message.
+    struct DelayChange {
+        std::uint16_t seq = 0;
+        std::uint64_t from = 0;
+        std::uint16_t value = 0;
+    };
+    struct Stats {
+        std::uint64_t frames = 0, digests_checked = 0, stalls = 0, stall_ms = 0, longest_stall_ms = 0, sent = 0, received = 0, resent_samples = 0, digest_ms = 0, digests_taken = 0;
+        std::uint64_t rtt_count = 0, rtt_sum = 0, rtt_min = ~0ull, rtt_max = 0, delay_changes = 0;
+    };
+
+    bool is_host() const { return cfg_.local_port == 0; }
+    bool absent(int port, std::uint64_t frame) const;
+    bool unplugged(int port, std::uint64_t frame) const;
+    bool has_ever_been_absent(int port) const { return absent_[static_cast<std::size_t>(port)].from != kNever; }
+    bool active(const Peer &peer) const { return !peer.gone; }
+    void leave(Peer &peer, std::uint64_t from_frame, std::uint8_t reason);
+    void finalize_leaves();
+    bool drop_late_joiners(std::uint64_t frame, std::uint64_t waited);
+    std::uint64_t silent_for(const Peer &peer) const;
+    void update_plugs(std::uint64_t frame);
+    void advance_contig(int port);
+    bool have(int port, std::uint64_t frame) const;
+    bool have_all(std::uint64_t frame) const;
+    const PadSample &input(int port, std::uint64_t frame) const;
+    void store(int port, std::uint64_t frame, const PadSample &sample);
+    std::uint64_t known_through(int port) const;
+    bool sends_port(const Peer &peer, int port) const;
+    bool accepts_port(const Peer &peer, int port) const;
+    void send_input(Peer &peer);
+    void send_all();
+    void send_bye(std::uint8_t reason, std::uint64_t frame);
+    void send_status();
+    void report_board(std::uint64_t frame, bool stalled);
+    void pump(int timeout_ms);
+    void drain(Peer &peer, int timeout_ms);
+    void handle(Peer &peer, const std::uint8_t *data, std::size_t size);
+    void on_input(Peer &peer, Reader &r);
+    void take_digest(std::uint64_t frame);
+    void check_digest(Peer &peer, std::uint64_t frame);
+    void wait_for_peers(std::uint64_t frame);
+    std::string late_ports(std::uint64_t frame) const;
+    std::string late_names(std::uint64_t frame) const;   // the roster names of the pads whose input is missing, for the stall screen
+    Peer *departed_peer_holding_up(std::uint64_t frame);
+    void apply_frame(std::uint64_t frame);
+    void fail(Outcome outcome, const std::string &message);
+    void flush_episode();
+    void sample_local(std::uint64_t frame);
+    void adapt_delay(std::uint64_t frame);
+    void announce_delay(std::uint64_t frame, std::uint16_t before, std::uint16_t value);
+    void note_frame_time();
+    void apply_delay_change(std::uint64_t frame);
+    void note_round_trip(Peer &peer, std::uint64_t rtt);
+    std::string round_trips() const;
+    void on_history(Peer &peer, Reader &r);
+    void on_history_ack(Peer &peer, Reader &r);
+    void send_history_ack(bool force);
+    bool replay(std::uint64_t frame);
+    void on_mismatch(Peer &peer, std::uint64_t frame);
+    void apply_record(std::uint64_t frame, const FrameRecord &record);
+
+    static constexpr std::size_t kRing = 256;
+
+    SessionSettings cfg_;
+    Hooks hooks_;
+    std::vector<Peer> peers_;
+    std::uint64_t begin_ = 0;
+    std::uint64_t first_input_ = 0;      // first frame that carries a real sample (every port before this one is neutral)
+    std::uint64_t local_first_ = 0;      // first frame this machine's own port has a sample for
+    std::array<Absence, kPadCount> absent_{};
+    std::array<bool, kPadCount> plugged_{};              // what hooks_.plug was last told, per port
+    std::uint16_t delay_ = 0;            // frames between sampling a pad and the frame it takes effect, now
+    DelayChange announced_, pending_delay_;
+    double work_ms_ = 0;                 // smoothed time between the end of one frame's netplay work and the start of the next
+    std::uint64_t work_end_ = 0;         // steady-clock ms when the last frame's netplay work ended
+    std::uint64_t adapt_at_ = 0, lower_since_ = 0;      // steady-clock ms: of the last look at the round trips, and since when a lower delay would have done
+    std::uint64_t current_frame_ = 0;    // the frame on_vblank last ran
+    History history_;
+    int recordings_ = 0;
+    bool digest_taken_ = false;          // a digest of the frame being run is waiting to be attached to its record
+    Hashes digest_now_;
+    std::vector<int> resyncs_;
+    std::array<std::uint64_t, kPadCount> resynced_at_{};   // frame the last resync of each port was admitted at (0: never)
+    bool resync_requested_ = false;
+    std::uint64_t suspect_at_ = 0;       // joiner: steady-clock ms when the digests first differed from the host's
+    bool catching_up_ = false;
+    std::uint64_t join_frame_ = 0;       // joiner: the frame it plays live from (0 until the host has said)
+    std::uint64_t catchup_started_ = 0, catchup_heard_ = 0, ack_sent_ = 0, replay_marked_ = 0, replay_marked_frame_ = 0, replay_logged_ = 0;
+    std::uint32_t replay_fps_ = 0;
+    std::uint64_t newest_local_ = 0;     // newest frame whose local sample has been taken
+    std::array<std::uint64_t, kPadCount> contig_{};      // every frame of port p up to here has arrived (own port: see known_through)
+    std::array<std::array<Slot, kRing>, kPadCount> ring_;
+    std::deque<DigestRecord> local_digests_;
+    std::uint64_t status_sent_ = 0, board_shown_ = 0;   // steady-clock ms of the last status message and of the last time the rows were put on the screen
+    bool relay_due_ = false;             // host: a joiner's samples arrived and the others have not been told yet
+    std::array<std::uint64_t, kPadCount> join_press_from_{};   // frame the game's own START press for a port begins (port 1 only)
+    std::array<bool, kPadCount> join_press_logged_{}, join_done_logged_{};
+    struct Episode {
+        std::uint64_t stalls = 0, ms = 0, longest = 0, first_frame = 0, ended_at = 0;
+    } episode_;
+    Outcome outcome_ = Outcome::running;
+    std::string end_message_;
+    Stats stats_;
+};
+
+}
diff --git a/runtime/src/netplay/session_file.cpp b/runtime/src/netplay/session_file.cpp
new file mode 100644
index 0000000..f858f55
--- /dev/null
+++ b/runtime/src/netplay/session_file.cpp
@@ -0,0 +1,163 @@
+#include "session_file.hpp"
+
+#include "log.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <sstream>
+
+namespace ps2::netplay {
+
+namespace {
+
+constexpr std::size_t kMaxNameChars = 12;              // what a row of the game's menus holds in its big font
+constexpr char kUnprintable = '?';
+constexpr unsigned char kUtf8ContinuationMask = 0xC0, kUtf8Continuation = 0x80;
+constexpr unsigned char kFirstPrintable = 0x20, kLastPrintable = 0x7E;
+constexpr const char kUtf8Bom[] = "\xEF\xBB\xBF";
+constexpr int kMinPlayers = 2;
+
+std::unique_ptr<SessionInfo> g_session;
+
+std::string trim(const std::string &text) {
+    const auto first = text.find_first_not_of(" \t\r\n");
+    if (first == std::string::npos) return {};
+    return text.substr(first, text.find_last_not_of(" \t\r\n") - first + 1);
+}
+
+// A comment starts a line, or follows whitespace (a name or a path never holds " ;": the launcher replaces ';' in names).
+std::string without_comment(const std::string &line) {
+    for (std::size_t i = 0; i < line.size(); ++i)
+        if ((line[i] == ';' || line[i] == '#') && (i == 0 || line[i - 1] == ' ' || line[i - 1] == '\t')) return line.substr(0, i);
+    return line;
+}
+
+// The font draws printable ASCII; any other character (all the bytes of a UTF-8 one) becomes one '?'. A name that is nothing but that (a name in another script) falls back to "PLAYER n".
+std::string display_name(const std::string &raw, int slot) {
+    const std::string trimmed = trim(raw);
+    if (trimmed.empty()) return {};
+    std::string name;
+    bool readable = false;
+    for (const char c : trimmed) {
+        const auto u = static_cast<unsigned char>(c);
+        if ((u & kUtf8ContinuationMask) == kUtf8Continuation) continue;
+        const bool printable = u >= kFirstPrintable && u <= kLastPrintable;
+        readable = readable || (printable && c != ' ');
+        if (name.size() < kMaxNameChars) name += printable ? c : kUnprintable;
+    }
+    return readable ? trim(name) : "PLAYER " + std::to_string(slot + 1);
+}
+
+std::uint64_t to_u64(const std::string &text) { return std::strtoull(text.c_str(), nullptr, 10); }
+int to_int(const std::string &text) { return static_cast<int>(std::strtol(text.c_str(), nullptr, 10)); }
+
+void set_role(SessionInfo &info, const std::string &value) {
+    if (value == "host") info.role = SessionRole::host;
+    else if (value == "guest") info.role = SessionRole::guest;
+    else if (value == "local") info.role = SessionRole::local;
+    else log("session file: role '%s' is not host, guest or local; taking local", value.c_str());
+}
+
+void set_session_key(SessionInfo &info, const std::string &key, const std::string &value) {
+    if (key == "epoch") info.epoch = to_u64(value);
+    else if (key == "session_id") info.session_id = to_u64(value);
+    else if (key == "role") set_role(info, value);
+    else if (key == "local_slot") info.local_slot = to_int(value);
+    else if (key == "max_players") info.max_players = to_int(value);
+    else if (key == "link_port") info.link_port = to_int(value);
+    else if (key == "status_file") info.status_file = value;
+    else if (key == "friendly_fire") info.friendly_fire = to_int(value) != 0 ? 1 : 0;
+}
+
+void set_host_key(SessionInfo &info, const std::string &key, const std::string &value) {
+    if (key == "profile_slot") info.profile_slot = to_int(value);
+    else if (key == "new_profile_difficulty") info.new_profile_difficulty = to_int(value);
+    else if (key == "friendly_fire") info.friendly_fire = to_int(value) != 0 ? 1 : 0;
+    else if (key == "input_delay") info.input_delay = to_int(value);
+    else if (key == "split_screen") info.split_screen = value == "always" ? 1 : 0;
+    else if (key == "memcard") info.memcard = value;
+}
+
+void set_local_key(LocalOptions &local, const std::string &key, const std::string &value) {
+    if (key == "scale") local.scale = to_int(value);
+    else if (key == "msaa") local.msaa = to_int(value);
+    else if (key == "aniso") local.aniso = to_int(value);
+    else if (key == "sharpen") local.sharpen = to_int(value);
+    else if (key == "volume") local.volume = to_int(value);
+    else if (key == "brightness") local.brightness = to_int(value);
+    else if (key == "pad_user") local.pad_user = to_int(value);
+    else if (key == "view") local.view = value == "all" ? 1 : 0;
+}
+
+void set_roster_entry(SessionInfo &info, const std::string &key, const std::string &value) {
+    char *end = nullptr;
+    const long slot = std::strtol(key.c_str(), &end, 10);
+    if (end == key.c_str() || *end != '\0' || slot < 0 || slot >= kPadCount) return;
+    info.names[static_cast<std::size_t>(slot)] = display_name(value, static_cast<int>(slot));
+}
+
+}
+
+bool load_session_file(const std::string &path, SessionInfo &info, std::string &error) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) {
+        error = "cannot open " + path;
+        return false;
+    }
+    info = {};
+    std::string section, line;
+    bool first = true;
+    while (std::getline(in, line)) {
+        if (first && line.compare(0, sizeof kUtf8Bom - 1, kUtf8Bom) == 0) line.erase(0, sizeof kUtf8Bom - 1);
+        first = false;
+        const std::string text = trim(without_comment(line));
+        if (text.empty()) continue;
+        if (text.front() == '[' && text.back() == ']') {
+            section = text.substr(1, text.size() - 2);
+            continue;
+        }
+        const auto equals = text.find('=');
+        if (equals == std::string::npos) continue;
+        const std::string key = trim(text.substr(0, equals)), value = trim(text.substr(equals + 1));
+        if (section == "session") set_session_key(info, key, value);
+        else if (section == "host") set_host_key(info, key, value);
+        else if (section == "roster") set_roster_entry(info, key, value);
+        else if (section == "local") set_local_key(info.local, key, value);
+    }
+    info.max_players = std::max(kMinPlayers, std::min(info.max_players, kPadCount));
+    info.local_slot = std::max(0, std::min(info.local_slot, kPadCount - 1));
+    return true;
+}
+
+void set_session(const SessionInfo &info) {
+    g_session = std::make_unique<SessionInfo>(info);
+    const char *const role = info.role == SessionRole::host ? "host" : info.role == SessionRole::guest ? "guest" : "local";
+    std::ostringstream roster;
+    for (int slot = 0; slot < info.max_players; ++slot) {
+        const std::string &name = info.names[static_cast<std::size_t>(slot)];
+        roster << (slot ? " / " : "") << slot + 1 << " " << (name.empty() ? "open" : name);
+    }
+    log("co-op session: %s, epoch %llu, session %llu, you are slot %d (pad %d) of %d, roster %s%s%s", role, ull(info.epoch), ull(info.session_id), info.local_slot,
+        info.local_slot + 1, info.max_players, roster.str().c_str(), info.memcard.empty() ? "" : ", card ", info.memcard.c_str());
+    const LocalOptions &local = info.local;
+    if (local.scale >= 0 || local.msaa >= 0 || local.aniso >= 0 || local.sharpen >= 0 || local.volume >= 0 || local.brightness >= 0 || local.pad_user >= 0 || local.view >= 0)
+        log("local options from the session file (this machine only): scale %d, msaa %d, aniso %d, sharpen %d, volume %d, brightness %d, pad_user %d, view %d (-1: not set; the command line wins)", local.scale, local.msaa,
+            local.aniso, local.sharpen, local.volume, local.brightness, local.pad_user, local.view);
+}
+
+const SessionInfo *session() { return g_session.get(); }
+
+std::string roster_name(int slot) {
+    if (!g_session || slot < 0 || slot >= kPadCount) return {};
+    return g_session->names[static_cast<std::size_t>(slot)];
+}
+
+std::string player_name(int slot) {
+    const std::string name = roster_name(slot);
+    return name.empty() ? "PLAYER " + std::to_string(slot + 1) : name;
+}
+
+}
diff --git a/runtime/src/netplay/session_file.hpp b/runtime/src/netplay/session_file.hpp
new file mode 100644
index 0000000..64fc611
--- /dev/null
+++ b/runtime/src/netplay/session_file.hpp
@@ -0,0 +1,58 @@
+#pragma once
+
+#include "ps2/pad.hpp"
+
+#include <array>
+#include <cstdint>
+#include <string>
+
+// The launcher's session card (--coop-session <file>): who is in the session, in which slot, who hosts, which memory card to play on.
+// The engine reads it once at start; unknown sections and keys (a newer launcher) are ignored. Slot n is pad n + 1, the same on every machine.
+namespace ps2::netplay {
+
+enum class SessionRole { host, guest, local };
+
+// This machine's own display and input options (the [local] section: the launcher's settings for the player at this machine). They are applied like the matching command line
+// options (the command line wins) and are never sent to another machine or made part of the session's shared terms. -1: not set.
+struct LocalOptions {
+    int scale = -1;      // --scale 1 to 6
+    int msaa = -1;       // --msaa (0 or 1)
+    int aniso = -1;      // --aniso 0, 2, 4, 8 or 16
+    int sharpen = -1;    // 0 is --no-sharpen
+    int volume = -1;     // --volume 0 to 100
+    int brightness = -1; // --brightness 25 to 200 (100: as the game draws it)
+    int pad_user = -1;   // --pad-user 0 to 3
+    int view = -1;       // online view: 0 mine (this machine's player's view full screen), 1 all (the whole layout, like --full-view)
+};
+
+struct SessionInfo {
+    std::uint64_t epoch = 0;
+    std::uint64_t session_id = 0;            // the Steam lobby id, the same on every machine
+    SessionRole role = SessionRole::local;   // local: split screen only, no link
+    int local_slot = 0;                      // this machine's pad port
+    int max_players = 2;                     // the host's setting
+    int link_port = 0;                       // loopback link to the launcher (0: none)
+    int profile_slot = -1;                   // -1: the host picks in game; 0 to 5: the profile the launcher lobby chose
+    int new_profile_difficulty = 1;
+    int input_delay = 0;                     // the host's setting in frames: 0 follows the measured round trips, 1 to 30 holds that delay
+    int friendly_fire = 0;                   // the host's setting: 1 lets players hurt each other (guest word 0x02300000, written on every machine at the start of the session); 0 is the original game
+    int split_screen = 0;                    // the host's setting: 0 auto (combined view while the players fit one picture), 1 always split (guest word kSplitScreenSwitch, written on every machine at the start of the session)
+    std::string status_file;                 // where the game writes what it is doing for the launcher (status_file.hpp); empty: nowhere
+    std::string memcard;                     // this machine's card (a guest's: the copy of the host's the launcher sent)
+    std::array<std::string, kPadCount> names;   // by slot, cut to what the game's font draws; empty for an open slot
+    LocalOptions local;                      // this machine's own options, never shared
+};
+
+// Reads the file. False with `error` set when it cannot be opened; a file with nothing usable in it still loads (every field stays at its default).
+bool load_session_file(const std::string &path, SessionInfo &info, std::string &error);
+
+// Keeps the session this process was started with and prints its one summary line ("[net] co-op session: ...").
+void set_session(const SessionInfo &info);
+// The session this process was started with, or null when there was no --coop-session.
+const SessionInfo *session();
+// The roster name of `slot` ("" for an open slot or when there is no session), for the game's own displays.
+std::string roster_name(int slot);
+// The name to show for `slot`: the roster name, or "PLAYER <slot + 1>" when it has none (always something to put on a screen).
+std::string player_name(int slot);
+
+}
diff --git a/runtime/src/netplay/session_join.cpp b/runtime/src/netplay/session_join.cpp
new file mode 100644
index 0000000..29780e0
--- /dev/null
+++ b/runtime/src/netplay/session_join.cpp
@@ -0,0 +1,193 @@
+#include "session.hpp"
+
+#include "log.hpp"
+#include "../overlay/overlay.hpp"
+
+#include <algorithm>
+
+// The parts of the lockstep session that bring a machine into a game that is already running: the host records what it applies while a joiner (or a machine that went
+// out of step) loads a snapshot, and that machine replays the record until it is level with the game and plays on live (history.hpp).
+namespace ps2::netplay {
+
+namespace {
+
+constexpr std::uint64_t kAckEveryMs = 50;
+constexpr std::uint64_t kCatchupSilenceMs = 15000;    // the host sent no more of the history for this long
+constexpr std::uint64_t kCatchupLimitMs = 120000;     // the machine is not level with the game after this long
+constexpr std::uint64_t kReplayRateWindowMs = 1000;
+constexpr std::uint64_t kReplayLogMs = 5000;
+constexpr int kPollMs = 5;
+constexpr std::uint64_t kUnplugGapFrames = 2;         // frames past the newest one any machine can have run, where a failed resync's unplug begins
+
+}
+
+// Host: the machine on `port` is out of step. It plays no more from the first frame its input has not arrived for (every machine still has all the earlier ones), its
+// pad stays plugged so the character stands idle, and the machine's link goes to the snapshot upload (netplay.cpp).
+bool Session::begin_resync(int port) {
+    const std::size_t p = static_cast<std::size_t>(port);
+    if (resynced_at_[p] && current_frame_ < resynced_at_[p] + kResyncRepeatFrames) {
+        log("pad %d went out of step again %llu frames after it was brought back", port + 1, ull(current_frame_ - resynced_at_[p]));
+        return false;
+    }
+    Peer *found = nullptr;
+    for (Peer &peer : peers_)
+        if (active(peer) && peer.port == port) found = &peer;
+    if (!found) return false;
+    absent_[p] = {contig_[p] + 1, kNever, kLeftResync, kNever};
+    found->gone = true;
+    advance_contig(port);
+    resyncs_.push_back(port);
+    log("pad %d is out of step: it is out from frame %llu on every machine until it has a fresh copy of the game", port + 1, ull(absent_[p].from));
+    return true;
+}
+
+std::vector<int> Session::take_resyncs() {
+    std::vector<int> taken;
+    taken.swap(resyncs_);
+    return taken;
+}
+
+Transport *Session::link_of(int port) const {
+    Transport *link = nullptr;
+    for (const Peer &peer : peers_)
+        if (peer.port == port) link = peer.link;
+    return link;
+}
+
+// The resync failed: the machine stays out and its pad is unplugged from a frame no machine can have run yet.
+void Session::give_up_resync(int port) {
+    Absence &a = absent_[static_cast<std::size_t>(port)];
+    if (a.reason != kLeftResync || a.until != kNever) return;
+    a.reason = kLeftLost;
+    a.unplug_from = newest_local_ + kUnplugGapFrames;
+    log("pad %d could not be brought back: it is out for good, unplugged from frame %llu", port + 1, ull(a.unplug_from));
+}
+
+bool Session::history_message(int port, std::uint64_t base, std::uint64_t join_frame, HistoryMessage &message) const {
+    if (base < history_.first() || base >= history_.end()) return false;
+    const Absence &a = absent_[static_cast<std::size_t>(port)];
+    message = {};
+    message.join_frame = join_frame;
+    message.delay = static_cast<std::uint16_t>(join_frame && a.until != kNever && a.until > join_frame ? a.until - join_frame : delay_);
+    message.resync = a.reason == kLeftResync;
+    message.press_from = join_press_from_;
+    message.base = base;
+    for (std::uint64_t frame = base; frame < history_.end() && message.records.size() < kHistoryPerMessage; ++frame) message.records.push_back(*history_.at(frame));
+    return true;
+}
+
+HistoryAck Session::join_progress(int port) const {
+    HistoryAck ack;
+    for (const Peer &peer : peers_)
+        if (peer.port == port && active(peer)) ack = peer.history_ack;
+    return ack;
+}
+
+void Session::begin_catchup(std::uint64_t first_frame, std::uint8_t plugged) {
+    catching_up_ = true;
+    begin_ = first_frame;
+    first_input_ = kNever;
+    history_.start(first_frame);
+    for (int port = 1; port < cfg_.players; ++port) plugged_[static_cast<std::size_t>(port)] = (plugged >> port) & 1;
+    catchup_started_ = catchup_heard_ = now_ms();
+    for (Peer &peer : peers_) peer.heard_at = catchup_started_;
+    log("snapshot loaded: replaying the game from frame %llu until this machine is level with it", ull(first_frame));
+}
+
+void Session::on_history(Peer &, Reader &r) {
+    HistoryMessage message;
+    if (is_host() || !catching_up_ || !read_history(r, message)) return;
+    catchup_heard_ = now_ms();
+    if (message.join_frame && !join_frame_) {
+        join_frame_ = message.join_frame;
+        delay_ = message.delay;
+        first_input_ = join_frame_;
+        local_first_ = join_frame_ + delay_;
+        newest_local_ = local_first_ - 1;
+        contig_.fill(join_frame_ - 1);
+        absent_[static_cast<std::size_t>(cfg_.local_port)] = {join_frame_, local_first_, message.resync ? kLeftResync : kLeftSaid, message.resync ? kNever : join_frame_};
+        for (int port = 0; port < cfg_.players; ++port)
+            if (port != cfg_.local_port) join_press_from_[static_cast<std::size_t>(port)] = message.press_from[static_cast<std::size_t>(port)];
+        join_press_from_[static_cast<std::size_t>(cfg_.local_port)] = local_first_ + kJoinStartDelay;
+        log("the host lets this machine play live from frame %llu: its input counts from frame %llu, input delay %u frames", ull(join_frame_), ull(local_first_), delay_);
+    }
+    if (message.base <= history_.end())
+        for (std::uint64_t i = history_.end() - message.base; i < message.records.size(); ++i) history_.add(message.records[static_cast<std::size_t>(i)]);
+    send_history_ack(true);
+}
+
+void Session::send_history_ack(bool force) {
+    const std::uint64_t now = now_ms();
+    if (!force && now - ack_sent_ < kAckEveryMs) return;
+    ack_sent_ = now;
+    Writer w(kMsgHistoryAck);
+    write_history_ack(w, {history_.end(), current_frame_, replay_fps_});
+    for (Peer &peer : peers_) peer.link->send(w.bytes().data(), w.bytes().size());
+}
+
+// One frame of the replay: what the host applied then, applied here.
+void Session::apply_record(std::uint64_t frame, const FrameRecord &record) {
+    if (record.has_digest) {
+        const Hashes mine = hooks_.hashes();
+        if (!(mine == record.digest)) {
+            log("DESYNC while catching up at frame %llu: this machine's game differs from the host's at the same frame (ee %016llx against %016llx)", ull(frame), ull(mine.ee), ull(record.digest.ee));
+            send_bye(kByeDesync, frame);
+            fail(Outcome::desync, "the replay of the host's game differs at frame " + std::to_string(frame));
+            return;
+        }
+    }
+    for (int port = 1; port < cfg_.players; ++port) {
+        const std::size_t p = static_cast<std::size_t>(port);
+        const bool plugged = (record.plugged >> port) & 1;
+        if (plugged == plugged_[p]) continue;
+        plugged_[p] = plugged;
+        hooks_.plug(port, plugged);
+    }
+    for (int port = 0; port < cfg_.players; ++port) hooks_.apply(port, record.pads[static_cast<std::size_t>(port)]);
+}
+
+// Runs at every vblank while catching up. False: this frame was replayed (or the session failed). True: this frame is at or past the one the host chose to play live from.
+bool Session::replay(std::uint64_t frame) {
+    for (;;) {
+        pump(0);
+        if (outcome_ != Outcome::running) return false;
+        if (join_frame_ && frame >= join_frame_) {
+            catching_up_ = false;
+            history_.stop();
+            log("caught up at frame %llu: playing live (%u frames per second while catching up)", ull(frame), replay_fps_);
+            return true;
+        }
+        if (const FrameRecord *record = history_.at(frame)) {
+            apply_record(frame, *record);
+            history_.discard_before(frame + 1);
+            ++stats_.frames;
+            const std::uint64_t now = now_ms();
+            if (now - replay_marked_ >= kReplayRateWindowMs) {
+                replay_fps_ = replay_marked_ ? static_cast<std::uint32_t>((frame - replay_marked_frame_) * 1000 / (now - replay_marked_)) : 0;
+                replay_marked_ = now;
+                replay_marked_frame_ = frame;
+            }
+            send_history_ack(false);
+            if (now - replay_logged_ >= kReplayLogMs) {
+                replay_logged_ = now;
+                log("catching up: replayed to frame %llu of the %llu the host has sent (%u frames per second)", ull(frame), ull(history_.end()), replay_fps_);
+            }
+            return false;
+        }
+        const std::uint64_t now = now_ms();
+        if (hooks_.halted()) return false;
+        if (now - catchup_started_ > kCatchupLimitMs) {
+            fail(Outcome::timeout, "this machine did not catch up with the game within " + std::to_string(kCatchupLimitMs / 1000) + " s");
+            return false;
+        }
+        if (now - catchup_heard_ > kCatchupSilenceMs) {
+            fail(Outcome::timeout, "the host sent nothing to catch up with for " + std::to_string(kCatchupSilenceMs / 1000) + " s");
+            return false;
+        }
+        send_history_ack(false);
+        pump(kPollMs);
+        if (outcome_ != Outcome::running) return false;
+    }
+}
+
+}
diff --git a/runtime/src/netplay/sim_transport.cpp b/runtime/src/netplay/sim_transport.cpp
new file mode 100644
index 0000000..2e2ffa0
--- /dev/null
+++ b/runtime/src/netplay/sim_transport.cpp
@@ -0,0 +1,92 @@
+#include "sim_transport.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace ps2::netplay {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+constexpr std::chrono::microseconds kReleaseStep{500};   // how often a held message is checked for being due
+
+// A message leaves when its delay is up, whatever the machine is doing meanwhile: a thread releases them, so the delay is the link's and not "until the game next looks at the
+// network" (a game that sleeps between frames would otherwise add a frame to every hop).
+class SimTransport : public Transport {
+public:
+    SimTransport(std::unique_ptr<Transport> inner, const SimLink &link, std::uint32_t seed) : inner_(std::move(inner)), link_(link), rng_(seed | 1u), releaser_([this] { release_loop(); }) {}
+
+    ~SimTransport() override {
+        stop_ = true;
+        releaser_.join();
+    }
+
+    void send(const std::uint8_t *data, std::size_t size) override {
+        if (chance(link_.loss_percent)) return;
+        int delay = link_.delay_ms;
+        if (link_.jitter_ms > 0) delay += static_cast<int>(next() % static_cast<std::uint32_t>(link_.jitter_ms + 1));
+        const std::lock_guard<std::mutex> lock(mutex_);
+        queue_.push_back({Clock::now() + std::chrono::milliseconds(delay), std::vector<std::uint8_t>(data, data + size)});
+    }
+
+    int recv(std::uint8_t *buffer, std::size_t capacity, int timeout_ms) override { return inner_->recv(buffer, capacity, timeout_ms); }
+
+    std::string peer_name() const override { return inner_->peer_name(); }
+
+private:
+    struct Held {
+        Clock::time_point due;
+        std::vector<std::uint8_t> bytes;
+    };
+
+    std::uint32_t next() {
+        const std::lock_guard<std::mutex> lock(random_mutex_);
+        rng_ ^= rng_ << 13;
+        rng_ ^= rng_ >> 17;
+        rng_ ^= rng_ << 5;
+        return rng_;
+    }
+    bool chance(double percent) { return percent > 0 && next() % 100000u < static_cast<std::uint32_t>(percent * 1000.0); }
+
+    void release_loop() {
+        while (!stop_) {
+            std::this_thread::sleep_for(kReleaseStep);
+            std::vector<Held> due;
+            {
+                const std::lock_guard<std::mutex> lock(mutex_);
+                const Clock::time_point now = Clock::now();
+                for (auto it = queue_.begin(); it != queue_.end();) {
+                    if (it->due <= now) {
+                        due.push_back(std::move(*it));
+                        it = queue_.erase(it);
+                    } else {
+                        ++it;
+                    }
+                }
+            }
+            for (const Held &held : due) inner_->send(held.bytes.data(), held.bytes.size());
+        }
+    }
+
+    std::unique_ptr<Transport> inner_;
+    SimLink link_;
+    std::uint32_t rng_;
+    std::mutex random_mutex_, mutex_;
+    std::deque<Held> queue_;
+    std::atomic<bool> stop_{false};
+    std::thread releaser_;
+};
+
+}
+
+std::unique_ptr<Transport> make_sim_transport(std::unique_ptr<Transport> inner, const SimLink &link, std::uint32_t seed) {
+    return std::make_unique<SimTransport>(std::move(inner), link, seed);
+}
+
+}
diff --git a/runtime/src/netplay/sim_transport.hpp b/runtime/src/netplay/sim_transport.hpp
new file mode 100644
index 0000000..4aa0792
--- /dev/null
+++ b/runtime/src/netplay/sim_transport.hpp
@@ -0,0 +1,20 @@
+#pragma once
+
+#include "transport.hpp"
+
+#include <memory>
+
+namespace ps2::netplay {
+
+struct SimLink {
+    double loss_percent = 0;     // chance that an outgoing message is dropped
+    int delay_ms = 0;            // fixed extra one-way delay on outgoing messages
+    int jitter_ms = 0;           // plus a random 0..jitter_ms (can reorder messages)
+    bool active() const { return loss_percent > 0 || delay_ms > 0 || jitter_ms > 0; }
+};
+
+// Wraps a transport and degrades what it sends, so latency and loss can be tested on one PC. Give both machines
+// the same options for a symmetric link.
+std::unique_ptr<Transport> make_sim_transport(std::unique_ptr<Transport> inner, const SimLink &link, std::uint32_t seed);
+
+}
diff --git a/runtime/src/netplay/snapshot.cpp b/runtime/src/netplay/snapshot.cpp
new file mode 100644
index 0000000..219de8e
--- /dev/null
+++ b/runtime/src/netplay/snapshot.cpp
@@ -0,0 +1,220 @@
+#include "snapshot.hpp"
+
+#include "log.hpp"
+
+#include <algorithm>
+
+// Reliable transfer of the join snapshot over a lossy datagram link: the host keeps a window of chunks in flight and
+// resends each one that stays unacknowledged; the joiner acknowledges with the first missing chunk plus a bitmap.
+namespace ps2::netplay {
+
+namespace {
+
+constexpr std::size_t kChunkBytes = 1200;
+constexpr std::uint32_t kWindowChunks = 512;
+constexpr std::uint32_t kMinBurstBytes = 64 * 1024;    // most a paced upload sends in one step after a quiet spell, or a quarter second of its rate if that is more
+constexpr std::uint32_t kBurstDivisor = 4;
+constexpr std::size_t kBitmapBytes = kWindowChunks / 8;
+constexpr std::uint64_t kResendMs = 400;
+constexpr std::uint64_t kHelloMs = 500;
+constexpr std::uint64_t kJoinTimeoutMs = 120000;
+constexpr std::uint64_t kTransferStallMs = 20000;
+constexpr std::uint32_t kAckEveryChunks = 16;
+constexpr int kPollMs = 10;
+constexpr int kFinalAcks = 3;
+constexpr std::size_t kMaxKeptOther = 64;   // messages other than acknowledgements an upload keeps for its caller
+
+void send(Transport &link, const Writer &w) { link.send(w.bytes().data(), w.bytes().size()); }
+
+}
+
+SnapshotUploader::SnapshotUploader(Transport &link, const Terms &terms, std::vector<std::uint8_t> packed, std::uint32_t bytes_per_second)
+    : link_(link), terms_(terms), packed_(std::move(packed)), rate_(bytes_per_second), chunks_(static_cast<std::uint32_t>((packed_.size() + kChunkBytes - 1) / kChunkBytes)),
+      acked_(chunks_, 0), sent_at_(chunks_, 0), progress_at_(now_ms()), started_(progress_at_), refilled_at_(progress_at_), budget_(static_cast<double>(burst())) {}
+
+std::uint64_t SnapshotUploader::bytes_acked() const { return std::min<std::uint64_t>(packed_.size(), static_cast<std::uint64_t>(base_) * kChunkBytes); }
+
+std::uint32_t SnapshotUploader::burst() const { return std::max(kMinBurstBytes, rate_ / kBurstDivisor); }
+
+SnapshotUploader::State SnapshotUploader::step(int wait_ms) {
+    if (base_ >= chunks_ && begin_acknowledged_) return State::done;
+    const std::uint64_t now = now_ms();
+    if (now - progress_at_ > kTransferStallMs) {
+        log("snapshot upload stopped: no acknowledgement from %s for %llu s", link_.peer_name().c_str(), ull(kTransferStallMs / 1000));
+        return State::failed;
+    }
+    if (rate_) budget_ = std::min<double>(burst(), budget_ + static_cast<double>(rate_) * static_cast<double>(now - refilled_at_) / 1000.0);
+    refilled_at_ = now;
+    if (!begin_acknowledged_ && now - begin_sent_ >= kResendMs) {
+        Writer w(kMsgSnapBegin);
+        w.u64(terms_.frame).u32(terms_.raw_bytes).u32(static_cast<std::uint32_t>(packed_.size())).u32(chunks_).u16(terms_.delay).u16(terms_.digest_every).u8(terms_.slot).u8(terms_.players).u8(terms_.late).u8(terms_.cold).u8(terms_.auto_join).u8(terms_.plugged).u8(terms_.friendly_fire).u8(terms_.split_screen);
+        put_hashes(w, terms_.hashes);
+        for (const PadSample &pad : terms_.pads) put_sample(w, pad);
+        send(link_, w);
+        begin_sent_ = now;
+    }
+    for (std::uint32_t i = base_; i < std::min(chunks_, base_ + kWindowChunks); ++i) {
+        if (acked_[i] || (sent_at_[i] && now - sent_at_[i] < kResendMs)) continue;
+        const std::size_t offset = static_cast<std::size_t>(i) * kChunkBytes;
+        const std::size_t bytes = std::min(kChunkBytes, packed_.size() - offset);
+        if (rate_ && budget_ < static_cast<double>(bytes)) break;
+        Writer w(kMsgSnapChunk);
+        w.u32(i).raw(packed_.data() + offset, bytes);
+        send(link_, w);
+        sent_at_[i] = now;
+        budget_ -= static_cast<double>(bytes);
+    }
+    std::uint8_t buffer[kMaxMessage];
+    for (int n = link_.recv(buffer, sizeof buffer, wait_ms); n > 0; n = link_.recv(buffer, sizeof buffer, 0)) {
+        Reader r(buffer, static_cast<std::size_t>(n));
+        if (r.type() != kMsgSnapAck) {
+            if (r.type() != kMsgHello && other_.size() < kMaxKeptOther) other_.emplace_back(buffer, buffer + n);
+            continue;
+        }
+        const std::uint32_t from = r.u32();
+        std::uint8_t bitmap[kBitmapBytes];
+        r.raw(bitmap, sizeof bitmap);
+        if (!r.ok() || from > chunks_) continue;
+        begin_acknowledged_ = true;
+        for (std::uint32_t i = 0; i < from; ++i) acked_[i] = 1;
+        for (std::uint32_t i = 0; i < kWindowChunks && from + i < chunks_; ++i)
+            if (bitmap[i / 8] & (1u << (i % 8))) acked_[from + i] = 1;
+        const std::uint32_t previous = base_;
+        while (base_ < chunks_ && acked_[base_]) ++base_;
+        if (base_ != previous) progress_at_ = now_ms();
+        const int done = percent();
+        if (chunks_ && done / 10 > last_logged_ / 10) log("snapshot upload %d%% (%u of %u chunks acknowledged)", done, base_, chunks_);
+        last_logged_ = done;
+        wait_ms = 0;
+    }
+    if (base_ < chunks_ || !begin_acknowledged_) return State::running;
+    if (chunks_) log("snapshot delivered: %zu bytes packed in %u chunks, %llu ms", packed_.size(), chunks_, ull(now_ms() - started_));
+    return State::done;
+}
+
+bool upload_snapshot(Transport &link, const Terms &terms, const std::vector<std::uint8_t> &packed, const Abort &aborted, const Progress &progress) {
+    SnapshotUploader upload(link, terms, packed, 0);
+    int last_percent = -1;
+    for (;;) {
+        if (aborted()) return false;
+        const SnapshotUploader::State state = upload.step(kPollMs);
+        if (progress && upload.percent() != last_percent) {
+            last_percent = upload.percent();
+            progress(upload.bytes_acked(), upload.bytes_total());
+        }
+        if (state != SnapshotUploader::State::running) return state == SnapshotUploader::State::done;
+    }
+}
+
+bool download_snapshot(Transport &link, const Fingerprint &build, Terms &terms, std::vector<std::uint8_t> &packed, std::string &rejection, const Abort &aborted,
+                       const Progress &progress, std::uint8_t wanted_slot) {
+    std::uint8_t buffer[kMaxMessage];
+    const std::uint64_t started = now_ms();
+    std::uint64_t hello_sent = 0, reported = started;
+    unsigned attempts = 0;
+    std::uint32_t chunks = 0, packed_bytes = 0;
+    bool begun = false;
+
+    while (!begun) {
+        if (aborted()) return false;
+        const std::uint64_t now = now_ms();
+        if (now - started > kJoinTimeoutMs) {
+            log("no answer from host %s after %llu s, giving up", link.peer_name().c_str(), ull(kJoinTimeoutMs / 1000));
+            return false;
+        }
+        if (now - hello_sent >= kHelloMs) {
+            Writer w(kMsgHello);
+            build.write(w);
+            w.u8(wanted_slot);
+            send(link, w);
+            hello_sent = now;
+            if (++attempts == 1 || now - reported >= 2000) {
+                log("connecting to host %s (attempt %u)", link.peer_name().c_str(), attempts);
+                reported = now;
+            }
+        }
+        const int n = link.recv(buffer, sizeof buffer, kPollMs);
+        if (n <= 0) continue;
+        Reader r(buffer, static_cast<std::size_t>(n));
+        if (r.type() == kMsgReject) {
+            rejection = r.str();
+            log("host refused the connection: %s", rejection.c_str());
+            return false;
+        }
+        if (r.type() != kMsgSnapBegin) continue;
+        terms.frame = r.u64();
+        terms.raw_bytes = r.u32();
+        packed_bytes = r.u32();
+        chunks = r.u32();
+        terms.delay = r.u16();
+        terms.digest_every = r.u16();
+        terms.slot = r.u8();
+        terms.players = r.u8();
+        terms.late = r.u8();
+        terms.cold = r.u8();
+        terms.auto_join = r.u8();
+        terms.plugged = r.u8();
+        terms.friendly_fire = r.u8();
+        terms.split_screen = r.u8();
+        terms.hashes = get_hashes(r);
+        for (PadSample &pad : terms.pads) pad = get_sample(r);
+        if (!r.ok()) continue;
+        begun = true;
+    }
+    log("host answered: you are player %u of %u, snapshot of frame %llu, %u bytes unpacked, %u bytes packed in %u chunks, input delay %u frames, digest every %u frames",
+        terms.slot + 1u, terms.players, ull(terms.frame), terms.raw_bytes, packed_bytes, chunks, terms.delay, terms.digest_every);
+
+    packed.assign(packed_bytes, 0);
+    std::vector<std::uint8_t> have(chunks, 0);
+    std::uint32_t base = 0, received = 0, since_ack = 0, last_percent = 0;
+    std::uint64_t progress_at = now_ms();
+    const auto acknowledge = [&] {
+        Writer w(kMsgSnapAck);
+        w.u32(base);
+        std::uint8_t bitmap[kBitmapBytes] = {};
+        for (std::uint32_t i = 0; i < kWindowChunks && base + i < chunks; ++i)
+            if (have[base + i]) bitmap[i / 8] |= static_cast<std::uint8_t>(1u << (i % 8));
+        w.raw(bitmap, sizeof bitmap);
+        send(link, w);
+        since_ack = 0;
+    };
+    acknowledge();
+    while (base < chunks) {
+        if (aborted()) return false;
+        if (now_ms() - progress_at > kTransferStallMs) {
+            log("snapshot download stopped: nothing from the host for %llu s", ull(kTransferStallMs / 1000));
+            return false;
+        }
+        const int n = link.recv(buffer, sizeof buffer, kPollMs);
+        if (n <= 0) {
+            if (since_ack) acknowledge();
+            continue;
+        }
+        Reader r(buffer, static_cast<std::size_t>(n));
+        if (r.type() == kMsgSnapBegin) {
+            acknowledge();
+            continue;
+        }
+        if (r.type() != kMsgSnapChunk) continue;
+        const std::uint32_t index = r.u32();
+        const std::size_t offset = static_cast<std::size_t>(index) * kChunkBytes;
+        if (!r.ok() || index >= chunks || offset + r.left() > packed.size()) continue;
+        progress_at = now_ms();
+        if (!have[index]) {
+            std::copy(r.cursor(), r.cursor() + r.left(), packed.begin() + static_cast<std::ptrdiff_t>(offset));
+            have[index] = 1;
+            ++received;
+        }
+        while (base < chunks && have[base]) ++base;
+        if (++since_ack >= kAckEveryChunks) acknowledge();
+        const std::uint32_t percent = received * 100 / chunks;
+        if (percent / 10 > last_percent / 10) log("snapshot download %u%% (%u of %u chunks)", percent, received, chunks);
+        if (progress && percent != last_percent) progress(std::min<std::uint64_t>(packed.size(), static_cast<std::uint64_t>(received) * kChunkBytes), packed.size());
+        last_percent = percent;
+    }
+    for (int i = 0; i < kFinalAcks; ++i) acknowledge();
+    if (chunks) log("snapshot received: %zu bytes packed in %llu ms", packed.size(), ull(now_ms() - started));
+    return true;
+}
+
+}
diff --git a/runtime/src/netplay/snapshot.hpp b/runtime/src/netplay/snapshot.hpp
new file mode 100644
index 0000000..b8547e7
--- /dev/null
+++ b/runtime/src/netplay/snapshot.hpp
@@ -0,0 +1,76 @@
+#pragma once
+
+#include "fingerprint.hpp"
+#include "transport.hpp"
+#include "wire.hpp"
+
+#include <functional>
+#include <vector>
+
+namespace ps2::netplay {
+
+// What the host decides at the snapshot frame and tells the joiner.
+constexpr std::uint8_t kLeaveAlone = 0xFF;   // Terms::friendly_fire and Terms::split_screen when the host has no setting to give
+
+struct Terms {
+    std::uint64_t frame = 0;          // frame the snapshot was taken at; lockstep starts at frame + 1
+    std::uint32_t raw_bytes = 0;      // size of the machine state once unpacked
+    std::uint16_t delay = 0;          // input delay in frames
+    std::uint16_t digest_every = 0;   // frames between digest exchanges
+    std::uint8_t slot = 0;            // controller port the receiving joiner plays on (1 to players - 1)
+    std::uint8_t players = 2;         // players in the session, host included
+    std::uint8_t late = 0;            // 1 when the game is already running in lockstep and this joiner takes a free port
+    std::uint8_t cold = 0;            // 1 when every machine starts from boot (no snapshot: raw_bytes is 0 and the joiner's own freshly booted machine is the state)
+    std::uint8_t auto_join = 1;       // 1 when the session presses START on a joiner's pad so the game's second player drops in; 0 when the players do it themselves
+    std::uint8_t friendly_fire = kLeaveAlone;   // the host's friendly fire setting (0 or 1) every machine writes to the game before the session starts; kLeaveAlone: the host had no session file
+    std::uint8_t split_screen = kLeaveAlone;    // the host's split screen setting (0 auto, 1 always split) every machine writes to the game before the session starts; kLeaveAlone: the host had no session file
+    std::uint8_t plugged = 0;         // bit p: pad p was plugged in on the host at `frame`; the controllers of pads 2 and 3 are not in the machine state
+    PadSample pads[2];                // what pads 2 and 3 (the runtime's pads beyond the two SIO2 ports) read at `frame`
+    Hashes hashes;                    // memory hashes of the machine at `frame`
+};
+
+using Abort = std::function<bool()>;
+// Called with the bytes of the packed snapshot transferred and its size, each time the whole percent changes, for the screens that show the transfer.
+using Progress = std::function<void(std::uint64_t done, std::uint64_t total)>;
+
+// Joiner: says HELLO (with the controller port the launcher's roster gave it, `wanted_slot`) until the host answers, then downloads the snapshot. False (reason logged) on reject, timeout or abort; `rejection` then holds the host's
+// words when it refused the connection (a different build, a full game) and is empty otherwise.
+bool download_snapshot(Transport &link, const Fingerprint &build, Terms &terms, std::vector<std::uint8_t> &packed, std::string &rejection, const Abort &aborted,
+                       const Progress &progress = {}, std::uint8_t wanted_slot = kAnySlot);
+
+// Host: uploads an already packed snapshot (terms.slot says which joiner it is for) a step at a time, so the game can go on between steps.
+class SnapshotUploader {
+public:
+    enum class State { running, done, failed };
+
+    // bytes_per_second 0: as fast as the link takes it.
+    SnapshotUploader(Transport &link, const Terms &terms, std::vector<std::uint8_t> packed, std::uint32_t bytes_per_second);
+    // Sends what is due, then takes the acknowledgements waiting (waiting up to wait_ms for the first). `failed` (reason logged) when the joiner stops answering.
+    State step(int wait_ms);
+    int percent() const { return chunks_ ? static_cast<int>(base_ * 100 / chunks_) : 100; }
+    std::uint64_t bytes_acked() const;
+    std::uint64_t bytes_total() const { return packed_.size(); }
+    // The messages that were not acknowledgements (the joiner's READY can arrive before the last acknowledgement is read), in the order they came.
+    std::vector<std::vector<std::uint8_t>> take_other() { return std::move(other_); }
+
+private:
+    std::uint32_t burst() const;
+    Transport &link_;
+    Terms terms_;
+    std::vector<std::uint8_t> packed_;
+    std::uint32_t rate_;
+    std::uint32_t chunks_, base_ = 0;
+    std::vector<std::uint8_t> acked_;
+    std::vector<std::uint64_t> sent_at_;
+    std::vector<std::vector<std::uint8_t>> other_;
+    bool begin_acknowledged_ = false;
+    std::uint64_t begin_sent_ = 0, progress_at_, started_, refilled_at_;
+    double budget_;
+    int last_logged_ = 0;
+};
+
+// Host: the same, all at once, for a snapshot nobody plays meanwhile. False (reason logged) when the joiner stops answering or abort is true.
+bool upload_snapshot(Transport &link, const Terms &terms, const std::vector<std::uint8_t> &packed, const Abort &aborted,
+                     const Progress &progress = {});
+
+}
diff --git a/runtime/src/netplay/status_file.cpp b/runtime/src/netplay/status_file.cpp
new file mode 100644
index 0000000..45e0797
--- /dev/null
+++ b/runtime/src/netplay/status_file.cpp
@@ -0,0 +1,164 @@
+#include "status_file.hpp"
+
+#include "log.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <filesystem>
+#include <mutex>
+
+namespace ps2::netplay::status {
+
+namespace {
+
+constexpr std::size_t kMaxMission = 12, kMaxText = 24, kMaxReason = 100;   // the contract's limits
+
+struct Record {
+    Stage stage = Stage::booting;
+    std::string mission, text;
+    bool counted = false;
+    std::uint64_t done = 0, total = 0;
+    Unit unit = Unit::bytes;
+    std::string error, reason;
+};
+
+std::mutex g_mutex;
+std::string g_path;
+Record g_record;
+std::string g_written;                  // the last line written, so an unchanged record writes nothing
+std::uint64_t g_written_at = 0;
+bool g_pending = false;                 // a count changed inside the rate limit and is not written yet
+
+const char *stage_word(Stage stage) {
+    switch (stage) {
+    case Stage::booting: return "booting";
+    case Stage::lobby: return "lobby";
+    case Stage::connecting: return "connecting";
+    case Stage::receiving: return "receiving";
+    case Stage::sending: return "sending";
+    case Stage::loading: return "loading";
+    case Stage::playing: return "playing";
+    case Stage::closed: return "closed";
+    }
+    return "booting";
+}
+
+const char *unit_word(Unit unit) {
+    switch (unit) {
+    case Unit::bytes: return "bytes";
+    case Unit::items: return "items";
+    case Unit::players: return "players";
+    }
+    return "items";
+}
+
+// A value never holds ';' or '=', and never a line break; printable ASCII only, cut to `limit`.
+std::string clean(const std::string &value, std::size_t limit) {
+    std::string out;
+    for (const char ch : value) {
+        if (out.size() >= limit) break;
+        out += ch == ';' ? ',' : ch == '=' ? ':' : (ch >= ' ' && ch < 127) ? ch : '?';
+    }
+    return out;
+}
+
+std::string line_of(const Record &r) {
+    std::string line = std::string("stage=") + stage_word(r.stage);
+    if (r.counted) {
+        line += ";done=" + std::to_string(r.done);
+        if (r.total) line += ";total=" + std::to_string(r.total);
+        line += std::string(";unit=") + unit_word(r.unit);
+    }
+    if (!r.mission.empty()) line += ";mission=" + clean(r.mission, kMaxMission);
+    if (!r.text.empty()) line += ";text=" + clean(r.text, kMaxText);
+    if (!r.error.empty()) line += ";error=" + clean(r.error, kMaxReason) + ";reason=" + clean(r.reason, kMaxReason);
+    return line;
+}
+
+void write_locked() {
+    g_pending = false;
+    if (g_path.empty()) return;
+    const std::string line = line_of(g_record);
+    if (line == g_written) return;
+    const std::string temp = g_path + ".tmp";
+    if (std::FILE *file = std::fopen(temp.c_str(), "wb")) {
+        std::fprintf(file, "%s\n", line.c_str());
+        std::fclose(file);
+        std::error_code error;
+        std::filesystem::rename(temp, g_path, error);
+        if (error) {
+            std::filesystem::remove(g_path, error);
+            std::filesystem::rename(temp, g_path, error);
+        }
+        if (error) {
+            log("status file %s could not be written: %s", g_path.c_str(), error.message().c_str());
+            return;
+        }
+        g_written = line;
+        g_written_at = now_ms();
+    }
+}
+
+}
+
+void open(const std::string &path) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_path = path;
+    g_record = {};
+    g_written.clear();
+    write_locked();
+}
+
+Stage current() {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_record.stage;
+}
+
+void set_stage(Stage stage, const std::string &mission, const std::string &text) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_record = {};
+    g_record.stage = stage;
+    g_record.mission = mission;
+    g_record.text = text;
+    write_locked();
+}
+
+void set_counts(std::uint64_t done, std::uint64_t total, Unit unit) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (total && done > total) done = total;
+    if (g_record.counted && done < g_record.done && g_record.unit == unit) done = g_record.done;   // a count never goes down inside a stage
+    g_record.counted = true;
+    g_record.done = done;
+    g_record.total = total;
+    g_record.unit = unit;
+    if (now_ms() - g_written_at >= kCountIntervalMs) write_locked();
+    else g_pending = true;
+}
+
+void set_error(const std::string &code, const std::string &reason) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_record.error = code;
+    g_record.reason = reason;
+    write_locked();
+}
+
+void clear_error() {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_record.error.clear();
+    g_record.reason.clear();
+    write_locked();
+}
+
+void tick() {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    if (g_pending && now_ms() - g_written_at >= kCountIntervalMs) write_locked();
+}
+
+void close() {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_record = {};
+    g_record.stage = Stage::closed;
+    write_locked();
+}
+
+}
diff --git a/runtime/src/netplay/status_file.hpp b/runtime/src/netplay/status_file.hpp
new file mode 100644
index 0000000..b87eb18
--- /dev/null
+++ b/runtime/src/netplay/status_file.hpp
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// The status channel to the launcher (design\STATUS_CONTRACT.md): one line of `key=value;key=value` in the file the launcher names (`status_file` in the
+// session file), written whole by temp file and replace. What the game is doing now (stage), how far it is with real counts (bytes read from the disc or received
+// from the host, files, players, never a timer), and a plain sentence when something failed. Without a path nothing is written. Display only: never read by the
+// game, so no digest can depend on it.
+namespace ps2::netplay::status {
+
+enum class Stage { booting, lobby, connecting, receiving, sending, loading, playing, closed };
+enum class Unit { bytes, items, players };
+
+// The stage the file says now.
+Stage current();
+
+// The file to write (empty: write nothing). Call once, as soon as the session file is read.
+void open(const std::string &path);
+
+// A new stage at once, with the mission number as the player sees it (loading, playing) or the name of the player a game is sent to (sending). Counts and error are cleared.
+void set_stage(Stage stage, const std::string &mission = {}, const std::string &text = {});
+// The real count of the stage. A total of 0 writes no total (no percent). Written at most every kCountIntervalMs while the count moves.
+void set_counts(std::uint64_t done, std::uint64_t total, Unit unit);
+
+// A failure that leaves the game running: `code` is a launcher RefusalKind name, `reason` a sentence a player can act on.
+void set_error(const std::string &code, const std::string &reason);
+void clear_error();
+
+// Writes a count that was held back by the rate limit once its interval is over. Called every vblank.
+void tick();
+// The last write before a deliberate exit.
+void close();
+
+constexpr std::uint64_t kCountIntervalMs = 250;
+
+}
diff --git a/runtime/src/netplay/transport.hpp b/runtime/src/netplay/transport.hpp
new file mode 100644
index 0000000..d8656c0
--- /dev/null
+++ b/runtime/src/netplay/transport.hpp
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace ps2::netplay {
+
+// Moves datagrams between the two machines. UDP is one implementation; the co-op launcher link (message types
+// 0x0400-0x04FF) is meant to be another. Messages are small except snapshot chunks; delivery may be lossy and unordered.
+class Transport {
+public:
+    virtual ~Transport() = default;
+    // Fire and forget. Silently does nothing while the peer's address is still unknown.
+    virtual void send(const std::uint8_t *data, std::size_t size) = 0;
+    // Waits up to timeout_ms for one message. Returns its size, 0 on timeout, -1 when the link is broken.
+    virtual int recv(std::uint8_t *buffer, std::size_t capacity, int timeout_ms) = 0;
+    virtual std::string peer_name() const = 0;
+};
+
+constexpr std::size_t kMaxMessage = 1400;
+
+}
diff --git a/runtime/src/netplay/udp_transport.cpp b/runtime/src/netplay/udp_transport.cpp
new file mode 100644
index 0000000..2324eb7
--- /dev/null
+++ b/runtime/src/netplay/udp_transport.cpp
@@ -0,0 +1,271 @@
+#include "udp_transport.hpp"
+
+#include <cstdio>
+#include <cstring>
+
+#ifdef __EMSCRIPTEN__
+
+namespace ps2::netplay {
+std::unique_ptr<HostSocket> open_udp_host(const std::string &, std::uint16_t) { std::fprintf(stderr, "[net] UDP netplay is not available in the web build\n"); return nullptr; }
+std::unique_ptr<Transport> open_udp_joiner(const std::string &, std::uint16_t) { std::fprintf(stderr, "[net] UDP netplay is not available in the web build\n"); return nullptr; }
+}
+
+#else
+
+#include <deque>
+#include <vector>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+using Socket = SOCKET;
+constexpr Socket kInvalid = INVALID_SOCKET;
+inline void close_socket(Socket s) { closesocket(s); }
+inline int last_error() { return WSAGetLastError(); }
+#else
+#include <arpa/inet.h>
+#include <netdb.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+using Socket = int;
+constexpr Socket kInvalid = -1;
+inline void close_socket(Socket s) { close(s); }
+inline int last_error() { return errno; }
+#endif
+
+namespace ps2::netplay {
+
+namespace {
+
+constexpr int kSocketBufferBytes = 4 << 20;
+constexpr std::size_t kMaxPeers = 8;       // addresses the host remembers, joiners and refused players together
+constexpr std::size_t kMaxQueuedPerPeer = 256;
+
+bool same_address(const sockaddr_in &a, const sockaddr_in &b) { return a.sin_addr.s_addr == b.sin_addr.s_addr && a.sin_port == b.sin_port; }
+
+std::string address_text(const sockaddr_in &a) {
+    char text[INET_ADDRSTRLEN] = {};
+    inet_ntop(AF_INET, &a.sin_addr, text, sizeof text);
+    return std::string(text) + ":" + std::to_string(ntohs(a.sin_port));
+}
+
+// A bound IPv4 datagram socket.
+class UdpSocket {
+public:
+    ~UdpSocket() {
+        if (socket_ != kInvalid) close_socket(socket_);
+    }
+
+    bool open(const std::string &bind_address, std::uint16_t bind_port) {
+#ifdef _WIN32
+        WSADATA data;
+        if (WSAStartup(MAKEWORD(2, 2), &data) != 0) return fail("WSAStartup");
+#endif
+        socket_ = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+        if (socket_ == kInvalid) return fail("socket");
+        const int size = kSocketBufferBytes;
+        setsockopt(socket_, SOL_SOCKET, SO_RCVBUF, reinterpret_cast<const char *>(&size), sizeof size);
+        setsockopt(socket_, SOL_SOCKET, SO_SNDBUF, reinterpret_cast<const char *>(&size), sizeof size);
+#ifdef _WIN32
+        // An ICMP "port unreachable" for an earlier datagram must not turn into a recv error.
+        DWORD returned = 0;
+        BOOL off = FALSE;
+        WSAIoctl(socket_, _WSAIOW(IOC_VENDOR, 12), &off, sizeof off, nullptr, 0, &returned, nullptr, nullptr);
+#endif
+        sockaddr_in local{};
+        local.sin_family = AF_INET;
+        local.sin_port = htons(bind_port);
+        if (inet_pton(AF_INET, bind_address.c_str(), &local.sin_addr) != 1) return fail(("bad bind address " + bind_address).c_str());
+        if (::bind(socket_, reinterpret_cast<sockaddr *>(&local), sizeof local) != 0) return fail(("bind " + bind_address + ":" + std::to_string(bind_port)).c_str());
+        return true;
+    }
+
+    static bool resolve(const std::string &host, std::uint16_t port, sockaddr_in &out) {
+        addrinfo hints{}, *found = nullptr;
+        hints.ai_family = AF_INET;
+        hints.ai_socktype = SOCK_DGRAM;
+        if (getaddrinfo(host.c_str(), std::to_string(port).c_str(), &hints, &found) != 0 || !found) {
+            std::fprintf(stderr, "[net] cannot resolve %s\n", host.c_str());
+            return false;
+        }
+        std::memcpy(&out, found->ai_addr, sizeof out);
+        freeaddrinfo(found);
+        return true;
+    }
+
+    void send_to(const sockaddr_in &to, const std::uint8_t *data, std::size_t size) {
+        ::sendto(socket_, reinterpret_cast<const char *>(data), static_cast<int>(size), 0, reinterpret_cast<const sockaddr *>(&to), sizeof to);
+    }
+
+    // One datagram or nothing within timeout_ms. Returns its size, 0 on timeout.
+    int receive(std::uint8_t *buffer, std::size_t capacity, int timeout_ms, sockaddr_in &from) {
+        fd_set readable;
+        FD_ZERO(&readable);
+        FD_SET(socket_, &readable);
+        timeval wait{timeout_ms / 1000, (timeout_ms % 1000) * 1000};
+        if (select(static_cast<int>(socket_) + 1, &readable, nullptr, nullptr, &wait) <= 0) return 0;
+#ifdef _WIN32
+        int from_size = sizeof from;
+#else
+        socklen_t from_size = sizeof from;
+#endif
+        const int n = static_cast<int>(::recvfrom(socket_, reinterpret_cast<char *>(buffer), static_cast<int>(capacity), 0, reinterpret_cast<sockaddr *>(&from), &from_size));
+        return n < 0 ? 0 : n;
+    }
+
+private:
+    bool fail(const char *what) {
+        std::fprintf(stderr, "[net] socket error in %s (code %d)\n", what, last_error());
+        return false;
+    }
+
+    Socket socket_ = kInvalid;
+};
+
+// A joiner's link to the host: one fixed peer address.
+class JoinerTransport : public Transport {
+public:
+    bool open(const std::string &bind_address, const std::string &host, std::uint16_t port) { return socket_.open(bind_address, 0) && UdpSocket::resolve(host, port, host_); }
+
+    void send(const std::uint8_t *data, std::size_t size) override { socket_.send_to(host_, data, size); }
+
+    int recv(std::uint8_t *buffer, std::size_t capacity, int timeout_ms) override {
+        sockaddr_in from{};
+        return socket_.receive(buffer, capacity, timeout_ms, from);
+    }
+
+    std::string peer_name() const override { return address_text(host_); }
+
+private:
+    UdpSocket socket_;
+    sockaddr_in host_{};
+};
+
+class UdpHost;
+
+class PeerLink : public Transport {
+public:
+    PeerLink(UdpHost &host, int peer) : host_(host), peer_(peer) {}
+    ~PeerLink() override;
+    void send(const std::uint8_t *data, std::size_t size) override;
+    int recv(std::uint8_t *buffer, std::size_t capacity, int timeout_ms) override;
+    std::string peer_name() const override;
+
+private:
+    UdpHost &host_;
+    int peer_;
+};
+
+class UdpHost : public HostSocket {
+public:
+    bool open(const std::string &bind_address, std::uint16_t port) { return socket_.open(bind_address, port); }
+
+    int accept(std::uint8_t *buffer, std::size_t capacity, int timeout_ms, int &peer) override {
+        for (std::size_t i = 0; i < peers_.size(); ++i) {   // datagrams a link's read took off the socket for an address nobody has accepted yet
+            if (peers_[i].linked || peers_[i].inbox.empty()) continue;
+            peer = static_cast<int>(i);
+            return pop(peers_[i].inbox, buffer, capacity);
+        }
+        for (;;) {
+            sockaddr_in from{};
+            const int n = socket_.receive(buffer, capacity, timeout_ms, from);
+            if (n <= 0) return n;
+            const int known = find(from);
+            if (known >= 0 && peers_[static_cast<std::size_t>(known)].linked) {
+                queue(known, buffer, static_cast<std::size_t>(n));
+                continue;
+            }
+            peer = known >= 0 ? known : remember(from);
+            if (peer < 0) continue;
+            return n;
+        }
+    }
+
+    std::unique_ptr<Transport> open_link(int peer) override {
+        peers_[static_cast<std::size_t>(peer)].linked = true;
+        return std::make_unique<PeerLink>(*this, peer);
+    }
+
+    void unlink(int peer) {
+        peers_[static_cast<std::size_t>(peer)].linked = false;
+        peers_[static_cast<std::size_t>(peer)].inbox.clear();
+    }
+
+    void send(int peer, const std::uint8_t *data, std::size_t size) { socket_.send_to(peers_[static_cast<std::size_t>(peer)].address, data, size); }
+
+    // The next datagram from `peer`, reading the socket for up to timeout_ms; datagrams from other peers wait on their own queues.
+    int receive_for(int peer, std::uint8_t *buffer, std::size_t capacity, int timeout_ms) {
+        std::deque<std::vector<std::uint8_t>> &mine = peers_[static_cast<std::size_t>(peer)].inbox;
+        if (!mine.empty()) return pop(mine, buffer, capacity);
+        sockaddr_in from{};
+        for (int n = socket_.receive(buffer, capacity, timeout_ms, from); n > 0; n = socket_.receive(buffer, capacity, 0, from)) {
+            const int owner = find(from);
+            if (owner == peer) return n;
+            const int keeper = owner >= 0 ? owner : remember(from);
+            if (keeper >= 0) queue(keeper, buffer, static_cast<std::size_t>(n));
+        }
+        return 0;
+    }
+
+    std::string name(int peer) const { return address_text(peers_[static_cast<std::size_t>(peer)].address); }
+
+private:
+    struct Peer {
+        sockaddr_in address;
+        std::deque<std::vector<std::uint8_t>> inbox;
+        bool linked = false;  // a PeerLink exists; until then accept() hands out this peer's datagrams too
+    };
+
+    // A new address that wrote while a link was reading: it becomes a peer nobody has linked, so accept() hands its datagrams out later instead of
+    // them being lost (a player asking to join a running game with other players' traffic arriving). -1 when the host remembers too many addresses.
+    int remember(const sockaddr_in &from) {
+        if (peers_.size() >= kMaxPeers) return -1;
+        peers_.push_back({from, {}, false});
+        return static_cast<int>(peers_.size()) - 1;
+    }
+
+    int find(const sockaddr_in &from) const {
+        for (std::size_t i = 0; i < peers_.size(); ++i)
+            if (same_address(peers_[i].address, from)) return static_cast<int>(i);
+        return -1;
+    }
+
+    void queue(int peer, const std::uint8_t *data, std::size_t size) {
+        std::deque<std::vector<std::uint8_t>> &inbox = peers_[static_cast<std::size_t>(peer)].inbox;
+        if (inbox.size() < kMaxQueuedPerPeer) inbox.emplace_back(data, data + size);
+    }
+
+    static int pop(std::deque<std::vector<std::uint8_t>> &inbox, std::uint8_t *buffer, std::size_t capacity) {
+        const std::vector<std::uint8_t> &front = inbox.front();
+        const std::size_t n = front.size() < capacity ? front.size() : capacity;
+        std::memcpy(buffer, front.data(), n);
+        inbox.pop_front();
+        return static_cast<int>(n);
+    }
+
+    UdpSocket socket_;
+    std::vector<Peer> peers_;
+};
+
+PeerLink::~PeerLink() { host_.unlink(peer_); }
+void PeerLink::send(const std::uint8_t *data, std::size_t size) { host_.send(peer_, data, size); }
+int PeerLink::recv(std::uint8_t *buffer, std::size_t capacity, int timeout_ms) { return host_.receive_for(peer_, buffer, capacity, timeout_ms); }
+std::string PeerLink::peer_name() const { return host_.name(peer_); }
+
+}
+
+std::unique_ptr<HostSocket> open_udp_host(const std::string &bind_address, std::uint16_t port) {
+    auto host = std::make_unique<UdpHost>();
+    return host->open(bind_address, port) ? std::move(host) : nullptr;
+}
+
+std::unique_ptr<Transport> open_udp_joiner(const std::string &host_address, std::uint16_t port) {
+    auto joiner = std::make_unique<JoinerTransport>();
+    const bool loopback = host_address == "localhost" || host_address.rfind("127.", 0) == 0;
+    return joiner->open(loopback ? "127.0.0.1" : "0.0.0.0", host_address, port) ? std::move(joiner) : nullptr;
+}
+
+}
+
+#endif
diff --git a/runtime/src/netplay/udp_transport.hpp b/runtime/src/netplay/udp_transport.hpp
new file mode 100644
index 0000000..bea297c
--- /dev/null
+++ b/runtime/src/netplay/udp_transport.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include "transport.hpp"
+
+#include <memory>
+
+namespace ps2::netplay {
+
+// Host side of the star: one UDP socket, one Transport per joiner, told apart by the sender's address.
+class HostSocket {
+public:
+    virtual ~HostSocket() = default;
+    // Waits up to timeout_ms for a datagram that has no link yet: from an unknown address (which becomes a peer) or from a peer
+    // whose link was never opened or was closed. Returns its size and the peer's index in `peer`; 0 on timeout. Datagrams from
+    // peers with a link are queued on that link meanwhile.
+    virtual int accept(std::uint8_t *buffer, std::size_t capacity, int timeout_ms, int &peer) = 0;
+    // The link to peer `peer` (until it is destroyed): its recv() returns only that peer's datagrams, its send() goes only to that peer.
+    virtual std::unique_ptr<Transport> open_link(int peer) = 0;
+};
+
+// Returns null (and prints why) when the socket cannot be set up, and always on the web build.
+std::unique_ptr<HostSocket> open_udp_host(const std::string &bind_address, std::uint16_t port);
+// Joiner: sends to host_address:port.
+std::unique_ptr<Transport> open_udp_joiner(const std::string &host_address, std::uint16_t port);
+
+}
diff --git a/runtime/src/netplay/warriors.hpp b/runtime/src/netplay/warriors.hpp
new file mode 100644
index 0000000..20edbe7
--- /dev/null
+++ b/runtime/src/netplay/warriors.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdint>
+
+// The few game facts netplay reads from The Warriors (NTSC-U, SLUS_212.15), from the decompilation notes.
+namespace ps2::netplay::warriors {
+
+constexpr std::uint32_t kGameStatePointer = 0x0051489C;  // heap pointer to W_GameState
+constexpr std::uint32_t kPlayerCountOffset = 0x224;      // number of humans under player control
+constexpr std::uint32_t kTwoPlayers = 2;
+// W_GameState + 0x124 holds the name of the level that is loaded ("level100" in the front end, "level99" in mission 1); + 0x14c is the level flow's
+// request (0 idle, 3 a level change is under way, set by level_enter_named).
+constexpr std::uint32_t kLevelNameOffset = 0x124;
+constexpr std::uint32_t kLevelFlowRequestOffset = 0x14C;
+constexpr std::uint32_t kLevelNameBytes = 16;
+constexpr const char kFrontEndLevel[] = "level100";
+// The way out of a level that the pause menu's Quit takes: session_set_chapter(game state, 1), then level_enter_named("menu").
+constexpr std::uint32_t kSessionSetChapter = 0x0041CEF0;
+constexpr std::uint32_t kLevelEnterNamed = 0x00160D78;
+constexpr std::uint32_t kMenuLevelNameString = 0x0054E790;
+constexpr std::uint32_t kQuitSection = 1;
+// GameTimer + 0x54: the game's own fixed-step flag (dt exactly 1/30 s). Written at every vblank so the clock cannot depend on cycle accounting.
+constexpr std::uint32_t kFixedStepFlag = 0x00B8F9D4;
+// The AI hooks' friendly fire switch (extra RAM, part of the state, digest and snapshot): non-zero lets a player's hit hurt a player. 0 is the original game.
+constexpr std::uint32_t kFriendlyFireSwitch = 0x02300000;
+// The split screen switch of the camera hooks (extra RAM, part of the state): 0 shows one combined view while every player fits one picture, non-zero always splits.
+constexpr std::uint32_t kSplitScreenSwitch = 0x022001F0;
+// Debug aid only: a RAM byte near the top of the 32 MB that the game does not use, flipped by --net-desync-test.
+constexpr std::uint32_t kUnusedRamByte = 0x01FFFFF0;
+
+}
diff --git a/runtime/src/netplay/wire.hpp b/runtime/src/netplay/wire.hpp
new file mode 100644
index 0000000..21b30a8
--- /dev/null
+++ b/runtime/src/netplay/wire.hpp
@@ -0,0 +1,109 @@
+#pragma once
+
+#include "../digest.hpp"
+#include "ps2/pad.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+// Message framing shared by every netplay file. Every message starts with a little-endian u16 type in the launcher's
+// 0x0400-0x04FF range, so a launcher transport can carry the same bytes unchanged.
+namespace ps2::netplay {
+
+enum MsgType : std::uint16_t {
+    kMsgHello = 0x0401,      // joiner to host: build identity
+    kMsgSnapBegin = 0x0402,  // host to joiner: what the snapshot is and the session settings
+    kMsgSnapChunk = 0x0403,
+    kMsgSnapAck = 0x0404,
+    kMsgReady = 0x0405,      // joiner to host: snapshot loaded, hashes
+    kMsgInput = 0x0406,      // both ways, every frame: pad samples, acks, digests
+    kMsgBye = 0x0407,
+    kMsgReject = 0x0408,
+    kMsgStart = 0x0409,      // host to joiners: every player has loaded the snapshot, lockstep begins
+    kMsgStatus = 0x040A,     // both ways, twice a second: how far each player's level load has got (board.hpp); display only
+    kMsgHistory = 0x040B,    // host to a joining machine: the frames it has to replay after loading the snapshot (history.hpp)
+    kMsgHistoryAck = 0x040C, // joining machine to host: how much of that it holds and how far it has replayed
+};
+
+// A joiner that has no slot of its own to ask for (no session file) says this in its HELLO: the host gives it the next free one.
+constexpr std::uint8_t kAnySlot = 0xFF;
+
+// Why a player is out of the game, told to every machine with its absence so each can say what happened and what happens next.
+// kLeftResync: the machine's game went out of step and is being brought back from the host's snapshot; its character stands idle meanwhile.
+enum LeftReason : std::uint8_t { kLeftSaid = 0, kLeftLost = 1, kLeftCrashed = 2, kJoinedBack = 3, kLeftResync = 4 };   // kJoinedBack: the event of a player taking its pad again
+
+class Writer {
+public:
+    explicit Writer(std::uint16_t type) { u16(type); }
+    Writer &u8(std::uint8_t v) { data_.push_back(v); return *this; }
+    Writer &u16(std::uint16_t v) { return raw(&v, 2); }
+    Writer &u32(std::uint32_t v) { return raw(&v, 4); }
+    Writer &u64(std::uint64_t v) { return raw(&v, 8); }
+    Writer &raw(const void *p, std::size_t n) {
+        const auto *b = static_cast<const std::uint8_t *>(p);
+        data_.insert(data_.end(), b, b + n);
+        return *this;
+    }
+    Writer &str(const std::string &s) { u8(static_cast<std::uint8_t>(s.size() < 255 ? s.size() : 255)); return raw(s.data(), s.size() < 255 ? s.size() : 255); }
+    const std::vector<std::uint8_t> &bytes() const { return data_; }
+
+private:
+    std::vector<std::uint8_t> data_;
+};
+
+// Reads past the end set ok() false and return zeros, so a truncated datagram is rejected by one check.
+class Reader {
+public:
+    Reader(const std::uint8_t *p, std::size_t n) : p_(p), end_(p + n) { type_ = u16(); }
+    std::uint16_t type() const { return type_; }
+    bool ok() const { return ok_; }
+    std::uint8_t u8() { std::uint8_t v = 0; take(&v, 1); return v; }
+    std::uint16_t u16() { std::uint16_t v = 0; take(&v, 2); return v; }
+    std::uint32_t u32() { std::uint32_t v = 0; take(&v, 4); return v; }
+    std::uint64_t u64() { std::uint64_t v = 0; take(&v, 8); return v; }
+    void raw(void *out, std::size_t n) { take(out, n); }
+    std::string str() {
+        std::string s(u8(), '\0');
+        take(s.data(), s.size());
+        return s;
+    }
+    std::size_t left() const { return static_cast<std::size_t>(end_ - p_); }
+    const std::uint8_t *cursor() const { return p_; }
+
+private:
+    void take(void *out, std::size_t n) {
+        if (static_cast<std::size_t>(end_ - p_) < n) { ok_ = false; std::memset(out, 0, n); p_ = end_; return; }
+        std::memcpy(out, p_, n);
+        p_ += n;
+    }
+    const std::uint8_t *p_, *end_;
+    std::uint16_t type_ = 0;
+    bool ok_ = true;
+};
+
+using Hashes = digest::MemoryHashes;
+
+inline void put_sample(Writer &w, const PadSample &s) { w.u16(s.buttons).raw(s.axes.data(), s.axes.size()).raw(s.pressure.data(), s.pressure.size()); }
+inline PadSample get_sample(Reader &r) {
+    PadSample s;
+    s.buttons = r.u16();
+    r.raw(s.axes.data(), s.axes.size());
+    r.raw(s.pressure.data(), s.pressure.size());
+    return s;
+}
+
+inline void put_hashes(Writer &w, const Hashes &h) { w.u64(h.ee).u64(h.spr).u64(h.iop).u64(h.card).u64(h.extra); }
+inline Hashes get_hashes(Reader &r) {
+    Hashes h;
+    h.ee = r.u64();
+    h.spr = r.u64();
+    h.iop = r.u64();
+    h.card = r.u64();
+    h.extra = r.u64();
+    return h;
+}
+
+}
diff --git a/runtime/src/overlay/overlay.hpp b/runtime/src/overlay/overlay.hpp
new file mode 100644
index 0000000..30353f0
--- /dev/null
+++ b/runtime/src/overlay/overlay.hpp
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+// The co-op overlay: what the runtime shows over the game picture on this machine only (the session banner on the title, the joining and sending
+// screens, a stall, the end of a session). It is drawn after the game's frame from the game's own font, button sprites and loading picture, decoded from
+// the player's disc into `--overlay-dir` by assets\tools\extract_overlay.py. Nothing here reads or writes guest memory, so no digest can depend on it
+// (design\COOP_FRONTEND.md section 0: a per-machine fact never goes into game RAM).
+//
+// Pictures are in the layout of a 1280 x 960 frame; any size works (the game's own 640 x 448 buffer is stretched to 4:3 when shown, and so is this).
+namespace ps2::overlay {
+
+// Why a session ended, for the page shown over the title afterwards.
+enum class Ending { none, host_ended, host_lost, desync, full, build, player_lost, unreachable };
+
+// One player's line in the list drawn over the loading and waiting screens, a stall and a level load: the name, what that player is doing, and a figure for the
+// bar under it when the amount is known (-1: no bar). `alert` draws the state in red.
+struct Row {
+    std::string name;
+    std::string state;
+    int percent = -1;
+    bool alert = false;
+    bool operator==(const Row &) const = default;
+};
+
+// Who is in the session, for the banner on the title.
+struct Banner {
+    bool host = false;
+    std::vector<std::string> names;   // the named slots in slot order (open slots left out); the first is the host
+};
+
+// The art: false (overlay stays off) when a file is missing. `--no-overlay` switches it off for a run (the digest comparison).
+bool load_assets(const std::string &dir);
+void set_enabled(bool enabled);
+bool enabled();
+
+// Display-only probe of the game: true while the game shows the "PRESS THE START BUTTON" screen. Must not write guest memory.
+void set_title_probe(bool (*probe)());
+void set_banner(const Banner &banner);
+
+// Emulation thread, every vblank after the pads were applied: polls the title probe and lets a button press dismiss the ended page.
+void on_vblank(std::uint64_t frame);
+
+// States, from any thread. Names are shown as given, in capitals.
+void loading_receiving(const std::string &host, int percent);   // this machine downloads the host's game
+void loading_sending(const std::string &to, int percent);       // this machine (the host) uploads its game, its own game frozen
+void loading_waiting(const std::string &who_to_load);           // everything is here, waiting for that player to load
+void loading_joining(const std::string &who_to_join);           // the host waits for that player to connect
+void loading_end();
+void stall(const std::string &who, std::uint32_t waited_ms, std::uint32_t limit_seconds);   // the game is held up by that player; drawn only after kStallShownMs, counting down to the limit netplay gives up at
+void stall_end();
+void session_ended(Ending why, const std::string &host);   // the page stays over the left half of whatever the game shows until a button dismisses it
+
+// The players, one row each, drawn over the loading screens, a stall and a level load (nothing under two rows). Empty clears.
+void set_rows(const std::vector<Row> &rows);
+// The game's own level-load screen is up: the rows are drawn over it, its picture stays.
+void level_loading(bool on);
+// A one-off message over whatever is shown for kNoticeMs: what happened, and what happens next. Shown in capitals.
+void notice(const std::string &what, const std::string &next);
+
+// Who opened the game's pause menu, shown at the top of the picture while it is open; an empty name clears it.
+void paused_by(const std::string &name);
+
+constexpr std::uint32_t kNoticeMs = 8000;
+constexpr std::uint32_t kStallShownMs = 1000;    // a stall shorter than this is never drawn
+
+// What is drawn: a layer of RGBA pixels (R | G << 8 | B << 16 | A << 24, straight alpha, transparent where nothing is drawn) of `width` x `height`, or
+// `compose`: the same blended over a picture of that size in place. False when there is nothing to draw (the picture is left alone).
+bool render(std::vector<std::uint32_t> &layer, std::uint32_t width, std::uint32_t height);
+bool compose(std::vector<std::uint32_t> &picture, std::uint32_t width, std::uint32_t height);
+
+// True when something is drawn now.
+bool active();
+// Counts every change of what is drawn.
+std::uint64_t version();
+// True once after what is drawn changed, so a host that is not producing frames (a stall, a download) repaints.
+bool consume_change();
+// The loading screens cover the whole picture: a frame of the game is not needed under them.
+bool opaque();
+
+}
diff --git a/runtime/src/overlay/overlay_assets.cpp b/runtime/src/overlay/overlay_assets.cpp
new file mode 100644
index 0000000..d9ff15b
--- /dev/null
+++ b/runtime/src/overlay/overlay_assets.cpp
@@ -0,0 +1,40 @@
+#include "scene.hpp"
+
+#include <cstdio>
+#include <cstring>
+#include <memory>
+
+namespace ps2::overlay {
+
+namespace {
+
+constexpr std::uint32_t kRectValues = 4;
+constexpr std::uint32_t kMaxSide = 4096;
+
+bool load_sheet(const std::string &dir, const char *name, Sheet &sheet) {
+    const std::string base = dir + "/" + name;
+    const std::unique_ptr<std::FILE, int (*)(std::FILE *)> pixels(std::fopen((base + ".rgba").c_str(), "rb"), std::fclose);
+    if (!pixels) return false;
+    std::uint32_t size[2];
+    if (std::fread(size, sizeof size, 1, pixels.get()) != 1 || !size[0] || !size[1] || size[0] > kMaxSide || size[1] > kMaxSide) return false;
+    sheet.width = size[0];
+    sheet.height = size[1];
+    sheet.pixels.resize(static_cast<std::size_t>(sheet.width) * sheet.height);
+    if (std::fread(sheet.pixels.data(), 4, sheet.pixels.size(), pixels.get()) != sheet.pixels.size()) return false;
+    const std::unique_ptr<std::FILE, int (*)(std::FILE *)> rects(std::fopen((base + ".rects").c_str(), "r"), std::fclose);
+    if (!rects) return false;
+    unsigned r[kRectValues];
+    while (std::fscanf(rects.get(), "%u %u %u %u", &r[0], &r[1], &r[2], &r[3]) == static_cast<int>(kRectValues)) sheet.rects.insert(sheet.rects.end(), r, r + kRectValues);
+    return sheet.count() > 0;
+}
+
+}
+
+bool load_art(const std::string &dir, Art &art) {
+    Art loaded;
+    if (!load_sheet(dir, "big_font", loaded.font) || !load_sheet(dir, "part_page0", loaded.buttons) || !load_sheet(dir, "default_ls_0", loaded.picture)) return false;
+    art = std::move(loaded);
+    return true;
+}
+
+}
diff --git a/runtime/src/overlay/overlay_paint.cpp b/runtime/src/overlay/overlay_paint.cpp
new file mode 100644
index 0000000..8b641b7
--- /dev/null
+++ b/runtime/src/overlay/overlay_paint.cpp
@@ -0,0 +1,323 @@
+#include "scene.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <utility>
+
+namespace ps2::overlay {
+
+namespace {
+
+// Layout, in the pixels of a 1280 x 960 frame (design\ui\mockups, measured on our renders of the game's own screens).
+constexpr float kRefWidth = 1280.0f, kRefHeight = 960.0f;
+constexpr float kMenuX = 70.0f;                       // the front end's left edge
+constexpr float kMenuHalf = 640.0f;                   // the session page covers the left half of the title
+constexpr float kBarLeft = 676.0f, kBarRight = 1221.0f, kBarTop = 795.0f, kBarHeight = 16.0f;   // the level-load bar (0.528 to 0.954 of the width, y 0.828)
+constexpr float kBarTextDrop = 36.0f;
+constexpr float kStallTitleY = 222.0f, kStallDetailY = 282.0f, kStallDim = 0.35f;
+constexpr float kStallPlateTop = 130.0f, kStallPlateBottom = 330.0f, kStallPlateAlpha = 0.88f;   // the dark band the stall's words sit on, so they read over any picture
+constexpr float kPercentRoom = 90.0f;                 // the loading line stops this far short of the percent figure
+constexpr float kRightMargin = 40.0f, kLeftPageRoom = 560.0f, kStallRoom = 1100.0f, kBannerRoom = 560.0f;   // widest a line may be (frame pixels)
+constexpr float kRowsTop = 640.0f, kRowStep = 56.0f, kRowsWidth = 520.0f, kRowSize = 0.9f, kRowBarDrop = 36.0f, kRowBarHeight = 6.0f, kRowsBackdrop = 0.9f, kRowsPad = 24.0f;
+constexpr float kPauserY = 40.0f, kPauserRoom = 600.0f;
+constexpr float kNoticeTop = 836.0f, kNoticeWhatY = 878.0f, kNoticeNextY = 922.0f, kNoticeBackdrop = 0.9f, kNoticeRoom = 1140.0f;
+constexpr std::uint32_t kStallCountdownFrom = 10;     // seconds of stall before "connection not responding" joins the page
+
+// The game's colours as the renders show them: 70 % of the colour in memory (the mockups' DISPLAY factor), so overlay text matches the game's own.
+constexpr float kDisplay = 0.7f;
+struct Rgb {
+    float r, g, b;
+    constexpr Rgb scaled(float k) const { return {r * k, g * k, b * k}; }
+};
+constexpr Rgb kRed{170, 43, 43}, kGrey{178, 178, 178}, kBlack{0, 0, 0}, kWhite{255, 255, 255};
+
+// big_font as TextWidget draws it at size 1 (texels to pixels), measured on our renders.
+constexpr float kFontScale = 1.159f, kFontAspect = 1.09f, kSpaceAdvance = 10.0f, kCapRow = 8.0f;
+constexpr float kShadowPixels = 2.0f, kShadowAlpha = 0.5f;
+constexpr float kButtonScale = 0.82f, kButtonBrightness = 0.75f, kButtonDrop = 4.0f, kButtonGap = 12.0f;
+constexpr std::uint32_t kCrossSprite = 79;            // part_page0 rectangle of the cross button
+constexpr float kUsageSize = 1.15f;
+constexpr int kMaxSupersample = 4;
+constexpr std::size_t kMinRows = 2;                   // a list of one player says nothing
+
+struct Texel {
+    float r = 0, g = 0, b = 0, a = 0;   // premultiplied
+};
+
+Texel fetch(const Sheet &s, int x, int y) {
+    const std::uint32_t p = s.pixels[static_cast<std::size_t>(y) * s.width + static_cast<std::size_t>(x)];
+    const float a = static_cast<float>(p >> 24) / 255.0f;
+    return {static_cast<float>(p & 255u) / 255.0f * a, static_cast<float>((p >> 8) & 255u) / 255.0f * a, static_cast<float>((p >> 16) & 255u) / 255.0f * a, a};
+}
+
+// Bilinear sample at texel coordinates (u, v) inside rectangle [x0, x1) x [y0, y1).
+Texel sample(const Sheet &s, int x0, int y0, int x1, int y1, float u, float v) {
+    u -= 0.5f;
+    v -= 0.5f;
+    const float fu = std::floor(u), fv = std::floor(v);
+    const float tx = u - fu, ty = v - fv;
+    const auto clampx = [&](int x) { return std::clamp(x, x0, x1 - 1); };
+    const auto clampy = [&](int y) { return std::clamp(y, y0, y1 - 1); };
+    const int ax = clampx(static_cast<int>(fu)), bx = clampx(static_cast<int>(fu) + 1), ay = clampy(static_cast<int>(fv)), by = clampy(static_cast<int>(fv) + 1);
+    const Texel t00 = fetch(s, ax, ay), t10 = fetch(s, bx, ay), t01 = fetch(s, ax, by), t11 = fetch(s, bx, by);
+    const auto mix = [&](float a00, float a10, float a01, float a11) { return (a00 * (1 - tx) + a10 * tx) * (1 - ty) + (a01 * (1 - tx) + a11 * tx) * ty; };
+    return {mix(t00.r, t10.r, t01.r, t11.r), mix(t00.g, t10.g, t01.g, t11.g), mix(t00.b, t10.b, t01.b, t11.b), mix(t00.a, t10.a, t01.a, t11.a)};
+}
+
+std::string upper(std::string text) {
+    for (char &c : text) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+    return text;
+}
+
+struct Run {
+    std::string text;
+    Rgb colour;
+};
+
+enum class Align { left, centre, right };
+
+// A transparent image the scene is painted into; coordinates passed in are those of the 1280 x 960 frame.
+class Canvas {
+public:
+    Canvas(std::vector<std::uint32_t> &layer, std::uint32_t width, std::uint32_t height, const Art &art)
+        : layer_(layer), width_(width), height_(height), art_(art), ux_(static_cast<float>(width) / kRefWidth), uy_(static_cast<float>(height) / kRefHeight) {
+        layer_.assign(static_cast<std::size_t>(width) * height, 0u);
+    }
+
+    void fill(float x, float y, float w, float h, Rgb colour, float alpha) {
+        const int x0 = std::max(0, static_cast<int>(std::lround(x * ux_))), x1 = std::min(static_cast<int>(width_), static_cast<int>(std::lround((x + w) * ux_)));
+        const int y0 = std::max(0, static_cast<int>(std::lround(y * uy_))), y1 = std::min(static_cast<int>(height_), static_cast<int>(std::lround((y + h) * uy_)));
+        for (int py = y0; py < y1; ++py)
+            for (int px = x0; px < x1; ++px) put(px, py, colour, alpha);
+    }
+
+    // A rectangle of a sheet stretched over [x, x + w) x [y, y + h), multiplied by `tint`.
+    void sprite(const Sheet &sheet, std::size_t index, float x, float y, float w, float h, Rgb tint, float alpha) {
+        if (index >= sheet.count()) return;
+        const int rx0 = static_cast<int>(sheet.rects[index * 4]), ry0 = static_cast<int>(sheet.rects[index * 4 + 1]);
+        const int rx1 = static_cast<int>(sheet.rects[index * 4 + 2]), ry1 = static_cast<int>(sheet.rects[index * 4 + 3]);
+        if (rx1 <= rx0 || ry1 <= ry0) return;
+        const float dx = x * ux_, dy = y * uy_, dw = w * ux_, dh = h * uy_;
+        const int x0 = std::max(0, static_cast<int>(std::floor(dx))), x1 = std::min(static_cast<int>(width_), static_cast<int>(std::ceil(dx + dw)));
+        const int y0 = std::max(0, static_cast<int>(std::floor(dy))), y1 = std::min(static_cast<int>(height_), static_cast<int>(std::ceil(dy + dh)));
+        const float step_u = static_cast<float>(rx1 - rx0) / dw, step_v = static_cast<float>(ry1 - ry0) / dh;
+        const int nx = std::clamp(static_cast<int>(std::ceil(step_u)), 1, kMaxSupersample), ny = std::clamp(static_cast<int>(std::ceil(step_v)), 1, kMaxSupersample);
+        for (int py = y0; py < y1; ++py) {
+            for (int px = x0; px < x1; ++px) {
+                Texel sum;
+                for (int sy = 0; sy < ny; ++sy) {
+                    for (int sx = 0; sx < nx; ++sx) {
+                        const float u = static_cast<float>(rx0) + (static_cast<float>(px) + (static_cast<float>(sx) + 0.5f) / static_cast<float>(nx) - dx) * step_u;
+                        const float v = static_cast<float>(ry0) + (static_cast<float>(py) + (static_cast<float>(sy) + 0.5f) / static_cast<float>(ny) - dy) * step_v;
+                        const Texel t = sample(sheet, rx0, ry0, rx1, ry1, u, v);
+                        sum.r += t.r;
+                        sum.g += t.g;
+                        sum.b += t.b;
+                        sum.a += t.a;
+                    }
+                }
+                const float n = static_cast<float>(nx * ny);
+                const float a = sum.a / n;
+                if (a <= 0.0f) continue;
+                put(px, py, {sum.r / n / a * tint.r, sum.g / n / a * tint.g, sum.b / n / a * tint.b}, a * alpha);
+            }
+        }
+    }
+
+    float text_width(const std::vector<Run> &runs, float size) const {
+        float total = 0.0f;
+        for (const Run &run : runs)
+            for (const char ch : run.text) total += advance(ch, size);
+        return total;
+    }
+
+    // The size to draw `line` at so it is no wider than `room` frame pixels (names can be long).
+    float fitted(const std::string &line, float size, float room) const {
+        const float width = text_width({{line, kGrey}}, size);
+        return width > room ? size * room / width : size;
+    }
+
+    // `y` is the top of the capitals, as in the mockups. Returns the width drawn.
+    float text(const std::vector<Run> &runs, float x, float y, float size, Align align) {
+        const float width = text_width(runs, size);
+        x = align == Align::right ? x - width : align == Align::centre ? x - width / 2.0f : x;
+        const float glyph_scale = kFontScale * size, drop = kCapRow * glyph_scale * kFontAspect;
+        for (const Run &run : runs) {
+            for (const char ch : run.text) {
+                const std::size_t index = static_cast<unsigned char>(ch);
+                const float step = advance(ch, size);
+                if (ch != ' ' && index < art_.font.count()) {
+                    const float gw = static_cast<float>(art_.font.rects[index * 4 + 2] - art_.font.rects[index * 4]) * glyph_scale;
+                    const float gh = static_cast<float>(art_.font.rects[index * 4 + 3] - art_.font.rects[index * 4 + 1]) * glyph_scale * kFontAspect;
+                    sprite(art_.font, index, x + kShadowPixels, y - drop + kShadowPixels, gw, gh, kBlack, kShadowAlpha);
+                    sprite(art_.font, index, x, y - drop, gw, gh, run.colour.scaled(kDisplay), 1.0f);
+                }
+                x += step;
+            }
+        }
+        return width;
+    }
+
+    float text(const std::string &line, Rgb colour, float x, float y, float size, Align align) { return text({{line, colour}}, x, y, size, align); }
+
+    // A usage line "(button) label" in the front end's style.
+    void usage_line(std::size_t sprite_index, const std::string &label, float x, float y) {
+        float at = x;
+        if (sprite_index < art_.buttons.count()) {
+            const float w = static_cast<float>(art_.buttons.rects[sprite_index * 4 + 2] - art_.buttons.rects[sprite_index * 4]) * kButtonScale;
+            const float h = static_cast<float>(art_.buttons.rects[sprite_index * 4 + 3] - art_.buttons.rects[sprite_index * 4 + 1]) * kButtonScale;
+            sprite(art_.buttons, sprite_index, x, y - kButtonDrop, w, h, kWhite.scaled(kButtonBrightness), 1.0f);
+            at += w + kButtonGap;
+        }
+        text(label, kRed, at, y, kUsageSize, Align::left);
+    }
+
+private:
+    float advance(char ch, float size) const {
+        const std::size_t index = static_cast<unsigned char>(ch);
+        const float scale = kFontScale * size;
+        if (ch == ' ' || index >= art_.font.count()) return kSpaceAdvance * scale;
+        return static_cast<float>(art_.font.rects[index * 4 + 2] - art_.font.rects[index * 4] + 1) * scale;
+    }
+
+    // `colour` over the pixel, straight alpha on both sides.
+    void put(int x, int y, Rgb colour, float alpha) {
+        std::uint32_t &dst = layer_[static_cast<std::size_t>(y) * width_ + static_cast<std::size_t>(x)];
+        const float da = static_cast<float>(dst >> 24) / 255.0f;
+        const float out = alpha + da * (1.0f - alpha);
+        if (out <= 0.0f) return;
+        const auto mix = [&](float s, std::uint32_t d) { return std::clamp((s * alpha + static_cast<float>(d) * da * (1.0f - alpha)) / out, 0.0f, 255.0f); };
+        const float r = mix(colour.r, dst & 255u), g = mix(colour.g, (dst >> 8) & 255u), b = mix(colour.b, (dst >> 16) & 255u);
+        dst = static_cast<std::uint32_t>(std::lround(r)) | static_cast<std::uint32_t>(std::lround(g)) << 8 | static_cast<std::uint32_t>(std::lround(b)) << 16 |
+              static_cast<std::uint32_t>(std::lround(out * 255.0f)) << 24;
+    }
+
+    std::vector<std::uint32_t> &layer_;
+    std::uint32_t width_, height_;
+    const Art &art_;
+    float ux_, uy_;
+};
+
+void paint_loading(Canvas &c, const Art &art, const Scene &scene) {
+    c.sprite(art.picture, 0, 0, 0, kRefWidth, kRefHeight, kWhite.scaled(kDisplay), 1.0f);
+    const float fraction = scene.loading == Scene::Loading::joining ? 0.0f
+                           : scene.loading == Scene::Loading::waiting || scene.percent < 0 ? 1.0f
+                                                                                            : std::clamp(static_cast<float>(scene.percent) / 100.0f, 0.0f, 1.0f);
+    c.fill(kBarLeft, kBarTop, (kBarRight - kBarLeft) * fraction, kBarHeight, kRed.scaled(kDisplay), 1.0f);
+    const std::string name = upper(scene.name);
+    std::string line;
+    switch (scene.loading) {
+    case Scene::Loading::receiving: line = "JOINING " + name + "'S GAME"; break;
+    case Scene::Loading::sending: line = "SENDING THE GAME TO " + name; break;
+    case Scene::Loading::waiting: line = "WAITING FOR " + name + " TO LOAD"; break;
+    case Scene::Loading::joining: line = "WAITING FOR " + name + " TO JOIN"; break;
+    case Scene::Loading::none: break;
+    }
+    const bool figure = scene.percent >= 0 && scene.loading != Scene::Loading::waiting && scene.loading != Scene::Loading::joining;
+    const float room = kRefWidth - kRightMargin - kBarLeft - (figure ? kPercentRoom : 0.0f);
+    c.text(line, kGrey, kBarLeft, kBarTop + kBarTextDrop, c.fitted(line, 0.9f, room), Align::left);
+    if (figure) c.text(std::to_string(scene.percent) + "%", kRed, kBarRight, kBarTop + kBarTextDrop, 0.9f, Align::right);
+}
+
+// The players, one row each: the name, what the player is doing on the right, and under it a bar when the amount is known.
+void paint_rows(Canvas &c, const Scene &scene) {
+    const float height = kRowStep * static_cast<float>(scene.rows.size()) + kRowsPad;
+    c.fill(kMenuX - kRowsPad, kRowsTop - kRowsPad - kRowStep / 2.0f, kRowsWidth + 2.0f * kRowsPad, height + kRowsPad, kBlack, kRowsBackdrop);
+    float y = kRowsTop;
+    for (const Row &row : scene.rows) {
+        const std::string state = upper(row.state);
+        const float state_width = c.text_width({{state, kGrey}}, kRowSize);
+        c.text(upper(row.name), kGrey, kMenuX, y, c.fitted(upper(row.name), kRowSize, kRowsWidth - state_width - kRowsPad), Align::left);
+        c.text(state, row.alert ? kRed : kGrey, kMenuX + kRowsWidth, y, kRowSize, Align::right);
+        if (row.percent >= 0) {
+            c.fill(kMenuX, y + kRowBarDrop, kRowsWidth, kRowBarHeight, kGrey.scaled(0.35f), 1.0f);
+            c.fill(kMenuX, y + kRowBarDrop, kRowsWidth * std::clamp(static_cast<float>(row.percent) / 100.0f, 0.0f, 1.0f), kRowBarHeight, kRed.scaled(kDisplay), 1.0f);
+        }
+        y += kRowStep;
+    }
+}
+
+// What happened and what happens next, over the bottom of whatever is shown.
+void paint_notice(Canvas &c, const Scene &scene) {
+    c.fill(0, kNoticeTop, kRefWidth, kRefHeight - kNoticeTop, kBlack, kNoticeBackdrop);
+    const std::string what = upper(scene.notice_what), next = upper(scene.notice_next);
+    c.text(what, kGrey, kMenuX, kNoticeWhatY, c.fitted(what, 0.9f, kNoticeRoom), Align::left);
+    c.text(next, kRed, kMenuX, kNoticeNextY, c.fitted(next, 0.9f, kNoticeRoom), Align::left);
+}
+
+// Who opened the pause menu, at the top left over the menu's own header.
+void paint_pauser(Canvas &c, const Scene &scene) {
+    const std::string name = upper(scene.pauser);
+    c.text({{"PAUSED BY  ", kGrey}, {name, kRed}}, kMenuX, kPauserY, c.fitted("PAUSED BY  " + name, 0.9f, kPauserRoom), Align::left);
+}
+
+void paint_stall(Canvas &c, const Scene &scene) {
+    c.fill(0, 0, kRefWidth, kRefHeight, kBlack, kStallDim);
+    c.fill(0, kStallPlateTop, kRefWidth, kStallPlateBottom - kStallPlateTop, kBlack, kStallPlateAlpha);
+    const std::string who = "WAITING FOR " + upper(scene.stall_who);
+    c.text(who, kGrey, kRefWidth / 2.0f, kStallTitleY, c.fitted(who, 1.4f, kStallRoom), Align::centre);
+    if (scene.stall_seconds >= kStallCountdownFrom) {
+        const std::uint32_t left = scene.stall_seconds >= scene.stall_limit ? 0 : scene.stall_limit - scene.stall_seconds;
+        c.text("CONNECTION NOT RESPONDING  " + std::to_string(left), kRed, kRefWidth / 2.0f, kStallDetailY, 1.0f, Align::centre);
+    }
+}
+
+// The reason and what to do about it, per ending.
+std::pair<std::string, std::string> ending_text(Ending why, const std::string &host) {
+    const std::string name = upper(host.empty() ? "THE HOST" : host);
+    switch (why) {
+    case Ending::host_ended: return {name + " ENDED THE SESSION", "HOST OR JOIN A NEW GAME"};
+    case Ending::host_lost: return {"LOST CONNECTION TO " + name, "HOST OR JOIN A NEW GAME"};
+    case Ending::desync: return {"THE GAMES WENT OUT OF STEP", "SEND THE LOG FROM THE LAUNCHER"};
+    case Ending::full: return {"THE GAME IS FULL", "JOIN ANOTHER GAME"};
+    case Ending::build: return {"UPDATE THE LAUNCHER", "THEN REBUILD THE GAME"};
+    case Ending::player_lost: return {"A PLAYER LOST CONNECTION", "THEY CAN REJOIN FROM THE LAUNCHER"};
+    case Ending::unreachable: return {"COULD NOT REACH " + name, "CHECK THE LINK AND TRY AGAIN"};
+    case Ending::none: break;
+    }
+    return {};
+}
+
+void paint_ended(Canvas &c, const Scene &scene) {
+    const auto [reason, remedy] = ending_text(scene.ending, scene.host);
+    c.fill(0, 0, kMenuHalf, kRefHeight, kBlack, 1.0f);
+    c.text("SESSION ENDED", kRed, kMenuX, 600, 1.4f, Align::left);
+    c.text(reason, kGrey, kMenuX, 660, c.fitted(reason, 1.0f, kLeftPageRoom), Align::left);
+    c.text(remedy, kRed, kMenuX, 700, c.fitted(remedy, 1.0f, kLeftPageRoom), Align::left);
+    c.text("CONTINUE", kGrey, kMenuX, 760, kUsageSize, Align::left);
+    c.usage_line(kCrossSprite, "ok", kMenuX, 830);
+}
+
+void paint_banner(Canvas &c, const Scene &scene) {
+    std::string roster;
+    for (const std::string &name : scene.banner.names) roster += (roster.empty() ? "" : " / ") + upper(name);
+    c.text({{"CO-OP  ", kGrey}, {roster, kRed}}, kMenuX, 790, c.fitted("CO-OP  " + roster, 0.9f, kBannerRoom), Align::left);
+    const std::string host = scene.banner.names.empty() ? "" : upper(scene.banner.names.front());
+    const std::string line = scene.banner.host ? "HOSTING FOR " + std::to_string(std::max<std::size_t>(2, scene.banner.names.size())) + " PLAYERS" : "JOINING " + host + "'S GAME";
+    c.text(line, kRed, kMenuX, 828, c.fitted(line, 0.9f, kBannerRoom), Align::left);
+}
+
+}
+
+bool covers_picture(const Scene &scene) { return scene.loading != Scene::Loading::none; }
+
+bool shows_anything(const Scene &scene) {
+    return scene.loading != Scene::Loading::none || scene.ending != Ending::none || scene.stall || (scene.title && !scene.banner.names.empty()) ||
+           (scene.level_load && scene.rows.size() >= kMinRows) || !scene.pauser.empty() || !scene.notice_what.empty();
+}
+
+bool paint(const Scene &scene, const Art &art, std::vector<std::uint32_t> &layer, std::uint32_t width, std::uint32_t height) {
+    if (!shows_anything(scene) || !width || !height) return false;
+    Canvas canvas(layer, width, height, art);
+    if (scene.loading != Scene::Loading::none) paint_loading(canvas, art, scene);
+    else if (scene.ending != Ending::none) paint_ended(canvas, scene);
+    else if (scene.stall) paint_stall(canvas, scene);
+    else if (scene.title && !scene.banner.names.empty()) paint_banner(canvas, scene);
+    if ((scene.loading != Scene::Loading::none || scene.stall || scene.level_load) && scene.rows.size() >= kMinRows) paint_rows(canvas, scene);
+    if (!scene.pauser.empty()) paint_pauser(canvas, scene);
+    if (!scene.notice_what.empty()) paint_notice(canvas, scene);
+    return true;
+}
+
+}
diff --git a/runtime/src/overlay/overlay_state.cpp b/runtime/src/overlay/overlay_state.cpp
new file mode 100644
index 0000000..d75f0de
--- /dev/null
+++ b/runtime/src/overlay/overlay_state.cpp
@@ -0,0 +1,229 @@
+#include "overlay.hpp"
+
+#include "ps2/pad.hpp"
+#include "scene.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <mutex>
+
+namespace ps2::overlay {
+
+namespace {
+
+constexpr std::uint16_t kStartBit = 1u << 3, kCrossBit = 1u << 14;
+constexpr std::uint64_t kDismissAfterFrames = 30;   // a button held while the page opens does not close it at once
+constexpr std::uint32_t kMsPerSecond = 1000;
+
+std::mutex g_mutex;
+Scene g_scene;
+Art g_art;
+bool g_loaded = false;
+std::atomic<bool> g_enabled{true};
+std::atomic<std::uint64_t> g_version{1};
+std::uint64_t g_consumed = 0;
+bool (*g_title_probe)() = nullptr;
+std::uint64_t g_ended_frame = 0;
+std::uint16_t g_previous_buttons = 0;
+
+std::uint64_t steady_ms() {
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+void changed() { g_version.fetch_add(1); }
+
+// Runs `edit` on the scene and counts a change when it altered anything that is drawn.
+template <class Edit>
+void update(Edit edit) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    const Scene before = g_scene;
+    edit(g_scene);
+    const bool same = before.loading == g_scene.loading && before.name == g_scene.name && before.percent == g_scene.percent && before.stall == g_scene.stall &&
+                      before.stall_who == g_scene.stall_who && before.stall_seconds == g_scene.stall_seconds && before.ending == g_scene.ending &&
+                      before.host == g_scene.host && before.title == g_scene.title && before.banner.names == g_scene.banner.names && before.banner.host == g_scene.banner.host &&
+                      before.rows == g_scene.rows && before.level_load == g_scene.level_load && before.pauser == g_scene.pauser && before.notice_what == g_scene.notice_what && before.notice_next == g_scene.notice_next;
+    if (!same) changed();
+}
+
+}
+
+bool load_assets(const std::string &dir) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_loaded = load_art(dir, g_art);
+    return g_loaded;
+}
+
+void set_enabled(bool enabled) { g_enabled = enabled; }
+bool enabled() { return g_enabled && g_loaded; }
+
+void set_title_probe(bool (*probe)()) { g_title_probe = probe; }
+
+void set_banner(const Banner &banner) {
+    update([&](Scene &s) { s.banner = banner; });
+}
+
+void on_vblank(std::uint64_t frame) {
+    if (!enabled()) return;
+    const bool title = g_title_probe && g_title_probe();
+    Ending ending;
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        ending = g_scene.ending;
+    }
+    update([&](Scene &s) {
+        s.title = title;
+        if (!s.notice_what.empty() && steady_ms() >= s.notice_until_ms) s.notice_what = s.notice_next = std::string();
+    });
+    PadSample pad;
+    const std::uint16_t buttons = read_pad_sample(0, pad) ? pad.buttons : 0;
+    const std::uint16_t pressed = static_cast<std::uint16_t>(buttons & ~g_previous_buttons);
+    g_previous_buttons = buttons;
+    if (ending != Ending::none && !g_ended_frame) g_ended_frame = frame;
+    if (ending != Ending::none && g_ended_frame && frame >= g_ended_frame + kDismissAfterFrames && (pressed & (kStartBit | kCrossBit))) {
+        g_ended_frame = 0;
+        update([](Scene &s) { s.ending = Ending::none; });
+    }
+}
+
+void loading_receiving(const std::string &host, int percent) {
+    update([&](Scene &s) {
+        s.loading = Scene::Loading::receiving;
+        s.name = host;
+        s.percent = std::clamp(percent, 0, 100);
+    });
+}
+
+void loading_sending(const std::string &to, int percent) {
+    update([&](Scene &s) {
+        s.loading = Scene::Loading::sending;
+        s.name = to;
+        s.percent = std::clamp(percent, 0, 100);
+    });
+}
+
+void loading_waiting(const std::string &who_to_load) {
+    update([&](Scene &s) {
+        s.loading = Scene::Loading::waiting;
+        s.name = who_to_load;
+        s.percent = -1;
+    });
+}
+
+void loading_joining(const std::string &who_to_join) {
+    update([&](Scene &s) {
+        s.loading = Scene::Loading::joining;
+        s.name = who_to_join;
+        s.percent = -1;
+    });
+}
+
+void loading_end() {
+    update([](Scene &s) {
+        s.loading = Scene::Loading::none;
+        s.name.clear();
+        s.percent = -1;
+    });
+}
+
+void stall(const std::string &who, std::uint32_t waited_ms, std::uint32_t limit_seconds) {
+    update([&](Scene &s) {
+        s.stall = waited_ms >= kStallShownMs;
+        s.stall_who = s.stall ? who : std::string();
+        s.stall_seconds = s.stall ? waited_ms / kMsPerSecond : 0;
+        s.stall_limit = limit_seconds;
+    });
+}
+
+void stall_end() {
+    update([](Scene &s) {
+        s.stall = false;
+        s.stall_who.clear();
+        s.stall_seconds = 0;
+    });
+}
+
+void session_ended(Ending why, const std::string &host) {
+    g_ended_frame = 0;
+    update([&](Scene &s) {
+        s.ending = why;
+        s.host = host;
+        s.banner = {};
+        s.stall = false;
+        s.loading = Scene::Loading::none;
+        s.rows.clear();
+        s.level_load = false;
+    });
+}
+
+void set_rows(const std::vector<Row> &rows) {
+    update([&](Scene &s) { s.rows = rows; });
+}
+
+void level_loading(bool on) {
+    update([&](Scene &s) { s.level_load = on; });
+}
+
+void paused_by(const std::string &name) {
+    update([&](Scene &s) { s.pauser = name; });
+}
+
+void notice(const std::string &what, const std::string &next) {
+    std::fprintf(stderr, "[overlay] notice: %s / %s\n", what.c_str(), next.c_str());
+    update([&](Scene &s) {
+        s.notice_what = what;
+        s.notice_next = next;
+        s.notice_until_ms = steady_ms() + kNoticeMs;
+    });
+}
+
+bool render(std::vector<std::uint32_t> &layer, std::uint32_t width, std::uint32_t height) {
+    if (!enabled()) return false;
+    Scene scene;
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        scene = g_scene;
+    }
+    return paint(scene, g_art, layer, width, height);
+}
+
+bool compose(std::vector<std::uint32_t> &picture, std::uint32_t width, std::uint32_t height) {
+    static thread_local std::vector<std::uint32_t> layer;
+    if (picture.size() != static_cast<std::size_t>(width) * height || !render(layer, width, height)) return false;
+    for (std::size_t i = 0; i < picture.size(); ++i) {
+        const std::uint32_t over = layer[i], under = picture[i];
+        const std::uint32_t a = over >> 24;
+        if (!a) continue;
+        std::uint32_t out = 0xFF000000u;
+        for (int shift = 0; shift < 24; shift += 8) {
+            const std::uint32_t o = (over >> shift) & 255u, u = (under >> shift) & 255u;
+            out |= ((o * a + u * (255u - a) + 127u) / 255u) << shift;
+        }
+        picture[i] = out;
+    }
+    return true;
+}
+
+bool active() {
+    if (!enabled()) return false;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return shows_anything(g_scene);
+}
+
+std::uint64_t version() { return g_version.load(); }
+
+bool opaque() {
+    if (!enabled()) return false;
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return covers_picture(g_scene);
+}
+
+bool consume_change() {
+    const std::uint64_t now = g_version.load();
+    if (now == g_consumed) return false;
+    g_consumed = now;
+    return enabled();
+}
+
+}
diff --git a/runtime/src/overlay/scene.hpp b/runtime/src/overlay/scene.hpp
new file mode 100644
index 0000000..3fcd026
--- /dev/null
+++ b/runtime/src/overlay/scene.hpp
@@ -0,0 +1,52 @@
+#pragma once
+
+#include "overlay.hpp"
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace ps2::overlay {
+
+// Everything the overlay can show at one moment (overlay_state.cpp keeps it, overlay_paint.cpp draws it).
+struct Scene {
+    enum class Loading { none, receiving, sending, waiting, joining };
+    Loading loading = Loading::none;
+    std::string name;                 // receiving: the host; sending: the player it goes to; waiting: the player being waited for
+    int percent = -1;                 // -1: no figure
+    bool stall = false;
+    std::string stall_who;
+    std::uint32_t stall_seconds = 0, stall_limit = 0;
+    Ending ending = Ending::none;
+    std::string host;                 // the page's host name
+    bool title = false;               // the game shows its PRESS THE START BUTTON screen
+    Banner banner;
+    std::vector<Row> rows;            // the players, drawn over the loading screens, a stall and a level load
+    bool level_load = false;          // the game's own level-load screen is up
+    std::string pauser;               // the player whose pause menu is open
+    std::string notice_what, notice_next;
+    std::uint64_t notice_until_ms = 0;   // steady clock; the notice is dropped by on_vblank after this
+};
+
+// overlay_assets.cpp: the sprite sheets of --overlay-dir. A rectangle is in texels of its sheet; the sheet holds straight-alpha RGBA.
+struct Sheet {
+    std::uint32_t width = 0, height = 0;
+    std::vector<std::uint32_t> pixels;
+    std::vector<std::uint32_t> rects;   // x0, y0, x1, y1 per rectangle
+    std::size_t count() const { return rects.size() / 4; }
+};
+
+struct Art {
+    Sheet font, buttons, picture;       // big_font, part_page0, default_ls_0
+};
+
+bool load_art(const std::string &dir, Art &art);
+
+// overlay_paint.cpp: draws the scene into `layer` (width x height, cleared first, transparent where nothing is drawn). False when nothing is drawn.
+bool paint(const Scene &scene, const Art &art, std::vector<std::uint32_t> &layer, std::uint32_t width, std::uint32_t height);
+// True for a scene that covers the whole picture.
+bool covers_picture(const Scene &scene);
+// True for a scene that draws anything.
+bool shows_anything(const Scene &scene);
+
+}
diff --git a/runtime/src/pad_input.cpp b/runtime/src/pad_input.cpp
new file mode 100644
index 0000000..104528f
--- /dev/null
+++ b/runtime/src/pad_input.cpp
@@ -0,0 +1,183 @@
+#include "pad_input.hpp"
+
+#include "iop/sio2.hpp"
+#include "netplay/netplay.hpp"
+#include "ps2/system.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+
+namespace ps2 {
+
+namespace {
+
+constexpr std::uint8_t kAxisRest = 0x80, kAxisMin = 0x00, kAxisMax = 0xFF;
+constexpr std::uint8_t kStickUp = 1, kStickDown = 2, kStickLeft = 4, kStickRight = 8;
+
+PadSample g_live[kPadCount];
+
+struct Scripted {
+    bool has_any = false;       // any press or axis entry exists for this pad
+    bool press_active = false;  // a press entry still covers or precedes this frame: buttons and the left stick follow it
+    bool axis_active = false;   // axis entries exist: all four axes follow them
+    PadSample sample;
+};
+
+Scripted scripted(int pad, std::uint64_t frame) {
+    Scripted s;
+    std::uint64_t last = 0;
+    for (const Press &p : g_options.presses)
+        if (p.pad == pad) {
+            s.has_any = true;
+            last = std::max<std::uint64_t>(last, p.frame + p.frames);
+        }
+    if (s.has_any && frame <= last) {
+        s.press_active = true;
+        std::uint8_t stick = 0;
+        for (const Press &p : g_options.presses)
+            if (p.pad == pad && frame >= p.frame && frame < p.frame + p.frames) {
+                s.sample.buttons |= p.buttons;
+                stick |= p.stick;
+            }
+        s.sample.axes[2] = (stick & kStickLeft) ? kAxisMin : (stick & kStickRight) ? kAxisMax : kAxisRest;
+        s.sample.axes[3] = (stick & kStickUp) ? kAxisMin : (stick & kStickDown) ? kAxisMax : kAxisRest;
+    }
+    for (const AxisPress &p : g_options.axis_presses) {
+        if (p.pad != pad) continue;
+        s.has_any = s.axis_active = true;
+    }
+    if (s.axis_active) {
+        s.sample.axes.fill(kAxisRest);
+        for (const AxisPress &p : g_options.axis_presses)
+            if (p.pad == pad && frame >= p.frame && frame < p.frame + p.frames) s.sample.axes[static_cast<std::size_t>(p.axis)] = p.value;
+    }
+    return s;
+}
+
+}
+
+void apply_pad_sample(int pad, const PadSample &sample) {
+    iop::sio2::set_buttons(pad, sample.buttons);
+    for (int a = 0; a < PadSample::kAxes; ++a) iop::sio2::set_axis(pad, a, sample.axes[static_cast<std::size_t>(a)]);
+    for (int i = 0; i < PadSample::kPressures; ++i) iop::sio2::set_pressure(pad, PadSample::kFirstPressureBit + i, sample.pressure[static_cast<std::size_t>(i)]);
+}
+
+bool read_pad_sample(int pad, PadSample &out) { return iop::sio2::pad_state(pad, out); }
+
+void apply_scripted_pads(std::uint64_t frame) {
+    // Once the last press is over the pad is left alone, so the web page's live input works after a scripted start.
+    for (int pad = 0; pad < kPadCount; ++pad) {
+        const Scripted s = scripted(pad, frame);
+        if (s.press_active) {
+            iop::sio2::set_buttons(pad, s.sample.buttons);
+            iop::sio2::set_axis(pad, 2, s.sample.axes[2]);
+            iop::sio2::set_axis(pad, 3, s.sample.axes[3]);
+        }
+        if (s.axis_active)
+            for (int a = 0; a < PadSample::kAxes; ++a) iop::sio2::set_axis(pad, a, s.sample.axes[static_cast<std::size_t>(a)]);
+    }
+}
+
+void plug_pads_if_due(std::uint64_t frame) {
+    for (int pad = 1; pad < kPadCount; ++pad)
+        if (frame >= g_options.pad_plug_frame[static_cast<std::size_t>(pad)]) iop::sio2::set_connected(pad, frame < g_options.pad_unplug_frame[static_cast<std::size_t>(pad)] || frame >= g_options.pad_replug_frame[static_cast<std::size_t>(pad)]);
+}
+
+PadSample local_pad_sample(int pad, std::uint64_t frame) {
+    const Scripted s = scripted(pad, frame);
+    return s.has_any ? s.sample : g_live[0];
+}
+
+void plug_pad(int pad, bool plugged) { iop::sio2::set_connected(pad, plugged); }
+
+bool parse_press(const std::string &spec, Press &press) {
+    static const char *const kNames[16] = {"select", "l3", "r3", "start", "up", "right", "down", "left",
+                                           "l2", "r2", "l1", "r1", "triangle", "circle", "cross", "square"};
+    const auto colon = spec.find(':');
+    if (colon == std::string::npos) return false;
+    press.frame = std::strtoull(spec.c_str(), nullptr, 10);
+    std::string rest = spec.substr(colon + 1);
+    press.frames = 6;
+    const auto second = rest.find(':');
+    if (second != std::string::npos) {
+        press.frames = static_cast<std::uint32_t>(std::strtoul(rest.c_str() + second + 1, nullptr, 10));
+        rest = rest.substr(0, second);
+    }
+    press.buttons = 0;
+    press.stick = 0;
+    static const char *const kStick[4] = {"lup", "ldown", "lleft", "lright"};
+    std::size_t start = 0;
+    while (start <= rest.size()) {
+        const auto plus = rest.find('+', start);
+        const std::string name = rest.substr(start, plus == std::string::npos ? std::string::npos : plus - start);
+        int bit = -1;
+        for (int i = 0; i < 16; ++i)
+            if (name == kNames[i]) bit = i;
+        int axis = -1;
+        for (int i = 0; i < 4; ++i)
+            if (name == kStick[i]) axis = i;
+        if (bit < 0 && axis < 0) return false;
+        if (bit >= 0) press.buttons |= static_cast<std::uint16_t>(1u << bit);
+        else press.stick |= static_cast<std::uint8_t>(1u << axis);
+        if (plus == std::string::npos) break;
+        start = plus + 1;
+    }
+    return true;
+}
+
+bool parse_axis(const std::string &spec, AxisPress &press) {
+    static const char *const kNames[4] = {"rx", "ry", "lx", "ly"};
+    std::size_t at = 0;
+    const auto field = [&](std::string &out) {
+        const auto colon = spec.find(':', at);
+        if (colon == std::string::npos) return false;
+        out = spec.substr(at, colon - at);
+        at = colon + 1;
+        return true;
+    };
+    std::string frame, axis, value;
+    if (!field(frame) || !field(axis)) return false;
+    const auto tail = spec.find(':', at);
+    value = spec.substr(at, tail == std::string::npos ? std::string::npos : tail - at);
+    press.frame = std::strtoull(frame.c_str(), nullptr, 10);
+    press.axis = -1;
+    for (int i = 0; i < 4; ++i)
+        if (axis == kNames[i]) press.axis = i;
+    if (press.axis < 0) return false;
+    press.value = static_cast<std::uint8_t>(std::strtoul(value.c_str(), nullptr, 0));
+    press.frames = 6;
+    if (tail != std::string::npos) press.frames = static_cast<std::uint32_t>(std::strtoul(spec.c_str() + tail + 1, nullptr, 10));
+    return press.frame || press.frames;
+}
+
+// Live input from the host (window or web page). During netplay it only feeds the local sample; the session applies pads.
+void set_pad_buttons(std::uint16_t pressed, int pad) {
+    if (pad < 0 || pad >= kPadCount) return;
+    if (netplay::enabled()) g_live[pad].buttons = pressed;
+    else iop::sio2::set_buttons(pad, pressed);
+}
+
+void set_pad_axis(int axis, std::uint8_t value, int pad) {
+    if (pad < 0 || pad >= kPadCount || axis < 0 || axis >= PadSample::kAxes) return;
+    if (netplay::enabled()) g_live[pad].axes[static_cast<std::size_t>(axis)] = value;
+    else iop::sio2::set_axis(pad, axis, value);
+}
+
+void set_pad_pressure(int button, std::uint8_t value, int pad) {
+    if (pad < 0 || pad >= kPadCount) return;
+    if (!netplay::enabled()) {
+        iop::sio2::set_pressure(pad, button, value);
+        return;
+    }
+    const int index = button - PadSample::kFirstPressureBit;
+    if (index >= 0 && index < PadSample::kPressures) g_live[pad].pressure[static_cast<std::size_t>(index)] = value;
+}
+
+void set_pad_connected(int pad, bool connected) {
+    if (!netplay::enabled()) iop::sio2::set_connected(pad, connected);
+}
+
+std::uint16_t pad_rumble(int pad) { return iop::sio2::rumble(pad); }
+void set_pad_rumble(int pad, std::uint16_t motors) { iop::sio2::set_rumble(pad, motors); }
+
+}
