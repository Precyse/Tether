+#pragma once
+
+#include "audio_stretch.hpp"
+
+#include <atomic>
+#include <cstddef>
+#include <cstdio>
+#include <cstdint>
+#include <vector>
+
+namespace host::audio {
+
+constexpr int kSampleRate = 48000;
+
+struct Stats {
+    unsigned underruns = 0;    // times the sound ran dry and faded out
+    unsigned drops = 0;        // times old sound was skipped because far too much was waiting
+    unsigned overflows = 0;    // times the emulator's sound did not fit the queue
+    double tempo = 1.0;        // current playback speed relative to the console
+    double fill_ms = 0.0;      // tracked low level of the sound waiting beyond the minimum the stretcher needs
+};
+
+// Everything between the SPU2 mix and the device, independent of any audio library (so a test can drive it).
+// The emulator thread pushes 48 kHz stereo; the device thread calls render(). The queue is held at a target level:
+// a small pitch change (resampling, at most 2 percent) absorbs clock drift, a pitch-preserving stretch slows the sound
+// down smoothly when the emulator runs slower than real time, and a stall fades out and back in. Nothing here touches guest state.
+class Engine {
+public:
+    Engine();
+
+    void push(const std::int16_t *stereo, std::size_t frames);
+    void render(std::int16_t *out, std::size_t frames);
+    void set_volume(int percent);
+    // Test aid: writes what render() produces before the volume is applied (raw 16-bit stereo) to `file`; null stops.
+    void set_tap(std::FILE *file) { tap_ = file; }
+    double queued_ms() const;
+    Stats stats() const;
+
+private:
+    void drain(std::size_t callback_frames);
+    void track_gaps(std::size_t arrived, std::size_t callback_frames);
+    double target_frames() const;
+    void update_fill(std::size_t frames);
+    double controller_tempo() const;
+    void begin_playing();
+    std::size_t ready_frames() const { return ready_.size() / 2; }
+    void resample(float *mix, std::size_t frames, double ratio);
+
+    std::vector<std::int16_t> ring_;
+    std::atomic<std::uint64_t> written_{0}, read_{0};
+    std::atomic<unsigned> overflows_{0};
+
+    Stretcher stretch_;
+    std::vector<float> incoming_, ready_, mix_;
+    double ready_pos_ = 1.0;   // read position in ready_; frame 0 is kept as history for the interpolation
+    bool buffering_ = true;
+    double fill_frames_ = 0.0;          // tracked low level of the waiting sound
+    double max_gap_seconds_ = 0.0, since_burst_seconds_ = 0.0;
+    float gain_ = 0.0f;
+    std::FILE *tap_ = nullptr;
+    std::vector<std::int16_t> tap_buffer_;
+
+    std::atomic<int> volume_{100};
+    std::atomic<std::size_t> pending_{0};
+    std::atomic<unsigned> underruns_{0}, drops_{0};
+    std::atomic<double> tempo_{1.0};
+    std::atomic<double> fill_ms_{0.0};
+};
+
+}
diff --git a/host/audio_stretch.cpp b/host/audio_stretch.cpp
new file mode 100644
index 0000000..9e68266
--- /dev/null
+++ b/host/audio_stretch.cpp
@@ -0,0 +1,92 @@
+#include "audio_stretch.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+namespace host::audio {
+
+namespace {
+
+constexpr double kPi = 3.14159265358979323846;
+constexpr int kScoreStride = 2;   // every other frame is compared when lining windows up
+constexpr float kEnergyFloor = 1e-9f;
+
+}
+
+Stretcher::Stretcher() : window_(kFrame), tail_(static_cast<std::size_t>(kFrame) * 2, 0.0f) {
+    for (int i = 0; i < kFrame; ++i) window_[static_cast<std::size_t>(i)] = static_cast<float>(0.5 - 0.5 * std::cos(2.0 * kPi * i / kFrame));
+}
+
+void Stretcher::feed(const float *stereo, std::size_t frames) { in_.insert(in_.end(), stereo, stereo + frames * 2); }
+
+// The window start in [center - kSearch, center + kSearch] whose first kHop frames best match the input that followed the previous window.
+// The exact continuation is tried first and wins ties, so a steady tempo of 1 reproduces the input.
+int Stretcher::best_start(int center) const {
+    const int lo = std::max(0, center - kSearch), hi = center + kSearch;
+    const float *reference = &in_[static_cast<std::size_t>(previous_ + kHop) * 2];
+    const int natural = previous_ + kHop;
+    const auto score = [&](int start) {
+        const float *c = &in_[static_cast<std::size_t>(start) * 2];
+        float dot = 0.0f, energy = 0.0f;
+        for (int i = 0; i < kHop; i += kScoreStride) {
+            const float a = reference[i * 2] + reference[i * 2 + 1], b = c[i * 2] + c[i * 2 + 1];
+            dot += a * b;
+            energy += b * b;
+        }
+        return dot / std::sqrt(energy + kEnergyFloor);
+    };
+    int best = natural >= lo && natural <= hi ? natural : lo;
+    float best_score = score(best);
+    for (int start = lo; start <= hi; ++start) {
+        if (start == natural) continue;
+        const float s = score(start);
+        if (s > best_score) {
+            best_score = s;
+            best = start;
+        }
+    }
+    return best;
+}
+
+void Stretcher::synthesize(double tempo, std::vector<float> &out) {
+    const int center = static_cast<int>(std::lround(pos_));
+    const int start = have_previous_ ? best_start(center) : std::max(0, center);
+    const float *src = &in_[static_cast<std::size_t>(start) * 2];
+    for (int i = 0; i < kFrame; ++i) {
+        const float w = window_[static_cast<std::size_t>(i)];
+        tail_[static_cast<std::size_t>(i) * 2] += w * src[i * 2];
+        tail_[static_cast<std::size_t>(i) * 2 + 1] += w * src[i * 2 + 1];
+    }
+    out.insert(out.end(), tail_.begin(), tail_.begin() + kHop * 2);
+    std::copy(tail_.begin() + kHop * 2, tail_.end(), tail_.begin());
+    std::fill(tail_.begin() + kHop * 2, tail_.end(), 0.0f);
+    previous_ = start;
+    have_previous_ = true;
+    pos_ += kHop * tempo;
+    trim();
+}
+
+void Stretcher::flush(std::vector<float> &out) {
+    out.insert(out.end(), tail_.begin(), tail_.begin() + kHop * 2);
+    std::fill(tail_.begin(), tail_.end(), 0.0f);
+    have_previous_ = false;
+}
+
+void Stretcher::skip(std::size_t frames) {
+    pos_ += static_cast<double>(frames);
+    have_previous_ = false;
+    trim();
+}
+
+// Drops input no later window can use.
+void Stretcher::trim() {
+    const int needed = std::min(static_cast<int>(std::lround(pos_)) - kSearch, have_previous_ ? previous_ + kHop : std::numeric_limits<int>::max());
+    const int drop = std::min(needed, static_cast<int>(in_.size() / 2));
+    if (drop <= 0) return;
+    in_.erase(in_.begin(), in_.begin() + static_cast<std::ptrdiff_t>(drop) * 2);
+    pos_ -= drop;
+    previous_ -= drop;
+}
+
+}
diff --git a/host/audio_stretch.hpp b/host/audio_stretch.hpp
new file mode 100644
index 0000000..5432241
--- /dev/null
+++ b/host/audio_stretch.hpp
@@ -0,0 +1,47 @@
+#pragma once
+
+#include <cstddef>
+#include <vector>
+
+namespace host::audio {
+
+// Pitch-preserving time stretch of a stereo stream (waveform-similarity overlap-add). Input and output are interleaved float pairs.
+// At tempo 1 the output is the input delayed by one hop; below 1 the sound plays slower, above 1 faster, with the pitch unchanged.
+class Stretcher {
+public:
+    static constexpr int kFrame = 768;        // window length in frames (16 ms)
+    static constexpr int kHop = kFrame / 2;   // frames produced per synthesized window
+    static constexpr int kSearch = 128;       // how far from the nominal position a window may move to line up with the previous one
+
+    // Input frames that must be waiting before another window can be made.
+    static constexpr int kMinPending = kFrame + kSearch + 1;
+
+    Stretcher();
+
+    void feed(const float *stereo, std::size_t frames);
+    // Input frames not yet consumed.
+    std::size_t pending() const {
+        const std::size_t frames = in_.size() / 2, used = static_cast<std::size_t>(pos_ > 0.0 ? pos_ : 0.0);
+        return frames > used ? frames - used : 0;
+    }
+    bool ready() const { return pending() >= static_cast<std::size_t>(kMinPending); }
+    // Appends kHop frames to `out`; the input advances by kHop * tempo frames. Call only when ready().
+    void synthesize(double tempo, std::vector<float> &out);
+    // Appends what is left of the last window faded to silence and forgets the stream position (the next window fades in).
+    void flush(std::vector<float> &out);
+    // Skips input ahead; the next window is not aligned to the previous one, the overlap crossfades the jump.
+    void skip(std::size_t frames);
+
+private:
+    int best_start(int center) const;
+    void trim();
+
+    std::vector<float> window_;
+    std::vector<float> in_;
+    std::vector<float> tail_;   // overlap-add accumulator, kFrame frames
+    double pos_ = 0.0;          // nominal analysis position in frames from the start of in_
+    int previous_ = 0;          // start of the previous window in in_
+    bool have_previous_ = false;
+};
+
+}
