diff --git a/tests/audio_engine_test.cpp b/tests/audio_engine_test.cpp
new file mode 100644
index 0000000..87bda59
--- /dev/null
+++ b/tests/audio_engine_test.cpp
@@ -0,0 +1,151 @@
+// Offline test of the host audio engine in virtual time (no device, no game): a tone is produced the way the emulator produces sound
+// (one frame of samples at a time at some speed) and rendered the way the device asks for it (512 frames per callback). Each scenario
+// is run through the Engine and through a model of the previous output (a queue that plays what is there and zeros when it is dry),
+// and the output is checked for clicks (a second difference far above what the tone itself can make), silence and pitch.
+// build: clang++ -std=c++20 -O2 -I host tests/audio_engine_test.cpp host/audio_engine.cpp host/audio_stretch.cpp -o audio_engine_test
+#include "audio_models.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <functional>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace {
+
+using namespace audio_test;
+
+constexpr double kPi = 3.14159265358979323846;
+constexpr int kRate = host::audio::kSampleRate;
+constexpr int kCallback = 512;
+constexpr double kToneHz = 440.0, kToneHz2 = 1250.0, kAmp = 0.35;
+constexpr double kClickThreshold = 0.02;   // the tones' largest second difference is about 0.005
+constexpr double kPitchTolerance = 0.02;
+constexpr double kSeconds = 12.0, kPitchFrom = 2.0, kSilenceMin = 0.02;
+
+struct Producer {
+    double wall_per_frame = 1.0 / 60.0;     // seconds of wall time one emulated frame takes
+    std::function<double(double)> speed;     // wall time -> emulated seconds per wall second
+    double next = 0.0;
+    double phase = 0.0;
+    double carry = 0.0;
+    double second_weight = 0.3;
+    std::vector<std::int16_t> make(double wall) {
+        const double rate = speed(wall);
+        carry += rate / 60.0 * kRate;
+        const int frames = static_cast<int>(carry);
+        carry -= frames;
+        std::vector<std::int16_t> out(static_cast<std::size_t>(frames) * 2);
+        for (int i = 0; i < frames; ++i, phase += 1.0) {
+            const double v = kAmp * ((1.0 - second_weight) * std::sin(2.0 * kPi * kToneHz * phase / kRate) + second_weight * std::sin(2.0 * kPi * kToneHz2 * phase / kRate));
+            out[static_cast<std::size_t>(i) * 2] = out[static_cast<std::size_t>(i) * 2 + 1] = static_cast<std::int16_t>(v * 32767.0);
+        }
+        return out;
+    }
+};
+
+struct Result {
+    int clicks = 0;
+    double silent_seconds = 0.0;
+    double pitch_hz = 0.0;   // rising zero crossings per second between 2 s and the end (meaningful for the pure tone)
+    host::audio::Stats stats;
+};
+
+// Frame times: the wall time each emulated frame ends. `frame_wall(i)` is the duration of the frame i.
+using FrameTime = std::function<double(int)>;
+
+Result run(Model &m, const FrameTime &frame_wall, const std::function<double(double)> &speed, const std::function<bool(double)> &stalled, bool pure) {
+    Producer p;
+    p.speed = speed;
+    p.second_weight = pure ? 0.0 : 0.3;
+    double device = 0.0, produce_at = 0.0;
+    const double callback_seconds = static_cast<double>(kCallback) / kRate;
+    std::vector<std::int16_t> out(kCallback * 2);
+    int frame = 0, crossings = 0;
+    Result r;
+    double prev1 = 0.0, prev2 = 0.0, zero_run = 0.0;
+    while (device < kSeconds) {
+        const double until = device + callback_seconds;
+        while (produce_at < until) {
+            if (!stalled(produce_at)) {
+                const auto chunk = p.make(produce_at);
+                m.push(chunk.data(), chunk.size() / 2);
+            }
+            produce_at += frame_wall(frame++);
+        }
+        device = until;
+        m.render(out.data(), kCallback);
+        for (int i = 0; i < kCallback; ++i) {
+            const double x = out[static_cast<std::size_t>(i) * 2] / 32768.0;
+            if (device > 1.0 && std::fabs(x - 2.0 * prev1 + prev2) > kClickThreshold) ++r.clicks;
+            if (device > kPitchFrom && prev1 < 0.0 && x >= 0.0) ++crossings;
+            if (std::fabs(x) < 1e-4) zero_run += 1.0 / kRate;
+            else {
+                if (zero_run > kSilenceMin) r.silent_seconds += zero_run;
+                zero_run = 0.0;
+            }
+            prev2 = prev1;
+            prev1 = x;
+        }
+    }
+    r.pitch_hz = crossings / (kSeconds - kPitchFrom);
+    r.stats = m.stats();
+    return r;
+}
+
+struct Scenario {
+    const char *name;
+    FrameTime frame_wall;
+    std::function<double(double)> speed;
+    std::function<bool(double)> stalled;
+};
+
+}
+
+int main() {
+    std::mt19937 rng(7);
+    std::uniform_real_distribution<double> jitter(-0.002, 0.002), unit(0.0, 1.0);
+    const auto uniform = [&](std::mt19937 &g) { return unit(g); };
+    const auto steady = [](double) { return 1.0; };
+    const auto never = [](double) { return false; };
+    const FrameTime exact = [](int) { return 1.0 / 60.0; };
+    const std::vector<Scenario> scenarios = {
+        {"full speed, exact 60 Hz", exact, steady, never},
+        {"full speed, +-2 ms frame jitter", [&](int) { return 1.0 / 60.0 + jitter(rng); }, steady, never},
+        {"slow: 45 fps (speed 0.75) all the time", [](int) { return 1.0 / 45.0; }, [](double) { return 0.75; }, never},
+        {"slow: 30 fps (speed 0.5) from 3 s to 8 s", [](int) { return 1.0 / 60.0; }, [](double t) { return t > 3.0 && t < 8.0 ? 0.5 : 1.0; }, never},
+        {"occasional 45 ms frames (about 1 in 20)", [&](int i) { return i % 20 == 7 ? 0.045 : 1.0 / 60.0 - 0.0025; }, steady, never},
+        {"irregular frames 13..23 ms (about 56 fps)", [&](int) { return 0.013 + 0.010 * uniform(rng); }, steady, never},
+        {"irregular frames 20..45 ms (about 31 fps)", [&](int) { return 0.020 + 0.025 * uniform(rng); }, steady, never},
+        {"irregular frames 15..60 ms (about 27 fps)", [&](int) { return 0.015 + 0.045 * uniform(rng); }, steady, never},
+        {"clock drift: emulator 0.3% fast", exact, [](double) { return 1.003; }, never},
+        {"clock drift: emulator 0.3% slow", exact, [](double) { return 0.997; }, never},
+        {"stall 400 ms, then catch-up at 3x for 0.8 s", exact, [](double t) { return t > 5.4 && t < 6.2 ? 3.0 : 1.0; }, [](double t) { return t > 5.0 && t < 5.4; }},
+        {"netplay stall of 300 ms at 5 s", exact, steady, [](double t) { return t > 5.0 && t < 5.3; }},
+        {"netplay stalls of 80 ms every second", exact, steady, [](double t) { return std::fmod(t, 1.0) > 0.5 && std::fmod(t, 1.0) < 0.58; }},
+    };
+    int failures = 0;
+    std::printf("%-44s | %-28s | %-28s\n", "scenario", "old queue: clicks / silent s", "engine: clicks / silent s / under / drop");
+    for (const Scenario &s : scenarios) {
+        OldQueue old;
+        NewEngine fresh;
+        rng.seed(7);
+        const Result a = run(old, s.frame_wall, s.speed, s.stalled, false);
+        rng.seed(7);
+        const Result b = run(fresh, s.frame_wall, s.speed, s.stalled, false);
+        std::printf("%-44s | %6d / %6.2f              | %6d / %6.2f / %3u / %3u\n", s.name, a.clicks, a.silent_seconds, b.clicks, b.silent_seconds, b.stats.underruns, b.stats.drops);
+        if (b.clicks > 0) ++failures;
+    }
+    for (const double speed : {1.0, 0.75, 0.5}) {
+        NewEngine fresh;
+        const Result r = run(fresh, exact, [speed](double) { return speed; }, never, true);
+        std::printf("pure %.0f Hz tone, emulator at speed %.2f: output %.1f Hz, tempo %.2f, %d clicks\n", kToneHz, speed, r.pitch_hz, r.stats.tempo, r.clicks);
+        if (std::fabs(r.pitch_hz - kToneHz) > kToneHz * kPitchTolerance || r.clicks) ++failures;
+    }
+    std::printf("%s\n", failures ? "FAIL" : "ok: no clicks in the engine, pitch kept");
+    return failures ? 1 : 0;
+}
diff --git a/tests/audio_models.hpp b/tests/audio_models.hpp
new file mode 100644
index 0000000..20bc311
--- /dev/null
+++ b/tests/audio_models.hpp
@@ -0,0 +1,44 @@
+#pragma once
+
+// The two output paths the audio tests compare: the engine, and a model of what the window did before it (shared by audio_engine_test.cpp and audio_replay.cpp).
+#include "audio_engine.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+
+namespace audio_test {
+
+struct Model {
+    virtual ~Model() = default;
+    virtual void push(const std::int16_t *s, std::size_t n) = 0;
+    virtual void render(std::int16_t *out, std::size_t n) = 0;
+    virtual host::audio::Stats stats() { return {}; }
+};
+
+struct NewEngine : Model {
+    host::audio::Engine e;
+    void push(const std::int16_t *s, std::size_t n) override { e.push(s, n); }
+    void render(std::int16_t *out, std::size_t n) override { e.render(out, n); }
+    host::audio::Stats stats() override { return e.stats(); }
+};
+
+// What the window did before: SDL_QueueAudio of every batch (dropped above 500 ms), the device takes what is queued, zeros when dry.
+struct OldQueue : Model {
+    std::deque<std::int16_t> q;
+    void push(const std::int16_t *s, std::size_t n) override {
+        if (q.size() / 2 > 24000) return;
+        q.insert(q.end(), s, s + n * 2);
+    }
+    void render(std::int16_t *out, std::size_t n) override {
+        for (std::size_t i = 0; i < n * 2; ++i) {
+            if (q.empty()) out[i] = 0;
+            else {
+                out[i] = q.front();
+                q.pop_front();
+            }
+        }
+    }
+};
+
+}
diff --git a/tests/audio_replay.cpp b/tests/audio_replay.cpp
new file mode 100644
index 0000000..390d32e
--- /dev/null
+++ b/tests/audio_replay.cpp
@@ -0,0 +1,103 @@
+// Replays real game sound through both output paths in virtual time: the SPU2 mix of a recorded run (PS2_DUMP_AUDIO wav) is delivered frame by frame at the
+// wall times of a real slow run (the frame log, PS2_FRAME_LOG), and each path writes what its device would have played, for listening and for the clip.
+// usage: audio_replay <mix.wav> <frames.txt> <out_dir> [first_frame] [seconds]   -> <out_dir>\before.wav and after.wav (48 kHz stereo)
+// build: scripts\build_audio_test.bat builds it with the test.
+#include "audio_models.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+
+using namespace audio_test;
+
+constexpr int kRate = host::audio::kSampleRate;
+constexpr int kFrameSamples = 800;            // the console's 60 frames per second at 48 kHz
+constexpr int kOldCallbackFrames = 1024;       // the previous window's device buffer
+constexpr int kNewCallbackFrames = 512;
+constexpr std::uint32_t kWavHeaderBytes = 44;
+
+std::vector<std::int16_t> read_wav(const std::string &path) {
+    std::FILE *f = std::fopen(path.c_str(), "rb");
+    if (!f) return {};
+    std::vector<std::uint8_t> bytes;
+    std::uint8_t chunk[1 << 16];
+    for (std::size_t n; (n = std::fread(chunk, 1, sizeof chunk, f)) > 0;) bytes.insert(bytes.end(), chunk, chunk + n);
+    std::fclose(f);
+    if (bytes.size() < kWavHeaderBytes) return {};
+    std::vector<std::int16_t> samples((bytes.size() - kWavHeaderBytes) / 2);
+    std::memcpy(samples.data(), bytes.data() + kWavHeaderBytes, samples.size() * 2);
+    return samples;
+}
+
+void write_wav(const std::string &path, const std::vector<std::int16_t> &samples) {
+    std::FILE *f = std::fopen(path.c_str(), "wb");
+    if (!f) return;
+    const std::uint32_t bytes = static_cast<std::uint32_t>(samples.size() * 2);
+    const std::uint32_t header[] = {0x46464952u, 36 + bytes, 0x45564157u, 0x20746D66u, 16, 0x00020001u, kRate, kRate * 4, 0x00100004u, 0x61746164u, bytes};
+    std::fwrite(header, 4, sizeof header / 4, f);
+    std::fwrite(samples.data(), 2, samples.size(), f);
+    std::fclose(f);
+}
+
+std::vector<double> read_frame_times(const std::string &path) {
+    std::vector<double> ms;
+    std::FILE *f = std::fopen(path.c_str(), "r");
+    if (!f) return ms;
+    double frame, work, wait;
+    while (std::fscanf(f, "%lf %lf %lf", &frame, &work, &wait) == 3) ms.push_back(frame);
+    std::fclose(f);
+    return ms;
+}
+
+// Plays `mix` from `first` through `model`, the frame i arriving at the wall time the frame log gives; the device asks for `callback` frames at a time.
+std::vector<std::int16_t> play(Model &model, const std::vector<std::int16_t> &mix, const std::vector<double> &frame_ms, std::size_t first, std::size_t callback,
+                               double seconds) {
+    std::vector<std::int16_t> out;
+    std::vector<std::int16_t> block(callback * 2);
+    double arrival = 0.0, device = 0.0;
+    std::size_t frame = 0;
+    const double callback_seconds = static_cast<double>(callback) / kRate;
+    while (device < seconds && frame < frame_ms.size()) {
+        const double until = device + callback_seconds;
+        while (arrival <= until && frame < frame_ms.size()) {
+            const std::size_t at = (first + frame) * kFrameSamples * 2;
+            if (at + kFrameSamples * 2 <= mix.size()) model.push(&mix[at], kFrameSamples);
+            arrival += frame_ms[frame++] / 1000.0;
+        }
+        device = until;
+        model.render(block.data(), callback);
+        out.insert(out.end(), block.begin(), block.end());
+    }
+    return out;
+}
+
+}
+
+int main(int argc, char **argv) {
+    if (argc < 4) {
+        std::fprintf(stderr, "usage: audio_replay <mix.wav> <frames.txt> <out_dir> [first_frame] [seconds]\n");
+        return 2;
+    }
+    const std::vector<std::int16_t> mix = read_wav(argv[1]);
+    const std::vector<double> frame_ms = read_frame_times(argv[2]);
+    const std::string out_dir = argv[3];
+    const std::size_t first = argc > 4 ? static_cast<std::size_t>(std::atoll(argv[4])) : 0;
+    const double seconds = argc > 5 ? std::atof(argv[5]) : 10.0;
+    if (mix.empty() || frame_ms.empty()) {
+        std::fprintf(stderr, "cannot read the mix or the frame log\n");
+        return 1;
+    }
+    OldQueue old;
+    NewEngine fresh;
+    write_wav(out_dir + "/before.wav", play(old, mix, frame_ms, first, kOldCallbackFrames, seconds));
+    write_wav(out_dir + "/after.wav", play(fresh, mix, frame_ms, first, kNewCallbackFrames, seconds));
+    const host::audio::Stats s = fresh.stats();
+    std::printf("engine: %u underruns, %u drops, tempo now %.2f\n", s.underruns, s.drops, s.tempo);
+    return 0;
+}
diff --git a/tests/detmath_test.cpp b/tests/detmath_test.cpp
new file mode 100644
index 0000000..528defc
--- /dev/null
+++ b/tests/detmath_test.cpp
@@ -0,0 +1,149 @@
+// detmath_test: the deterministic sin / atan / atan2 / exp of ps2/detmath.hpp. Prints one hash of all results per function over a fixed set of inputs; the same hash
+// must come out of every build of this file (any optimisation level, any -march, fused multiply-add allowed or not), on any CPU. `--expect <sin> <sin*> <atan> <atan2> <exp>`
+// exits 1 when a hash differs. `sin*` is sin of floats of every magnitude (up to 3e38, where the argument reduction is only as good as a double allows and the C library is exact).
+//  Also prints how far the results are from the C library's (informational: the C library is what differs between machines).
+#include "ps2/detmath.hpp"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+
+namespace {
+
+constexpr int kSamplesPerClass = 400000;
+constexpr std::uint64_t kFnvOffset = 14695981039346656037ull, kFnvPrime = 1099511628211ull;
+
+std::uint64_t g_seed = 0x9E3779B97F4A7C15ull;
+
+std::uint32_t next() {
+    g_seed ^= g_seed << 13;
+    g_seed ^= g_seed >> 7;
+    g_seed ^= g_seed << 17;
+    return static_cast<std::uint32_t>(g_seed >> 16);
+}
+
+float unit() { return static_cast<float>(next() & 0xFFFFFF) / static_cast<float>(0x1000000); }
+float spread(float range) { return (unit() * 2.0f - 1.0f) * range; }
+
+std::uint32_t bits(float v) {
+    std::uint32_t b;
+    std::memcpy(&b, &v, sizeof b);
+    return b;
+}
+
+float from_bits(std::uint32_t b) {
+    float v;
+    std::memcpy(&v, &b, sizeof v);
+    return v;
+}
+
+// A random finite float of any magnitude.
+float any_float() {
+    float v = from_bits(next());
+    while (!std::isfinite(v)) v = from_bits(next());
+    return v;
+}
+
+std::int64_t ulps(float a, float b) {
+    if (std::isnan(a) || std::isnan(b)) return std::isnan(a) == std::isnan(b) ? 0 : -1;
+    if (std::isinf(a) || std::isinf(b)) return a == b ? 0 : -1;
+    const auto key = [](float v) {
+        const std::int32_t i = static_cast<std::int32_t>(bits(v));
+        return i < 0 ? std::int64_t(std::numeric_limits<std::int32_t>::min()) - i : std::int64_t(i);
+    };
+    const std::int64_t d = key(a) - key(b);
+    return d < 0 ? -d : d;
+}
+
+struct Tally {
+    const char *name;
+    std::uint64_t hash = kFnvOffset;
+    std::int64_t worst = 0;
+    std::uint64_t differing = 0, total = 0;
+    void add(float ours, float libm) {
+        hash = (hash ^ bits(ours)) * kFnvPrime;
+        const std::int64_t d = ulps(ours, libm);
+        worst = d > worst ? d : worst;
+        differing += d != 0;
+        ++total;
+    }
+    void print() const {
+        std::printf("%-6s hash %016llx  %llu inputs, %llu differ from the C library, worst %lld ulp\n", name, static_cast<unsigned long long>(hash), static_cast<unsigned long long>(total),
+                    static_cast<unsigned long long>(differing), static_cast<long long>(worst));
+    }
+};
+
+// Anchors every build must give exactly.
+int check_anchors() {
+    int bad = 0;
+    const auto expect = [&](const char *what, float got, float want) {
+        if (bits(got) != bits(want)) {
+            std::printf("ANCHOR %s: got %.9g (%08x) want %.9g (%08x)\n", what, got, bits(got), want, bits(want));
+            ++bad;
+        }
+    };
+    expect("sin 0", ps2::detmath::sin(0.0f), 0.0f);
+    expect("sin pi/2", ps2::detmath::sin(1.57079637f), 1.0f);
+    expect("atan 1", ps2::detmath::atan(1.0f), 0.785398185f);
+    expect("atan2 1 1", ps2::detmath::atan2(1.0f, 1.0f), 0.785398185f);
+    expect("atan2 1 -1", ps2::detmath::atan2(1.0f, -1.0f), 2.35619450f);
+    expect("atan2 -1 -1", ps2::detmath::atan2(-1.0f, -1.0f), -2.35619450f);
+    expect("atan2 0 -1", ps2::detmath::atan2(0.0f, -1.0f), 3.14159274f);
+    expect("atan2 -0 -1", ps2::detmath::atan2(-0.0f, -1.0f), -3.14159274f);
+    expect("atan2 1 0", ps2::detmath::atan2(1.0f, 0.0f), 1.57079637f);
+    expect("atan2 0 0", ps2::detmath::atan2(0.0f, 0.0f), 0.0f);
+    expect("exp 0", ps2::detmath::exp(0.0f), 1.0f);
+    expect("exp 1", ps2::detmath::exp(1.0f), 2.71828175f);
+    expect("exp -1", ps2::detmath::exp(-1.0f), 0.367879450f);
+    expect("exp 100", ps2::detmath::exp(100.0f), std::numeric_limits<float>::infinity());
+    expect("exp -200", ps2::detmath::exp(-200.0f), 0.0f);
+    if (!std::isnan(ps2::detmath::sin(std::numeric_limits<float>::infinity()))) ++bad;
+    if (!std::isnan(ps2::detmath::exp(std::numeric_limits<float>::quiet_NaN()))) ++bad;
+    return bad;
+}
+
+}
+
+int main(int argc, char **argv) {
+    ps2::detmath::pin_fp_environment();
+    Tally sin_t{"sin"}, sin_wild_t{"sin*"}, atan_t{"atan"}, atan2_t{"atan2"}, exp_t{"exp"};
+    for (int i = 0; i < kSamplesPerClass; ++i) {
+        const float ranges[3] = {6.5f, 1000.0f, 1.0e6f};
+        for (float range : ranges) {
+            const float x = spread(range);
+            sin_t.add(ps2::detmath::sin(x), std::sin(x));
+            atan_t.add(ps2::detmath::atan(x), std::atan(x));
+            const float y = spread(range);
+            atan2_t.add(ps2::detmath::atan2(y, x), std::atan2(y, x));
+        }
+        const float x = any_float();
+        sin_wild_t.add(ps2::detmath::sin(x), std::sin(x));
+        atan_t.add(ps2::detmath::atan(x), std::atan(x));
+        const float wild_y = any_float();
+        atan2_t.add(ps2::detmath::atan2(wild_y, x), std::atan2(wild_y, x));
+        const float z = spread(110.0f);
+        exp_t.add(ps2::detmath::exp(-z), std::exp(-z));
+        const float tiny = spread(1.0e-3f);
+        exp_t.add(ps2::detmath::exp(tiny), std::exp(tiny));
+    }
+    sin_t.print();
+    sin_wild_t.print();
+    atan_t.print();
+    atan2_t.print();
+    exp_t.print();
+    const int bad = check_anchors();
+    std::printf("anchors: %s\n", bad ? "FAILED" : "all exact");
+    int mismatch = bad;
+    if (argc == 7 && std::strcmp(argv[1], "--expect") == 0) {
+        const Tally *tallies[5] = {&sin_t, &sin_wild_t, &atan_t, &atan2_t, &exp_t};
+        for (int i = 0; i < 5; ++i)
+            if (std::strtoull(argv[2 + i], nullptr, 16) != tallies[i]->hash) {
+                std::printf("HASH MISMATCH for %s\n", tallies[i]->name);
+                ++mismatch;
+            }
+    }
+    return mismatch ? 1 : 0;
+}
diff --git a/tests/overlay_scenes.cpp b/tests/overlay_scenes.cpp
new file mode 100644
index 0000000..5bab1dd
--- /dev/null
+++ b/tests/overlay_scenes.cpp
@@ -0,0 +1,103 @@
+// overlay_scenes <overlay dir> <out prefix> <width> <height>: paints every co-op overlay scene over a stand-in picture (a dark gradient, or the title's black
+// for the pages that sit on it) and writes <prefix>_<scene>.ppm. No game, no window: the layout check of runtime/src/overlay.
+#include "overlay/overlay.hpp"
+#include "ps2/pad.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace ps2 {
+bool read_pad_sample(int, PadSample &) { return false; }   // no pads here: the page is never dismissed
+}
+
+namespace {
+
+void write(const std::string &path, const std::vector<std::uint32_t> &px, std::uint32_t w, std::uint32_t h) {
+    std::FILE *f = std::fopen(path.c_str(), "wb");
+    if (!f) return;
+    std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+    for (std::uint32_t p : px) {
+        const unsigned char rgb[3] = {static_cast<unsigned char>(p), static_cast<unsigned char>(p >> 8), static_cast<unsigned char>(p >> 16)};
+        std::fwrite(rgb, 1, 3, f);
+    }
+    std::fclose(f);
+}
+
+std::vector<std::uint32_t> backdrop(std::uint32_t w, std::uint32_t h) {
+    std::vector<std::uint32_t> px(static_cast<std::size_t>(w) * h);
+    for (std::uint32_t y = 0; y < h; ++y)
+        for (std::uint32_t x = 0; x < w; ++x) {
+            const std::uint32_t v = 20 + 60 * y / h;
+            px[static_cast<std::size_t>(y) * w + x] = v | v << 8 | v << 16 | 0xFF000000u;
+        }
+    return px;
+}
+
+// The game's loading picture in miniature: blue with a red block where the logo is, the worst background for red and grey text.
+std::vector<std::uint32_t> busy(std::uint32_t w, std::uint32_t h) {
+    std::vector<std::uint32_t> px(static_cast<std::size_t>(w) * h, 0xFF603000u);
+    for (std::uint32_t y = h / 8; y < h * 3 / 8; ++y)
+        for (std::uint32_t x = w / 4; x < w * 3 / 4; ++x) px[static_cast<std::size_t>(y) * w + x] = 0xFF2828B4u;
+    return px;
+}
+
+}
+
+int main(int argc, char **argv) {
+    if (argc < 5) return 2;
+    const std::string dir = argv[1], prefix = argv[2];
+    const std::uint32_t w = static_cast<std::uint32_t>(std::atoi(argv[3])), h = static_cast<std::uint32_t>(std::atoi(argv[4]));
+    if (!ps2::overlay::load_assets(dir)) {
+        std::fprintf(stderr, "no art in %s\n", dir.c_str());
+        return 1;
+    }
+    namespace o = ps2::overlay;
+    static bool title = true;
+    o::set_title_probe([] { return title; });
+    o::Banner banner;
+    banner.host = true;
+    banner.names = {"Alex", "Sam", "Kim"};
+    o::set_banner(banner);
+    bool bright = false;
+    const auto shot = [&](const char *name) {
+        o::on_vblank(1000);
+        std::vector<std::uint32_t> picture = bright ? busy(w, h) : backdrop(w, h);
+        if (o::compose(picture, w, h)) write(prefix + "_" + name + ".ppm", picture, w, h);
+        else std::fprintf(stderr, "%s: nothing drawn\n", name);
+    };
+    shot("banner_host");
+    banner.host = false;
+    o::set_banner(banner);
+    shot("banner_guest");
+    o::loading_receiving("Alex", 63);
+    shot("receiving");
+    o::loading_sending("Sam", 40);
+    shot("sending");
+    o::loading_waiting("Kim");
+    shot("waiting");
+    o::loading_waiting("WWWWWWWWWWWW");
+    shot("waiting_long");
+    o::loading_end();
+    o::stall("Sam", 1500, 30);
+    shot("stall_short");
+    o::stall("Sam", 10000, 30);
+    shot("stall_long");
+    bright = true;
+    shot("stall_long_busy");
+    o::set_rows({{"Alex", "", -1, false}, {"Sam", "NOT RESPONDING", -1, true}, {"Kim", "", -1, false}});
+    shot("stall_rows_busy");
+    o::stall_end();
+    o::set_rows({{"Alex", "LOADING 62%", 62, false}, {"Sam", "LOADING 5 MB", -1, false}, {"Kim", "LOADED", 100, false}});
+    o::level_loading(true);
+    shot("level_load_busy");
+    o::notice("Kim's game crashed", "The game continues without Kim. Kim can rejoin from the launcher");
+    shot("notice_busy");
+    o::level_loading(false);
+    o::set_rows({});
+    bright = false;
+    o::session_ended(o::Ending::host_lost, "Alex");
+    shot("ended");
+    return 0;
+}
