+#pragma once
+
+#include "audio_engine.hpp"
+
+// Host audio output: the SDL device, fed by an Engine from the SPU2 sink, and the master volume (applied to what reaches the device only,
+// never to the SPU2 mix, the dumps or guest state).
+namespace host::audio {
+
+constexpr int kMaxVolume = 100;
+
+// Percent 0 to 100; out of range values are clamped. Without a call the value of PS2_VOLUME is used when the device opens, else 100.
+void set_volume(int percent);
+// Opens the device and routes the SPU2 mix to it; false (and no sound, the emulator keeps its own clock) when no device opens.
+bool open();
+double queued_ms();
+Stats stats();
+
+}
diff --git a/host/audio_engine.cpp b/host/audio_engine.cpp
new file mode 100644
index 0000000..5fd4a02
--- /dev/null
+++ b/host/audio_engine.cpp
@@ -0,0 +1,191 @@
+#include "audio_engine.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace host::audio {
+
+namespace {
+
+constexpr std::size_t kRingFrames = 1u << 15;
+constexpr double kFramesPerMs = kSampleRate / 1000.0;
+constexpr double kMinTargetFrames = 20.0 * kFramesPerMs;   // lowest level the waiting sound (beyond Stretcher::kMinPending) is steered to between two emulator bursts...
+constexpr double kMaxTargetFrames = 80.0 * kFramesPerMs;   // ...raised up to this when the bursts come far apart
+constexpr double kGapShare = 0.6;                          // share of the longest recent gap between bursts that is held in reserve (the sound plays slower than real time then)
+constexpr double kGapMemorySeconds = 2.0;
+constexpr std::size_t kBurstMinFrames = 100;               // arrivals smaller than this are not bursts
+constexpr double kRebufferFrames = Stretcher::kMinPending + 15.0 * kFramesPerMs;   // waiting sound needed to start again after a stall
+constexpr double kMaxPending = Stretcher::kMinPending + 150.0 * kFramesPerMs;      // more than this is old sound: skip ahead
+constexpr double kTroughReleaseSeconds = 0.5;    // the tracked low level rises this slowly (it falls at once)
+constexpr double kDeadBandFrames = 6.0 * kFramesPerMs;   // around the target the speed stays exactly 1
+constexpr double kFloorDepthFrames = 16.0 * kFramesPerMs; // this far below the target the speed has fallen to the minimum
+constexpr double kCeilingFrames = 40.0 * kFramesPerMs;   // this far above the target the speed has risen to the maximum
+constexpr double kTempoMin = 0.4, kTempoMax = 1.1;
+constexpr double kResampleMax = 0.02;        // speed changes up to this are done by resampling (a pitch change nobody hears)...
+constexpr double kResampleFade = 0.04;       // ...and handed over to the stretch (which keeps the pitch) completely by this
+constexpr double kInterpolationAhead = 2.0;
+constexpr float kFullScale = 32768.0f;
+constexpr std::size_t kReservedFrames = 1u << 13;   // working buffers are sized up front so the device callback does not allocate
+
+// The resampling share of a playback speed: all of it for small changes, none for large ones, continuous in between.
+double resample_ratio(double tempo) {
+    const double change = std::fabs(tempo - 1.0);
+    const double share = change <= kResampleMax ? change : std::max(0.0, kResampleFade - change);
+    return tempo < 1.0 ? 1.0 - share : 1.0 + share;
+}
+
+std::int16_t to_pcm(float sample) { return static_cast<std::int16_t>(std::lrintf(std::clamp(sample * kFullScale, -kFullScale, kFullScale - 1.0f))); }
+
+float cubic(const float *p, double t) {
+    const float t1 = static_cast<float>(t), t2 = t1 * t1, t3 = t2 * t1;
+    return 0.5f * ((2.0f * p[0]) + (-p[-2] + p[2]) * t1 + (2.0f * p[-2] - 5.0f * p[0] + 4.0f * p[2] - p[4]) * t2 + (-p[-2] + 3.0f * p[0] - 3.0f * p[2] + p[4]) * t3);
+}
+
+}
+
+Engine::Engine() : ring_(kRingFrames * 2), ready_(2, 0.0f) {
+    incoming_.reserve(kReservedFrames * 2);
+    ready_.reserve(kReservedFrames * 2);
+    mix_.reserve(kReservedFrames * 2);
+}
+
+void Engine::set_volume(int percent) { volume_.store(std::clamp(percent, 0, 100), std::memory_order_relaxed); }
+
+void Engine::push(const std::int16_t *stereo, std::size_t frames) {
+    const std::uint64_t w = written_.load(std::memory_order_relaxed), r = read_.load(std::memory_order_acquire);
+    const std::size_t room = kRingFrames - static_cast<std::size_t>(w - r);
+    if (frames > room) {
+        overflows_.fetch_add(1, std::memory_order_relaxed);
+        frames = room;
+    }
+    for (std::size_t i = 0; i < frames; ++i) {
+        const std::size_t at = static_cast<std::size_t>((w + i) & (kRingFrames - 1)) * 2;
+        ring_[at] = stereo[i * 2];
+        ring_[at + 1] = stereo[i * 2 + 1];
+    }
+    written_.store(w + frames, std::memory_order_release);
+}
+
+// Remembers the longest recent time between two bursts of sound from the emulator.
+void Engine::track_gaps(std::size_t arrived, std::size_t callback_frames) {
+    const double seconds = static_cast<double>(callback_frames) / kSampleRate;
+    max_gap_seconds_ *= std::exp(-seconds / kGapMemorySeconds);
+    since_burst_seconds_ += seconds;
+    if (arrived < kBurstMinFrames) return;
+    max_gap_seconds_ = std::max(max_gap_seconds_, since_burst_seconds_);
+    since_burst_seconds_ = 0.0;
+}
+
+void Engine::drain(std::size_t callback_frames) {
+    const std::uint64_t w = written_.load(std::memory_order_acquire), r = read_.load(std::memory_order_relaxed);
+    const std::size_t frames = static_cast<std::size_t>(w - r);
+    incoming_.resize(frames * 2);
+    for (std::size_t i = 0; i < frames; ++i) {
+        const std::size_t at = static_cast<std::size_t>((r + i) & (kRingFrames - 1)) * 2;
+        incoming_[i * 2] = static_cast<float>(ring_[at]) / kFullScale;
+        incoming_[i * 2 + 1] = static_cast<float>(ring_[at + 1]) / kFullScale;
+    }
+    read_.store(w, std::memory_order_release);
+    stretch_.feed(incoming_.data(), frames);
+    track_gaps(frames, callback_frames);
+}
+
+double Engine::queued_ms() const {
+    const std::uint64_t waiting = written_.load(std::memory_order_acquire) - read_.load(std::memory_order_acquire);
+    return (static_cast<double>(waiting) + static_cast<double>(pending_.load(std::memory_order_relaxed))) / kFramesPerMs;
+}
+
+Stats Engine::stats() const {
+    return {underruns_.load(), drops_.load(), overflows_.load(), tempo_.load(), fill_ms_.load()};
+}
+
+// Follows the low points of the waiting sound: the emulator delivers it in bursts (one per frame), so the level just before a burst is what must stay above zero.
+void Engine::update_fill(std::size_t frames) {
+    const double usable = std::max(0.0, static_cast<double>(stretch_.pending()) - Stretcher::kMinPending);
+    const double alpha = 1.0 - std::exp(-static_cast<double>(frames) / kSampleRate / kTroughReleaseSeconds);
+    fill_frames_ = usable < fill_frames_ ? usable : fill_frames_ + alpha * (usable - fill_frames_);
+    fill_ms_.store(fill_frames_ / kFramesPerMs, std::memory_order_relaxed);
+}
+
+double Engine::target_frames() const { return std::clamp(max_gap_seconds_ * kSampleRate * kGapShare, kMinTargetFrames, kMaxTargetFrames); }
+
+// Playback speed that steers the tracked low level to the target: exactly 1 around it.
+double Engine::controller_tempo() const {
+    const double target = target_frames();
+    if (fill_frames_ < target - kDeadBandFrames)
+        return std::max(kTempoMin, 1.0 - (1.0 - kTempoMin) * (target - kDeadBandFrames - fill_frames_) / std::max(1.0, kFloorDepthFrames - kDeadBandFrames));
+    if (fill_frames_ > target + kDeadBandFrames)
+        return std::min(kTempoMax, 1.0 + (kTempoMax - 1.0) * (fill_frames_ - target - kDeadBandFrames) / (kCeilingFrames - kDeadBandFrames));
+    return 1.0;
+}
+
+void Engine::begin_playing() {
+    buffering_ = false;
+    fill_frames_ = std::max(0.0, static_cast<double>(stretch_.pending()) - Stretcher::kMinPending);
+}
+
+// Reads `frames` output frames from ready_ at `ratio` input frames each; what ready_ cannot supply is silence.
+void Engine::resample(float *mix, std::size_t frames, double ratio) {
+    std::size_t n = 0;
+    for (; n < frames; ++n) {
+        const auto i = static_cast<std::size_t>(ready_pos_);
+        if (static_cast<double>(i) + kInterpolationAhead >= static_cast<double>(ready_frames())) break;
+        const double t = ready_pos_ - static_cast<double>(i);
+        mix[n * 2] = cubic(&ready_[i * 2], t);
+        mix[n * 2 + 1] = cubic(&ready_[i * 2 + 1], t);
+        ready_pos_ += ratio;
+    }
+    std::fill(mix + n * 2, mix + frames * 2, 0.0f);
+    const auto consumed = static_cast<std::size_t>(ready_pos_);
+    if (consumed > 1) {
+        ready_.erase(ready_.begin(), ready_.begin() + static_cast<std::ptrdiff_t>(consumed - 1) * 2);
+        ready_pos_ -= static_cast<double>(consumed - 1);
+    }
+}
+
+void Engine::render(std::int16_t *out, std::size_t frames) {
+    drain(frames);
+    update_fill(frames);
+    if (buffering_ && static_cast<double>(stretch_.pending()) >= kRebufferFrames) begin_playing();
+    double ratio = 1.0;
+    if (!buffering_) {
+        const double tempo = controller_tempo();
+        ratio = resample_ratio(tempo);
+        tempo_.store(tempo, std::memory_order_relaxed);
+        if (static_cast<double>(stretch_.pending()) > kMaxPending) {
+            stretch_.skip(stretch_.pending() - static_cast<std::size_t>(Stretcher::kMinPending + target_frames()));
+            drops_.fetch_add(1, std::memory_order_relaxed);
+        }
+        while (ready_pos_ + static_cast<double>(frames) * ratio + kInterpolationAhead >= static_cast<double>(ready_frames())) {
+            if (!stretch_.ready()) {
+                stretch_.flush(ready_);
+                buffering_ = true;
+                underruns_.fetch_add(1, std::memory_order_relaxed);
+                tempo_.store(1.0, std::memory_order_relaxed);
+                ratio = 1.0;
+                break;
+            }
+            stretch_.synthesize(tempo / ratio, ready_);
+        }
+    }
+    mix_.resize(frames * 2);
+    resample(mix_.data(), frames, ratio);
+    pending_.store(stretch_.pending(), std::memory_order_relaxed);
+
+    if (tap_) {
+        tap_buffer_.resize(frames * 2);
+        for (std::size_t i = 0; i < frames * 2; ++i) tap_buffer_[i] = to_pcm(mix_[i]);
+        std::fwrite(tap_buffer_.data(), sizeof(std::int16_t), frames * 2, tap_);
+    }
+    const float target = static_cast<float>(volume_.load(std::memory_order_relaxed)) / 100.0f;
+    const float step = (target - gain_) / static_cast<float>(frames);
+    for (std::size_t i = 0; i < frames; ++i) {
+        gain_ += step;
+        for (std::size_t c = 0; c < 2; ++c) {
+            out[i * 2 + c] = to_pcm(mix_[i * 2 + c] * gain_);
+        }
+    }
+    gain_ = target;
+}
+
+}
