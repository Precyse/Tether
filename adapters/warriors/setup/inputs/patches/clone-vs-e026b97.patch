index 0000000..39548b5
--- /dev/null
+++ b/host/pacing.hpp
@@ -0,0 +1,10 @@
+#pragma once
+
+// Frame pacing of the window: holds emulation to the console's frame rate by the host clock.
+namespace host::pacing {
+
+// Returns when the next frame is due at `hz` frames per second. A frame that ran late shortens the following ones so the average stays
+// exact; after falling more than kMaxLateFrames behind the schedule restarts at the current time instead of fast-forwarding.
+void wait_for_next_frame(unsigned hz);
+
+}
diff --git a/host/pads.cpp b/host/pads.cpp
new file mode 100644
index 0000000..a573386
--- /dev/null
+++ b/host/pads.cpp
@@ -0,0 +1,144 @@
+#include "pads.hpp"
+
+#include "ps2/pad.hpp"
+#include "virtual_pads.hpp"
+
+#include <SDL.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace host::pads {
+
+namespace {
+
+constexpr int kTriggerThreshold = 2000;
+constexpr int kAxisToByteShift = 8;
+constexpr int kAxisRange = 32768;
+constexpr int kLeftDeadZone = 7849;     // XInput's own stick dead zones: a resting stick reads as centred
+constexpr int kRightDeadZone = 8689;
+constexpr Uint32 kRumbleMs = 200;
+
+struct Binding {
+    SDL_GameControllerButton button;
+    std::uint16_t mask;
+};
+
+// Buttons by position on the pad (A is the bottom face button, the PS2's cross), whatever the pad's own labels say.
+constexpr Binding kButtons[] = {
+    {SDL_CONTROLLER_BUTTON_A, kCross},          {SDL_CONTROLLER_BUTTON_B, kCircle},
+    {SDL_CONTROLLER_BUTTON_X, kSquare},         {SDL_CONTROLLER_BUTTON_Y, kTriangle},
+    {SDL_CONTROLLER_BUTTON_LEFTSHOULDER, kL1},  {SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, kR1},
+    {SDL_CONTROLLER_BUTTON_LEFTSTICK, kL3},     {SDL_CONTROLLER_BUTTON_RIGHTSTICK, kR3},
+    {SDL_CONTROLLER_BUTTON_BACK, kSelect},      {SDL_CONTROLLER_BUTTON_START, kStart},
+    {SDL_CONTROLLER_BUTTON_DPAD_UP, kUp},       {SDL_CONTROLLER_BUTTON_DPAD_DOWN, kDown},
+    {SDL_CONTROLLER_BUTTON_DPAD_LEFT, kLeft},   {SDL_CONTROLLER_BUTTON_DPAD_RIGHT, kRight},
+};
+
+// Which physical controller a port belongs to: its GUID (model) and serial (the unit, when the pad reports one).
+struct Identity {
+    SDL_JoystickGUID guid{};
+    std::string serial;
+    bool operator==(const Identity &o) const { return std::memcmp(&guid, &o.guid, sizeof guid) == 0 && serial == o.serial; }
+};
+
+struct Port {
+    SDL_GameController *controller = nullptr;   // null while unplugged
+    Identity owner;                             // the last controller that had this port
+    bool claimed = false;
+};
+
+Port g_ports[ps2::kPadCount];
+
+Identity identity_of(SDL_GameController *controller) {
+    const char *serial = SDL_GameControllerGetSerial(controller);
+    return {SDL_JoystickGetGUID(SDL_GameControllerGetJoystick(controller)), serial ? serial : ""};
+}
+
+// The port the controller returns to if it had one, else the first port no controller ever had, else the first free one.
+Port *port_for(const Identity &id) {
+    Port *never_used = nullptr, *free_port = nullptr;
+    for (Port &p : g_ports) {
+        if (p.controller) continue;
+        if (p.claimed && p.owner == id) return &p;
+        if (!p.claimed && !never_used) never_used = &p;
+        if (!free_port) free_port = &p;
+    }
+    return never_used ? never_used : free_port;
+}
+
+std::uint8_t stick_byte(SDL_GameController *pad, SDL_GameControllerAxis a, int dead_zone) {
+    const int v = SDL_GameControllerGetAxis(pad, a);
+    if (std::abs(v) < dead_zone) return kAxisCenter;
+    return static_cast<std::uint8_t>(std::clamp((v + kAxisRange) >> kAxisToByteShift, 0, 255));
+}
+
+SDL_GameController *controller_on(int port) { return port >= 0 && port < ps2::kPadCount ? g_ports[port].controller : nullptr; }
+
+}
+
+void prepare() {
+    SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");    // a pad keeps playing while another window has the focus
+    SDL_SetHint(SDL_HINT_GAMECONTROLLER_USE_BUTTON_LABELS, "0");    // Nintendo pads report A for the bottom button like the others
+}
+
+void attach(int device) {
+    if (!SDL_IsGameController(device) || (virtual_pads_active() && !SDL_JoystickIsVirtual(device))) return;
+    const SDL_JoystickID instance = SDL_JoystickGetDeviceInstanceID(device);
+    for (const Port &p : g_ports)
+        if (p.controller && SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(p.controller)) == instance) return;
+    SDL_GameController *controller = SDL_GameControllerOpen(device);
+    if (!controller) return;
+    const Identity id = identity_of(controller);
+    Port *port = port_for(id);
+    if (!port) {
+        SDL_GameControllerClose(controller);
+        return;
+    }
+    port->controller = controller;
+    port->owner = id;
+    port->claimed = true;
+    char guid[33];
+    SDL_JoystickGetGUIDString(id.guid, guid, sizeof guid);
+    std::fprintf(stderr, "[pads] %s (type %d, guid %s, serial '%s') on pad port %d\n", SDL_GameControllerName(controller), static_cast<int>(SDL_GameControllerGetType(controller)),
+                 guid, id.serial.c_str(), static_cast<int>(port - g_ports) + 1);
+}
+
+void detach(std::int32_t instance) {
+    for (Port &p : g_ports)
+        if (p.controller && instance == SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(p.controller))) {
+            SDL_GameControllerClose(p.controller);
+            p.controller = nullptr;
+            std::fprintf(stderr, "[pads] controller left pad port %d\n", static_cast<int>(&p - g_ports) + 1);
+        }
+}
+
+bool read(int port, Reading &out) {
+    SDL_GameController *pad = controller_on(port);
+    if (!pad) return false;
+    out = Reading{};
+    for (const Binding &b : kButtons)
+        if (SDL_GameControllerGetButton(pad, b.button)) out.pressed |= b.mask;
+    const auto trigger = [&](SDL_GameControllerAxis a, std::uint16_t bit, std::uint8_t &pressure) {
+        const int v = SDL_GameControllerGetAxis(pad, a);
+        if (v <= kTriggerThreshold || (out.pressed & bit)) return;
+        out.pressed |= bit;
+        pressure = static_cast<std::uint8_t>(std::max(1, v * 255 / 32767));
+    };
+    trigger(SDL_CONTROLLER_AXIS_TRIGGERLEFT, kL2, out.l2);
+    trigger(SDL_CONTROLLER_AXIS_TRIGGERRIGHT, kR2, out.r2);
+    out.lx = stick_byte(pad, SDL_CONTROLLER_AXIS_LEFTX, kLeftDeadZone);
+    out.ly = stick_byte(pad, SDL_CONTROLLER_AXIS_LEFTY, kLeftDeadZone);
+    out.rx = stick_byte(pad, SDL_CONTROLLER_AXIS_RIGHTX, kRightDeadZone);
+    out.ry = stick_byte(pad, SDL_CONTROLLER_AXIS_RIGHTY, kRightDeadZone);
+    return true;
+}
+
+void rumble(int port, std::uint16_t strong, std::uint16_t weak) {
+    if (SDL_GameController *pad = controller_on(port)) SDL_GameControllerRumble(pad, strong, weak, strong || weak ? kRumbleMs : 0);
+}
+
+}
