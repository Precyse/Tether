@@ -0,0 +1,24 @@
+#pragma once
+
+#include "controller.hpp"
+
+#include <cstdint>
+
+// Physical controllers behind the window's pad ports 0 to ps2::kPadCount - 1: every SDL game controller (Xbox, PlayStation, Switch Pro, generic), one list for all platforms.
+// A controller takes a pad port when it connects and keeps it while it is unplugged: the same controller returns to the same port.
+namespace host::pads {
+
+// Sets the SDL hints the controllers need; before SDL_Init.
+void prepare();
+
+// SDL reported a controller added or removed.
+void attach(int device);
+void detach(std::int32_t instance);
+
+// Reads the controller on `port`. False when there is none.
+bool read(int port, Reading &out);
+
+// Rumble motors of the controller on `port`, 0 to 65535 each; both 0 stops them.
+void rumble(int port, std::uint16_t strong, std::uint16_t weak);
+
+}
diff --git a/host/profile_win.cpp b/host/profile_win.cpp
new file mode 100644
index 0000000..b177bc3
--- /dev/null
+++ b/host/profile_win.cpp
@@ -0,0 +1,179 @@
+// Sampling profiler for the Windows build, started by the environment (no code in main): PS2_SAMPLE=<file> samples every thread of the process
+// about every millisecond (suspend, read the instruction pointer, resume) after PS2_SAMPLE_FROM seconds (default 5) and rewrites <file> every two seconds.
+// File lines: "T <thread id> <start address rva>" per thread, then "S <thread id> <rva> <count>" for code in the executable and
+// "M <thread id> <module name> <count>" for code in any other module (a thread parked in ntdll is waiting), plus
+// "C <thread id> <module name> <count> <caller rva>..." when a word near the top of the stack of such a sample is an address in the executable
+// (names the probable caller of a leaf routine such as memcpy or a wait). Resolve the rvas with the linker map
+// (configure with -DPS2_LINK_MAP=ON) by scripts\resolve_samples.py.
+#ifdef _WIN32
+#include <windows.h>
+#include <psapi.h>
+#include <tlhelp32.h>
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <thread>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+namespace {
+
+constexpr int kSampleIntervalMs = 1;
+constexpr int kRefreshThreadsEvery = 200;
+constexpr int kWriteEverySamples = 2000;
+constexpr int kDefaultStartSeconds = 5;
+constexpr int kThreadQueryStartAddress = 9;
+constexpr std::size_t kStackWordsScanned = 48;
+constexpr std::size_t kCallerChain = 4;
+
+using QueryThread = LONG(NTAPI *)(HANDLE, int, PVOID, ULONG, PULONG);
+
+struct Target {
+    DWORD id = 0;
+    HANDLE handle = nullptr;
+    std::uint64_t start_rva = 0;
+};
+
+std::uintptr_t exe_base() { return reinterpret_cast<std::uintptr_t>(GetModuleHandleW(nullptr)); }
+
+std::string module_of(std::uintptr_t address) {
+    HMODULE module = nullptr;
+    if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, reinterpret_cast<LPCWSTR>(address), &module)) return "unknown";
+    wchar_t path[MAX_PATH];
+    const DWORD n = GetModuleFileNameW(module, path, MAX_PATH);
+    std::wstring name(path, n);
+    const auto slash = name.find_last_of(L"\\/");
+    std::string out;
+    for (wchar_t c : name.substr(slash == std::wstring::npos ? 0 : slash + 1)) out += static_cast<char>(c);
+    return out;
+}
+
+std::vector<Target> list_threads(const std::vector<Target> &known, DWORD self) {
+    std::vector<Target> out;
+    const HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snap == INVALID_HANDLE_VALUE) return known;
+    THREADENTRY32 e{sizeof e};
+    const DWORD pid = GetCurrentProcessId();
+    static const QueryThread query = reinterpret_cast<QueryThread>(GetProcAddress(GetModuleHandleW(L"ntdll.dll"), "NtQueryInformationThread"));
+    for (BOOL ok = Thread32First(snap, &e); ok; ok = Thread32Next(snap, &e)) {
+        if (e.th32OwnerProcessID != pid || e.th32ThreadID == self) continue;
+        Target t;
+        t.id = e.th32ThreadID;
+        for (const Target &k : known)
+            if (k.id == t.id) t = k;
+        if (!t.handle) {
+            t.handle = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, t.id);
+            std::uintptr_t start = 0;
+            if (t.handle && query) query(t.handle, kThreadQueryStartAddress, &start, sizeof start, nullptr);
+            t.start_rva = start >= exe_base() ? start - exe_base() : 0;
+        }
+        if (t.handle) out.push_back(t);
+    }
+    CloseHandle(snap);
+    return out;
+}
+
+struct Counts {
+    std::map<std::pair<DWORD, std::uint64_t>, std::uint64_t> exe;
+    std::map<std::pair<DWORD, std::string>, std::uint64_t> other;
+    std::map<std::tuple<DWORD, std::string, std::vector<std::uint64_t>>, std::uint64_t> callers;
+    std::map<DWORD, std::uint64_t> start;
+};
+
+void write(const char *path, const Counts &c) {
+    std::FILE *f = std::fopen(path, "w");
+    if (!f) return;
+    for (const auto &[id, rva] : c.start) std::fprintf(f, "T %lu %llx\n", id, static_cast<unsigned long long>(rva));
+    for (const auto &[key, n] : c.exe) std::fprintf(f, "S %lu %llx %llu\n", key.first, static_cast<unsigned long long>(key.second), static_cast<unsigned long long>(n));
+    for (const auto &[key, n] : c.other) std::fprintf(f, "M %lu %s %llu\n", key.first, key.second.c_str(), static_cast<unsigned long long>(n));
+    for (const auto &[key, n] : c.callers) {
+        std::fprintf(f, "C %lu %s %llu", std::get<0>(key), std::get<1>(key).c_str(), static_cast<unsigned long long>(n));
+        for (const std::uint64_t rva : std::get<2>(key)) std::fprintf(f, " %llx", static_cast<unsigned long long>(rva));
+        std::fprintf(f, "\n");
+    }
+    std::fclose(f);
+}
+
+struct CodeRange {
+    std::uintptr_t begin = 0, end = 0;
+};
+
+// The executable's code section(s) as addresses, so that a stack word is only taken for a return address when it points into code.
+std::vector<CodeRange> code_ranges(std::uintptr_t base) {
+    std::vector<CodeRange> out;
+    const auto *dos = reinterpret_cast<const IMAGE_DOS_HEADER *>(base);
+    const auto *nt = reinterpret_cast<const IMAGE_NT_HEADERS *>(base + static_cast<std::uintptr_t>(dos->e_lfanew));
+    const IMAGE_SECTION_HEADER *section = IMAGE_FIRST_SECTION(nt);
+    for (unsigned i = 0; i < nt->FileHeader.NumberOfSections; ++i)
+        if (section[i].Characteristics & IMAGE_SCN_MEM_EXECUTE) out.push_back({base + section[i].VirtualAddress, base + section[i].VirtualAddress + section[i].Misc.VirtualSize});
+    return out;
+}
+
+// The first kCallerChain words within the top kStackWordsScanned of a suspended thread's stack that are addresses in the executable's code (rvas, innermost
+// first): the callers of a leaf routine (memcpy, a wait) or of a function with a small frame. A stale word can be taken for a caller, so this is a probable chain.
+std::vector<std::uint64_t> probable_callers(std::uintptr_t rsp, std::uintptr_t base, const std::vector<CodeRange> &code) {
+    std::uintptr_t words[kStackWordsScanned];
+    std::vector<std::uint64_t> chain;
+    if (!ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void *>(rsp), words, sizeof words, nullptr)) return chain;
+    for (const std::uintptr_t word : words)
+        for (const CodeRange &r : code)
+            if (word >= r.begin && word < r.end && chain.size() < kCallerChain) chain.push_back(word - base);
+    return chain;
+}
+
+void run(std::string path, int start_seconds) {
+    std::this_thread::sleep_for(std::chrono::seconds(start_seconds));
+    const DWORD self = GetCurrentThreadId();
+    std::vector<Target> threads;
+    Counts counts;
+    const std::uintptr_t base = exe_base();
+    MODULEINFO exe{};
+    GetModuleInformation(GetCurrentProcess(), reinterpret_cast<HMODULE>(base), &exe, sizeof exe);
+    const std::vector<CodeRange> code = code_ranges(base);
+    struct Sample {
+        DWORD id;
+        std::uintptr_t rip, rsp;
+    };
+    std::vector<Sample> sampled;
+    for (int tick = 0;; ++tick) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(kSampleIntervalMs));
+        if (tick % kRefreshThreadsEvery == 0) threads = list_threads(threads, self);
+        sampled.clear();
+        for (const Target &t : threads) {
+            if (SuspendThread(t.handle) == static_cast<DWORD>(-1)) continue;
+            CONTEXT ctx{};
+            ctx.ContextFlags = CONTEXT_CONTROL;
+            const bool got = GetThreadContext(t.handle, &ctx);
+            ResumeThread(t.handle);
+            if (got) sampled.push_back({t.id, static_cast<std::uintptr_t>(ctx.Rip), static_cast<std::uintptr_t>(ctx.Rsp)});
+        }
+        for (const Sample &sm : sampled) {
+            if (sm.rip >= base && sm.rip < base + exe.SizeOfImage) {
+                ++counts.exe[{sm.id, sm.rip - base}];
+                continue;
+            }
+            const std::string module = module_of(sm.rip);
+            ++counts.other[{sm.id, module}];
+            if (auto chain = probable_callers(sm.rsp, base, code); !chain.empty()) ++counts.callers[{sm.id, module, std::move(chain)}];
+        }
+        for (const Target &t : threads) counts.start[t.id] = t.start_rva;
+        if (tick % kWriteEverySamples == kWriteEverySamples - 1) write(path.c_str(), counts);
+    }
+}
+
+struct Starter {
+    Starter() {
+        const char *path = std::getenv("PS2_SAMPLE");
+        if (!path) return;
+        const char *from = std::getenv("PS2_SAMPLE_FROM");
+        std::thread(run, std::string(path), from ? std::atoi(from) : kDefaultStartSeconds).detach();
+    }
+} g_starter;
+
+}
+#endif
