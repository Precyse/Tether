diff --git a/runtime/include/ps2/detmath.hpp b/runtime/include/ps2/detmath.hpp
new file mode 100644
index 0000000..919c6bc
--- /dev/null
+++ b/runtime/include/ps2/detmath.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <cstdint>
+
+// Math the emulated machines must compute to the same bit on every PC. The host's libm does not promise that: sin, atan and exp differ in the last bit between C
+// libraries, and between CPUs inside one (the Windows runtime picks FMA or plain code paths by CPU), and a game that feeds a result back into its state would split
+// two machines in lockstep. These use only +, -, *, / and square root on IEEE doubles, in a fixed order, with fused multiply-add forbidden in their code, so their results
+// are the same whatever the compiler options, the CPU or the C library; each is within a unit of the last bit of float of the true value.
+namespace ps2::detmath {
+
+float sin(float x);
+float atan(float x);
+float atan2(float y, float x);
+float exp(float x);
+// cos of a double, for tables built at start (the IPU's inverse DCT).
+double cos(double x);
+
+// Puts the floating-point control state of the calling thread in the state the emulation assumes: round to nearest, no flush-to-zero or denormals-are-zero, all
+// exceptions masked. A library that set another state on a thread (an audio or graphics driver) would otherwise change the last bits of float results.
+void pin_fp_environment();
+
+}
