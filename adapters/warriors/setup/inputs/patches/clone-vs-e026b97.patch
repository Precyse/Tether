+++ b/runtime/src/gs/display.hpp
@@ -0,0 +1,37 @@
+#pragma once
+
+#include "gs.hpp"
+
+#include <cstdint>
+#include <vector>
+
+namespace ps2::gs {
+
+// One CRT read circuit placed on the merged output canvas. Positions and sizes are canvas pixels; the circuit's own pixel under canvas offset o is
+// o * num / den (the canvas runs at the finer horizontal/vertical magnification when the circuits differ).
+struct Circuit {
+    bool on;
+    std::uint32_t fbp, fbw, psm, dbx, dby;   // fbp in 256-byte blocks (DISPFB.FBP * 32)
+    std::uint32_t x, y, w, h;
+    std::uint32_t num_x, den_x, num_y, den_y;
+};
+
+// PMODE / DISPFB1,2 / DISPLAY1,2 / BGCOLOR resolved into what the output stage draws: circuit 1 blended over circuit 2 (or the background colour).
+struct Merge {
+    Circuit circuit[2];
+    std::uint32_t width, height;             // canvas
+    bool halved;                             // SMODE2 interlaced frame read: each frame line is shown twice
+    bool alpha_from_alp, alpha_from_circuit2, background_under;   // PMODE MMOD, AMOD, SLBG
+    std::uint32_t alp;                       // PMODE ALP, 0x80 is 1.0
+    std::uint32_t background;                // BGCOLOR as 0x00BBGGRR
+};
+
+inline constexpr std::uint32_t kAlphaOne = 0x80;
+inline constexpr std::uint32_t kMaxCanvasPixels = 1u << 19;
+
+// False when no circuit is enabled or the canvas is empty or larger than the display buffers.
+bool build_merge(const DisplayRegs &regs, Merge &merge);
+// The merged picture as 0xFFBBGGRR pixels (the software backend; the GPU backend runs the same rule in gs.wgsl, `display`).
+void compose(const Merge &merge, std::vector<std::uint32_t> &rgba);
+
+}
