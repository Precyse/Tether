diff --git a/cmake/fingerprint.cmake b/cmake/fingerprint.cmake
new file mode 100644
index 0000000..2598f99
--- /dev/null
+++ b/cmake/fingerprint.cmake
@@ -0,0 +1,26 @@
+# Writes OUT, a C++ file defining ps2::kGameHash and ps2::kRuntimeHash: hashes of the contents of every file under GAME_DIR and under each
+# RUNTIME_SRC and RUNTIME_INCLUDE. Names enter the hash relative to their folder, so the same sources in any directory give the same numbers.
+# Run by the build (cmake -P) whenever one of those files changes. Text files only, hashed without carriage returns, so a checkout with other line endings agrees.
+#
+#   cmake -DOUT=fingerprint.cpp -DGAME_DIR=<generated> -DRUNTIME_SRC=<runtime/src> -DRUNTIME_INCLUDE=<runtime/include> -P fingerprint.cmake
+
+function(folder_hash result)
+    set(listing "")
+    foreach(dir IN LISTS ARGN)
+        file(GLOB_RECURSE files RELATIVE "${dir}" "${dir}/*")
+        list(SORT files)
+        foreach(name IN LISTS files)
+            file(READ "${dir}/${name}" text)
+            string(REPLACE "\r" "" text "${text}")
+            string(SHA256 content "${text}")
+            string(APPEND listing "${name} ${content}\n")
+        endforeach()
+    endforeach()
+    string(SHA256 all "${listing}")
+    string(SUBSTRING "${all}" 0 16 short)
+    set(${result} "0x${short}ull" PARENT_SCOPE)
+endfunction()
+
+folder_hash(game "${GAME_DIR}")
+folder_hash(runtime "${RUNTIME_SRC}" "${RUNTIME_INCLUDE}")
+file(WRITE "${OUT}" "#include <cstdint>\nnamespace ps2 {\nextern const std::uint64_t kGameHash = ${game};\nextern const std::uint64_t kRuntimeHash = ${runtime};\n}\n")
diff --git a/host/audio.cpp b/host/audio.cpp
new file mode 100644
index 0000000..fcb2495
--- /dev/null
+++ b/host/audio.cpp
@@ -0,0 +1,56 @@
+#include "audio.hpp"
+
+#include "ps2/system.hpp"
+
+#include <SDL.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+
+namespace host::audio {
+
+namespace {
+
+constexpr Uint16 kDeviceBufferFrames = 512;   // 10.7 ms per device callback
+
+Engine g_engine;
+SDL_AudioDeviceID g_device = 0;
+bool g_volume_set = false;
+
+void callback(void *, Uint8 *stream, int bytes) {
+    g_engine.render(reinterpret_cast<std::int16_t *>(stream), static_cast<std::size_t>(bytes) / (2 * sizeof(std::int16_t)));
+}
+
+}
+
+void set_volume(int percent) {
+    g_volume_set = true;
+    g_engine.set_volume(std::clamp(percent, 0, kMaxVolume));
+}
+
+bool open() {
+    if (!g_volume_set)
+        if (const char *env = std::getenv("PS2_VOLUME")) g_engine.set_volume(std::clamp(std::atoi(env), 0, kMaxVolume));
+    if (const char *tap = std::getenv("PS2_DUMP_DEVICE")) g_engine.set_tap(std::fopen(tap, "wb"));   // full level, before the volume
+    SDL_AudioSpec want{}, have{};
+    want.freq = kSampleRate;
+    want.format = AUDIO_S16SYS;
+    want.channels = 2;
+    want.samples = kDeviceBufferFrames;
+    want.callback = callback;
+    g_device = SDL_OpenAudioDevice(nullptr, 0, &want, &have, 0);
+    if (!g_device) {
+        std::fprintf(stderr, "[audio] no device: %s\n", SDL_GetError());
+        return false;
+    }
+    ps2::set_audio_sink([](const std::int16_t *samples, std::size_t frames) { g_engine.push(samples, frames); });
+    SDL_PauseAudioDevice(g_device, 0);
+    return true;
+}
+
+double queued_ms() { return g_engine.queued_ms(); }
+
+Stats stats() { return g_engine.stats(); }
+
+}
