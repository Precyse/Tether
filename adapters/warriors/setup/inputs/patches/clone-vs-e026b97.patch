new file mode 100644
index 0000000..bf7ad45
--- /dev/null
+++ b/runtime/src/iop/rtc.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+#include "ps2/system.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <ctime>
+
+namespace ps2::iop {
+
+// 2005-10-18 00:00:00 UTC: the date every machine reads under --deterministic.
+inline constexpr std::time_t kPinnedClock = 1129593600;
+
+inline std::uint8_t bcd(int v) { return static_cast<std::uint8_t>(((v / 10) << 4) | (v % 10)); }
+
+// The 8-byte CDVD clock (sec, min, hour, 0, day, month, year, in BCD, Japan time) from the host clock, or the pinned date for lockstep.
+inline void read_clock(std::uint8_t out[8]) {
+    static bool reported = false;
+    if (!reported) {
+        reported = true;
+        std::fprintf(stderr, "[rtc] the game reads the CDVD clock%s\n", g_options.deterministic ? " (pinned)" : "");
+    }
+    const std::time_t t = g_options.deterministic ? kPinnedClock : std::time(nullptr);
+    std::tm tm;
+#ifdef _WIN32
+    gmtime_s(&tm, &t);
+#else
+    gmtime_r(&t, &tm);
+#endif
+    out[0] = 0;
+    out[1] = bcd(tm.tm_sec);
+    out[2] = bcd(tm.tm_min);
+    out[3] = bcd((tm.tm_hour + 9) % 24);
+    out[4] = 0;
+    out[5] = bcd(tm.tm_mday);
+    out[6] = bcd(tm.tm_mon + 1);
+    out[7] = bcd(tm.tm_year % 100);
+}
+
+}
