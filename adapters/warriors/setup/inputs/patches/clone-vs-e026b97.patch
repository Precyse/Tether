+constexpr int kPercentCeiling = 99;
+constexpr std::uint64_t kSectorBytes = 2048;
+constexpr char kUnnamedLoad[] = "boot";            // a load with no level name (the game's start-up load)
+
+std::array<Entry, kPadCount> g_entries;
+int g_local = 0;
+bool g_changed = false;
+
+bool g_loading = false;
+std::string g_level, g_mission;
+status::Stage g_stage_before = status::Stage::booting;
+std::uint64_t g_start = 0;
+std::uint32_t g_expected = 0;
+std::map<std::string, std::uint32_t> g_sizes;
+bool g_sizes_read = false;
+
+void read_sizes() {
+    if (g_sizes_read) return;
+    g_sizes_read = true;
+    if (std::FILE *file = std::fopen(kSizesFile, "r")) {
+        char name[128];
+        unsigned sectors;
+        while (std::fscanf(file, "%127s %u", name, &sectors) == 2) g_sizes[name] = sectors;
+        std::fclose(file);
+    }
+}
+
+void write_sizes() {
+    if (std::FILE *file = std::fopen(kSizesFile, "w")) {
+        for (const auto &[name, sectors] : g_sizes) std::fprintf(file, "%s %u\n", name.c_str(), sectors);
+        std::fclose(file);
+    }
+}
+
+}
+
+void configure(int local_slot) {
+    g_local = std::clamp(local_slot, 0, kPadCount - 1);
+}
+
+void load_begin(const std::string &level, const std::string &mission) {
+    read_sizes();
+    g_mission = mission;
+    g_stage_before = status::current();
+    status::set_stage(status::Stage::loading, mission);
+    g_level = level.empty() ? kUnnamedLoad : level;
+    g_start = disc::sectors_read();
+    const auto known = g_sizes.find(g_level);
+    g_expected = known == g_sizes.end() ? 0 : known->second;
+    g_loading = true;
+    g_changed = true;
+}
+
+void load_end() {
+    if (!g_loading) return;
+    g_loading = false;
+    g_changed = true;
+    status::set_stage(g_mission.empty() ? g_stage_before : status::Stage::playing, g_mission);
+    const std::uint64_t read = disc::sectors_read() - g_start;
+    if (read && g_sizes[g_level] != read) {
+        g_sizes[g_level] = static_cast<std::uint32_t>(read);
+        write_sizes();
+    }
+}
+
+void tick() {
+    if (g_loading) status::set_counts((disc::sectors_read() - g_start) * kSectorBytes, static_cast<std::uint64_t>(g_expected) * kSectorBytes, status::Unit::bytes);
+    status::tick();
+}
+
+Entry entry(int slot) {
+    if (slot < 0 || slot >= kPadCount) return {};
+    if (slot != g_local) return g_entries[static_cast<std::size_t>(slot)];
+    Entry own;
+    own.known = true;
+    own.loading = g_loading;
+    own.read = g_loading ? static_cast<std::uint32_t>(disc::sectors_read() - g_start) : 0;
+    own.total = g_expected;
+    return own;
+}
+
+bool known(int slot) { return slot >= 0 && slot < kPadCount && (slot == g_local || g_entries[static_cast<std::size_t>(slot)].known); }
+
+bool take_local_change() {
+    const bool changed = g_changed;
+    g_changed = false;
+    return changed;
+}
+
+void put(Writer &w, bool all) {
+    std::uint8_t count = 0;
+    for (int slot = 0; slot < kPadCount; ++slot) count += known(slot) && (all || slot == g_local);
+    w.u8(count);
+    for (int slot = 0; slot < kPadCount; ++slot) {
+        if (!known(slot) || (!all && slot != g_local)) continue;
+        const Entry e = entry(slot);
+        w.u8(static_cast<std::uint8_t>(slot)).u8(e.loading ? 1 : 0).u32(e.read).u32(e.total);
+    }
+}
+
+void take(Reader &r, int from_slot, bool from_host) {
+    const std::uint8_t count = r.u8();
+    for (std::uint8_t i = 0; i < count && r.ok(); ++i) {
+        const std::uint8_t slot = r.u8();
+        Entry e;
+        e.known = true;
+        e.loading = r.u8() != 0;
+        e.read = r.u32();
+        e.total = r.u32();
+        if (!r.ok() || slot >= kPadCount || slot == g_local) continue;
+        if (!from_host && slot != from_slot) continue;
+        g_entries[slot] = e;
+    }
+}
+
+int percent(const Entry &e) {
+    if (!e.total) return -1;
+    return std::min<int>(kPercentCeiling, static_cast<int>(static_cast<std::uint64_t>(e.read) * 100 / e.total));
+}
+
+}
diff --git a/runtime/src/netplay/board.hpp b/runtime/src/netplay/board.hpp
new file mode 100644
index 0000000..426e28c
--- /dev/null
+++ b/runtime/src/netplay/board.hpp
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "wire.hpp"
+
+#include <array>
+#include <cstdint>
+#include <string>
+
+// The load board: how far each player's level load has got, from real counters. The game says when its own load screen starts and ends (netplay.hpp
+// load_begin / load_end); between the two, the disc sectors read here, against the number this level's load read last time (kept in load_sizes.txt), are this
+// machine's progress. Every machine sends its own figures to the others now and then (kMsgStatus) so each can show every player's row. Display only: nothing
+// here is read by the game, so no digest can depend on it.
+namespace ps2::netplay::board {
+
+struct Entry {
+    bool known = false;
+    bool loading = false;
+    std::uint32_t read = 0;       // sectors read by the load so far
+    std::uint32_t total = 0;      // sectors the load read last time (0: never measured)
+};
+
+// The pad port this machine plays on.
+void configure(int local_slot);
+// The game's own level-load screen began / ended (netplay.hpp load_begin / load_end).
+void load_begin(const std::string &level, const std::string &mission);
+void load_end();
+// Every vblank: the running load's real counts to the launcher.
+void tick();
+
+// This machine's own entry, refreshed from the counters; others as last heard.
+Entry entry(int slot);
+// The entry of `slot` has been heard of (or is this machine's).
+bool known(int slot);
+
+// True once after this machine's own state changed (a load began or ended), so the session reports at once instead of at the next interval.
+bool take_local_change();
+
+// kMsgStatus body: a joiner gives its own entry, the host everything it knows. `from_slot` is the port the message came from.
+void put(Writer &w, bool all);
+void take(Reader &r, int from_slot, bool from_host);
+
+// The percent of a load, never 100 before it has ended; -1 when the total is not known.
+int percent(const Entry &entry);
+
+}
diff --git a/runtime/src/netplay/compress.cpp b/runtime/src/netplay/compress.cpp
new file mode 100644
index 0000000..1c9efee
--- /dev/null
+++ b/runtime/src/netplay/compress.cpp
@@ -0,0 +1,100 @@
+#include "compress.hpp"
+
+#include <algorithm>
+#include <cstring>
+
+// Format: a run of sequences. Each is a token byte (high nibble literal count, low nibble match length - 4, 15 meaning
+// "extended by following bytes that add up until one is below 255"), the literals, then a u16 back-offset and the match
+// length extension. The last sequence has literals only.
+namespace ps2::netplay {
+
+namespace {
+
+constexpr int kHashBits = 16;
+constexpr std::size_t kMinMatch = 4;
+constexpr std::size_t kMaxOffset = 65535;
+constexpr std::uint32_t kNone = 0xFFFFFFFFu;
+constexpr std::size_t kNibbleMax = 15;
+constexpr std::uint32_t kHashMultiplier = 2654435761u;
+
+std::uint32_t load32(const std::uint8_t *p) {
+    std::uint32_t v;
+    std::memcpy(&v, p, 4);
+    return v;
+}
+
+void put_length(std::vector<std::uint8_t> &out, std::size_t extra) {
+    for (; extra >= 255; extra -= 255) out.push_back(255);
+    out.push_back(static_cast<std::uint8_t>(extra));
+}
+
+void emit(std::vector<std::uint8_t> &out, const std::uint8_t *literals, std::size_t literal_count, std::size_t offset, std::size_t match) {
+    const std::size_t match_code = match ? match - kMinMatch : 0;
+    out.push_back(static_cast<std::uint8_t>((std::min(literal_count, kNibbleMax) << 4) | std::min(match_code, kNibbleMax)));
+    if (literal_count >= kNibbleMax) put_length(out, literal_count - kNibbleMax);
+    out.insert(out.end(), literals, literals + literal_count);
+    if (!match) return;
+    out.push_back(static_cast<std::uint8_t>(offset));
+    out.push_back(static_cast<std::uint8_t>(offset >> 8));
+    if (match_code >= kNibbleMax) put_length(out, match_code - kNibbleMax);
+}
+
+}
+
+std::vector<std::uint8_t> compress(const std::uint8_t *data, std::size_t size) {
+    std::vector<std::uint8_t> out;
+    out.reserve(size / 3);
+    std::vector<std::uint32_t> table(std::size_t{1} << kHashBits, kNone);
+    std::size_t at = 0, anchor = 0;
+    while (at + kMinMatch <= size) {
+        const std::uint32_t word = load32(data + at);
+        const std::size_t slot = (word * kHashMultiplier) >> (32 - kHashBits);
+        const std::uint32_t ref = table[slot];
+        table[slot] = static_cast<std::uint32_t>(at);
+        if (ref == kNone || at - ref > kMaxOffset || load32(data + ref) != word) {
+            ++at;
+            continue;
+        }
+        std::size_t match = kMinMatch;
+        while (at + match < size && data[ref + match] == data[at + match]) ++match;
+        emit(out, data + anchor, at - anchor, at - ref, match);
+        at += match;
+        anchor = at;
+    }
+    emit(out, data + anchor, size - anchor, 0, 0);
+    return out;
+}
+
+bool decompress(const std::uint8_t *packed, std::size_t packed_size, std::size_t expected, std::vector<std::uint8_t> &out) {
+    out.clear();
+    out.reserve(expected);
+    const std::uint8_t *in = packed, *end = packed + packed_size;
+    const auto length = [&](std::size_t base, bool &ok) {
+        if (base < kNibbleMax) return base;
+        for (;;) {
+            if (in >= end) { ok = false; return base; }
+            const std::uint8_t b = *in++;
+            base += b;
+            if (b != 255) return base;
+        }
+    };
+    while (in < end) {
+        const std::uint8_t token = *in++;
+        bool ok = true;
+        const std::size_t literals = length(token >> 4, ok);
+        if (!ok || static_cast<std::size_t>(end - in) < literals || out.size() + literals > expected) return false;
+        out.insert(out.end(), in, in + literals);
+        in += literals;
+        if (in == end) break;
+        if (end - in < 2) return false;
+        const std::size_t offset = in[0] | (static_cast<std::size_t>(in[1]) << 8);
+        in += 2;
+        const std::size_t match = length(token & 15u, ok) + kMinMatch;
+        if (!ok || offset == 0 || offset > out.size() || out.size() + match > expected) return false;
+        const std::size_t from = out.size() - offset;
+        for (std::size_t i = 0; i < match; ++i) out.push_back(out[from + i]);
+    }
+    return out.size() == expected;
+}
+
+}
diff --git a/runtime/src/netplay/compress.hpp b/runtime/src/netplay/compress.hpp
