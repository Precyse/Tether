+    std::array<std::uint64_t, kPadCount> frames;
+    frames.fill(UINT64_MAX);
+    return frames;
+}
+
+// A request a game takes from the pad stream: SELECT, L3 and R3 held together (buttons bits 0 to 2). It travels with the pad's samples, so every machine sees it at the same
+// frame; the window raises it for the keyboard key that asks for it.
