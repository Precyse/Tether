new file mode 100644
index 0000000..cec92a0
--- /dev/null
+++ b/host/virtual_pads.cpp
@@ -0,0 +1,153 @@
+#include "virtual_pads.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <SDL.h>   // after the standard headers: with clang on Windows SDL_endian.h clashes with <intrin.h> when it comes first
+
+namespace host::pads {
+
+namespace {
+
+constexpr const char *kScriptEnv = "PS2_VIRTUAL_PADS";
+constexpr int kMaxPads = 4;
+constexpr int kTriggerRest = -32768;
+constexpr int kButtonCount = SDL_CONTROLLER_BUTTON_DPAD_RIGHT + 1;   // the standard buttons: raw button i is SDL's controller button i
+constexpr int kAxisCount = SDL_CONTROLLER_AXIS_TRIGGERRIGHT + 1;
+
+struct Control {
+    const char *name;
+    int index;   // the joystick button or axis number: the masks below make it equal SDL's controller enum
+};
+
+constexpr Control kButtons[] = {
+    {"a", SDL_CONTROLLER_BUTTON_A},         {"b", SDL_CONTROLLER_BUTTON_B},         {"x", SDL_CONTROLLER_BUTTON_X},          {"y", SDL_CONTROLLER_BUTTON_Y},
+    {"back", SDL_CONTROLLER_BUTTON_BACK},   {"guide", SDL_CONTROLLER_BUTTON_GUIDE}, {"start", SDL_CONTROLLER_BUTTON_START},  {"ls", SDL_CONTROLLER_BUTTON_LEFTSTICK},
+    {"rs", SDL_CONTROLLER_BUTTON_RIGHTSTICK}, {"lb", SDL_CONTROLLER_BUTTON_LEFTSHOULDER}, {"rb", SDL_CONTROLLER_BUTTON_RIGHTSHOULDER}, {"up", SDL_CONTROLLER_BUTTON_DPAD_UP},
+    {"down", SDL_CONTROLLER_BUTTON_DPAD_DOWN}, {"left", SDL_CONTROLLER_BUTTON_DPAD_LEFT}, {"right", SDL_CONTROLLER_BUTTON_DPAD_RIGHT},
+};
+constexpr Control kAxes[] = {
+    {"lx", SDL_CONTROLLER_AXIS_LEFTX}, {"ly", SDL_CONTROLLER_AXIS_LEFTY}, {"rx", SDL_CONTROLLER_AXIS_RIGHTX},
+    {"ry", SDL_CONTROLLER_AXIS_RIGHTY}, {"lt", SDL_CONTROLLER_AXIS_TRIGGERLEFT}, {"rt", SDL_CONTROLLER_AXIS_TRIGGERRIGHT},
+};
+
+struct Kind {
+    const char *name;
+    const char *label;
+    Uint16 vendor, product;
+};
+
+constexpr Kind kKinds[] = {
+    {"xbox", "Xbox 360 Controller", 0x045e, 0x028e},
+    {"ps5", "DualSense Wireless Controller", 0x054c, 0x0ce6},
+    {"switch", "Nintendo Switch Pro Controller", 0x057e, 0x2009},
+};
+
+struct Command {
+    std::uint64_t frame = 0;
+    std::string verb, argument;
+    int pad = 0, value = 0;
+};
+
+SDL_Joystick *g_joysticks[kMaxPads] = {};   // the opened virtual controller of each script pad
+
+std::vector<Command> g_script;
+std::size_t g_next = 0;
+bool g_active = false;
+
+template <std::size_t N> const Control *find(const Control (&table)[N], const std::string &name) {
+    for (const Control &c : table)
+        if (name == c.name) return &c;
+    return nullptr;
+}
+
+void attach(int pad, const std::string &kind_name) {
+    const Kind *kind = nullptr;
+    for (const Kind &k : kKinds)
+        if (kind_name == k.name) kind = &k;
+    if (!kind || g_joysticks[pad]) return;
+    const std::string name = std::string(kind->label) + " " + std::to_string(pad + 1);   // a name of its own: each pad has its own GUID
+    SDL_VirtualJoystickDesc desc;
+    SDL_zero(desc);
+    desc.version = SDL_VIRTUAL_JOYSTICK_DESC_VERSION;
+    desc.type = SDL_JOYSTICK_TYPE_GAMECONTROLLER;
+    desc.naxes = kAxisCount;
+    desc.nbuttons = kButtonCount;
+    desc.vendor_id = kind->vendor;
+    desc.product_id = kind->product;
+    desc.button_mask = (1u << kButtonCount) - 1;
+    desc.axis_mask = (1u << kAxisCount) - 1;
+    desc.name = name.c_str();
+    const int index = SDL_JoystickAttachVirtualEx(&desc);
+    if (index < 0) {
+        std::fprintf(stderr, "[virtual pads] cannot attach: %s\n", SDL_GetError());
+        return;
+    }
+    g_joysticks[pad] = SDL_JoystickOpen(index);
+    SDL_JoystickSetVirtualAxis(g_joysticks[pad], SDL_CONTROLLER_AXIS_TRIGGERLEFT, kTriggerRest);
+    SDL_JoystickSetVirtualAxis(g_joysticks[pad], SDL_CONTROLLER_AXIS_TRIGGERRIGHT, kTriggerRest);
+    std::fprintf(stderr, "[virtual pads] pad %d attached as %s\n", pad + 1, name.c_str());
+}
+
+// The device index of an open joystick: SDL renumbers the devices when one goes, so it is looked up when needed.
+int device_index_of(SDL_Joystick *joystick) {
+    for (int i = 0; i < SDL_NumJoysticks(); ++i)
+        if (SDL_JoystickGetDeviceInstanceID(i) == SDL_JoystickInstanceID(joystick)) return i;
+    return -1;
+}
+
+void detach(int pad) {
+    SDL_Joystick *joystick = g_joysticks[pad];
+    if (!joystick) return;
+    SDL_JoystickDetachVirtual(device_index_of(joystick));
+    SDL_JoystickClose(joystick);
+    g_joysticks[pad] = nullptr;
+    std::fprintf(stderr, "[virtual pads] pad %d detached\n", pad + 1);
+}
+
+void set(int pad, const std::string &control, int value) {
+    SDL_Joystick *joystick = g_joysticks[pad];
+    if (!joystick) return;
+    if (const Control *b = find(kButtons, control)) SDL_JoystickSetVirtualButton(joystick, b->index, static_cast<Uint8>(value != 0));
+    else if (const Control *a = find(kAxes, control)) SDL_JoystickSetVirtualAxis(joystick, a->index, static_cast<Sint16>(value));
+}
+
+}
+
+bool load_virtual_pads() {
+    const char *path = std::getenv(kScriptEnv);
+    if (!path) return false;
+    std::ifstream file(path);
+    if (!file) {
+        std::fprintf(stderr, "[virtual pads] cannot open %s\n", path);
+        return false;
+    }
+    for (std::string line; std::getline(file, line);) {
+        std::istringstream in(line);
+        Command c;
+        if (!(in >> c.frame >> c.verb >> c.pad) || c.pad < 1 || c.pad > kMaxPads) continue;
+        --c.pad;
+        in >> c.argument >> c.value;
+        g_script.push_back(c);
+    }
+    g_active = true;
+    std::fprintf(stderr, "[virtual pads] %zu commands from %s\n", g_script.size(), path);
+    return true;
+}
+
+bool virtual_pads_active() { return g_active; }
+
+void drive_virtual_pads(std::uint64_t frame) {
+    for (; g_next < g_script.size() && g_script[g_next].frame <= frame; ++g_next) {
+        const Command &c = g_script[g_next];
+        if (c.verb == "attach") attach(c.pad, c.argument);
+        else if (c.verb == "detach") detach(c.pad);
+        else if (c.verb == "set") set(c.pad, c.argument, c.value);
+    }
+}
+
+}
