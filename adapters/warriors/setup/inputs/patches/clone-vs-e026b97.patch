diff --git a/runtime/src/gs/display.cpp b/runtime/src/gs/display.cpp
new file mode 100644
index 0000000..76986f0
--- /dev/null
+++ b/runtime/src/gs/display.cpp
@@ -0,0 +1,130 @@
+#include "display.hpp"
+
+#include "ps2/system.hpp"
+
+#include <algorithm>
+
+namespace ps2::gs {
+
+namespace {
+
+constexpr std::uint32_t kPalLines = 288, kNtscLines = 240, kPalTop = 36, kNtscTop = 25, kPalSpan = 256, kNtscSpan = 224;
+constexpr std::uint32_t kInterlacedFactor = 2;
+
+struct Placement {
+    bool on;
+    std::uint32_t dx, dy, dw, dh, magh, magv;   // DISPLAY fields, dw and dh already + 1
+};
+
+Placement placement(std::uint64_t pmode, std::uint64_t display, int circuit) {
+    Placement p{};
+    p.on = ((pmode >> circuit) & 1u) != 0;
+    p.dx = static_cast<std::uint32_t>(display) & 0xFFFu;
+    p.dy = static_cast<std::uint32_t>(display >> 12) & 0x7FFu;
+    p.magh = (static_cast<std::uint32_t>(display >> 23) & 0xFu) + 1;
+    p.magv = (static_cast<std::uint32_t>(display >> 27) & 3u) + 1;
+    p.dw = (static_cast<std::uint32_t>(display >> 32) & 0xFFFu) + 1;
+    p.dh = (static_cast<std::uint32_t>(display >> 44) & 0x7FFu) + 1;
+    return p;
+}
+
+// The rows of a display area of height dh starting at line dy that fall in the visible part of the picture.
+std::uint32_t shown_lines(std::uint32_t dh, std::uint32_t dy, std::uint64_t smode2) {
+    const std::uint32_t scale = (smode2 & 1u) ? kInterlacedFactor : 1u;
+    const bool pal = ps2::g_options.pal;
+    const std::uint32_t lines = (pal ? kPalLines : kNtscLines) * scale;
+    const std::uint32_t top = (pal ? kPalTop : kNtscTop) * scale, span = (pal ? kPalSpan : kNtscSpan) * scale;
+    const std::uint32_t below = dy > top ? std::min(dy - top, span) : 0u;
+    return std::min({dh, lines, below ? span - below : lines});
+}
+
+struct Tap {
+    bool hit;
+    std::uint32_t rgb, alpha;
+};
+
+Tap tap(const Merge &m, const Circuit &c, std::uint32_t x, std::uint32_t y) {
+    if (!c.on || x < c.x || y < c.y || x - c.x >= c.w || y - c.y >= c.h) return {false, 0, 0};
+    const std::uint32_t lx = (x - c.x) * c.num_x / c.den_x;
+    std::uint32_t ly = (y - c.y) * c.num_y / c.den_y;
+    if (m.halved) ly /= 2;
+    std::uint32_t v = read_pixel(c.psm, c.fbp, c.fbw, c.dbx + lx, c.dby + ly);
+    if (c.psm == PSMCT16 || c.psm == PSMCT16S) {
+        const std::uint32_t alpha = (v & 0x8000u) ? kAlphaOne : 0u;
+        return {true, ((v & 0x1Fu) << 3) | ((v & 0x3E0u) << 6) | ((v & 0x7C00u) << 9), alpha};
+    }
+    if (c.psm == PSMCT24) return {true, v & 0xFFFFFFu, kAlphaOne};
+    return {true, v & 0xFFFFFFu, v >> 24};
+}
+
+std::uint32_t blend_channels(std::uint32_t over, std::uint32_t under, std::uint32_t alpha) {
+    std::uint32_t out = 0;
+    for (std::uint32_t shift = 0; shift < 24; shift += 8) {
+        const std::uint32_t mixed = ((over >> shift) & 0xFFu) * alpha + ((under >> shift) & 0xFFu) * (kAlphaOne - alpha);
+        out |= (mixed >> 7) << shift;
+    }
+    return out;
+}
+
+}
+
+bool build_merge(const DisplayRegs &r, Merge &m) {
+    Placement p[2] = {placement(r.pmode, r.display[0], 0), placement(r.pmode, r.display[1], 1)};
+    if (!p[0].on && !p[1].on) return false;
+    const std::uint32_t mag_h = std::min(p[0].on ? p[0].magh : ~0u, p[1].on ? p[1].magh : ~0u);
+    const std::uint32_t mag_v = std::min(p[0].on ? p[0].magv : ~0u, p[1].on ? p[1].magv : ~0u);
+    std::uint32_t left = ~0u, top = ~0u, bottom = 0;
+    for (const Placement &c : p)
+        if (c.on) {
+            left = std::min(left, c.dx);
+            top = std::min(top, c.dy);
+            bottom = std::max(bottom, c.dy + c.dh);
+        }
+    m = Merge{};
+    m.halved = (r.smode2 & 3u) == 3u;
+    m.alpha_from_alp = (r.pmode & 0x20u) != 0;
+    m.alpha_from_circuit2 = (r.pmode & 0x40u) != 0;
+    m.background_under = (r.pmode & 0x80u) != 0;
+    m.alp = static_cast<std::uint32_t>(r.pmode >> 8) & 0xFFu;
+    m.background = static_cast<std::uint32_t>(r.bgcolor) & 0xFFFFFFu;
+    std::uint32_t right = 0;
+    for (int i = 0; i < 2; ++i) {
+        if (!p[i].on) continue;
+        const std::uint64_t fb = r.dispfb[i];
+        Circuit &c = m.circuit[i];
+        c.on = true;
+        c.fbp = (static_cast<std::uint32_t>(fb) & 0x1FFu) * 32;
+        c.fbw = static_cast<std::uint32_t>(fb >> 9) & 0x3Fu;
+        c.psm = static_cast<std::uint32_t>(fb >> 15) & 0x1Fu;
+        c.dbx = static_cast<std::uint32_t>(fb >> 32) & 0x7FFu;
+        c.dby = static_cast<std::uint32_t>(fb >> 43) & 0x7FFu;
+        c.x = (p[i].dx - left) / mag_h;
+        c.y = (p[i].dy - top) / mag_v;
+        c.w = p[i].dw / mag_h;
+        c.h = p[i].dh / mag_v;
+        c.num_x = mag_h;
+        c.den_x = p[i].magh;
+        c.num_y = mag_v;
+        c.den_y = p[i].magv;
+        right = std::max(right, c.x + c.w);
+    }
+    m.width = right;
+    m.height = shown_lines(bottom - top, top, r.smode2) / mag_v;
+    return m.width && m.height && m.width <= 2048 && m.height <= 2048 && m.width * m.height <= kMaxCanvasPixels;
+}
+
+void compose(const Merge &m, std::vector<std::uint32_t> &rgba) {
+    rgba.resize(static_cast<std::size_t>(m.width) * m.height);
+    for (std::uint32_t y = 0; y < m.height; ++y)
+        for (std::uint32_t x = 0; x < m.width; ++x) {
+            const Tap first = tap(m, m.circuit[0], x, y), second = tap(m, m.circuit[1], x, y);
+            std::uint32_t colour = (m.background_under || !second.hit) ? m.background : second.rgb;
+            if (first.hit) {
+                const std::uint32_t wanted = m.alpha_from_alp ? m.alp : m.alpha_from_circuit2 ? (second.hit ? second.alpha : 0u) : first.alpha;
+                colour = blend_channels(first.rgb, colour, std::min(wanted, kAlphaOne));
+            }
+            rgba[static_cast<std::size_t>(y) * m.width + x] = colour | 0xFF000000u;
+        }
+}
+
+}
