+namespace ps2 {
+
+// Controllers the runtime holds: pad 0 and 1 are SIO2 ports 0 and 1; pads 2 and 3 are served to the game by the runtime directly.
+constexpr int kPadCount = 4;
+
+// One frame number per pad, every one meaning "never".
