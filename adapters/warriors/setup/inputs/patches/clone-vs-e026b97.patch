diff --git a/runtime/src/digest.hpp b/runtime/src/digest.hpp
new file mode 100644
index 0000000..c283a40
--- /dev/null
+++ b/runtime/src/digest.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+// Lockstep research aid: hashes the memory the simulation lives in at fixed frames so two runs can be compared.
+namespace ps2::digest {
+
+// Hashes of the memory the simulation lives in, taken at one instant. `card` is the memory card's contents: the game reads it, so two machines that
+// hold different cards compute different games the first time it does (0 when no card is in). `extra` is the used part of the extra guest RAM.
+struct MemoryHashes {
+    std::uint64_t ee = 0, spr = 0, iop = 0, card = 0, extra = 0;
+    bool operator==(const MemoryHashes &o) const { return ee == o.ee && spr == o.spr && iop == o.iop && card == o.card && extra == o.extra; }
+};
+MemoryHashes memory_hashes();
+
+// Every `every` frames append one line to `path` ("frame cycles ee spr iop"), one line of per-block hashes to `path`.blocks and
+// the words of each Options::probes range to `path`.probes.
+bool open(const std::string &path, std::uint32_t every);
+bool due(std::uint64_t frame);
+void on_frame(std::uint64_t frame, std::uint64_t cycles);
+// Hash of the whole serialized machine (EE, IOP, SPU2, VU, GS, DMA, SIF), appended to `path`.machine; taken at the loop top after a checkpoint frame.
+void on_machine(std::uint64_t frame, const std::uint8_t *state, std::size_t bytes);
+
+}
