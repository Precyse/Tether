new file mode 100644
index 0000000..3ab037e
--- /dev/null
+++ b/runtime/include/ps2/guest_call.hpp
@@ -0,0 +1,21 @@
+#pragma once
+
+#include "cpu.hpp"
+
+#include <cstdint>
+
+namespace ps2 {
+
+// A call into the game's code with all of its arguments the way its compiler passes them (EABI-style): eight in registers a0-a3 and t0-t3, the first
+// float in f12, the rest on the stack from sp + 0. For hooks that build the game's own widgets.
+struct GuestArgs {
+    std::uint32_t a[8] = {};
+    std::uint32_t stack[4] = {};
+    std::uint32_t f12 = 0;   // the first float's bits
+    std::uint32_t f13 = 0, f14 = 0, f15 = 0;   // the next floats, for the calls that take four
+};
+
+// Like call_guest (ps2/system.hpp): runs the function at `address` to completion and returns v0; the caller's registers are restored.
+std::uint32_t call_guest(Cpu &c, std::uint32_t address, const GuestArgs &call);
+
+}
